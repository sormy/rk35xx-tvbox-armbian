			cursor_up_scancode = <0x45>;
			cursor_down_scancode = <0x46>;
			cursor_ok_scancode = <0x44>;
			phandle = <0x26>;
		};

		map_4: map_4 {
			mapname = "amlogic-remote-5";
			customcode = <0xdf00>;
			release_delay = <80>;
			size = <0x1c>;
			keymap = <0x1c0074 0x4b0042 0x4f003c 0x1003d 0x5f003e 0x5d0073 0x5c0072 0x420066 0xa009e 0x1a0067 0x48006c 0x470069 0x7006a 0x6001c 0x18008b 0x540002 0x160003 0x150004 0x500005 0x120006 0x110007 0x4c0008 0xe0009 0xd000a 0x41003f 0xc000b 0x10000e 0x30184>;
			fn_key_scancode = <0x03>;
