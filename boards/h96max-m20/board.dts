			cursor_up_scancode = <0x1a>;
			cursor_down_scancode = <0x48>;
			cursor_ok_scancode = <0x06>;
			phandle = <0x27>;
		};

		map_5: map_5 {
			mapname = "amlogic-remote-6";
			customcode = <0x212>;
			release_delay = <80>;
			size = <0x22>;
			keymap = <0x80074 0x4a008b 0x2f00af 0xa4003f 0xb20057 0x450067 0x46006c 0x470069 0x48006a 0x44001c 0x1a009e 0x1b000e 0x2d0066 0x20073 0x30072 0x90071 0x192 0x10193 0x17004b 0x90004c 0x610002 0x620003 0x630004 0x640005 0x650006 0x660007 0x670008 0x680009 0x69000a 0x60000b 0xfb0040 0xeb0041 0xb30042 0xb40043>;
			fn_key_scancode = <0x2f>;
			cursor_left_scancode = <0x47>;
			cursor_right_scancode = <0x48>;
			cursor_up_scancode = <0x45>;
			cursor_down_scancode = <0x46>;
			cursor_ok_scancode = <0x44>;
			phandle = <0x28>;
		};

		map_6: map_6 {
			mapname = "amlogic-remote-7";
			customcode = <0xff00>;
			release_delay = <80>;
			size = <0x1c>;
			keymap = <0x180074 0x30175 0x140072 0x100073 0x60066 0x40009e 0x4008b 0x460067 0x16006c 0x470069 0x15006a 0x55001c 0x540002 0x480003 0x70004 0x500005 0x120006 0x110007 0x4c0008 0xe0009 0xd000a 0xc000b 0x4b000e 0x140072 0x80071 0x100073 0x560043 0x570044>;
			phandle = <0x29>;
		};
	};

	meson-amvideom {
		compatible = "amlogic, amvideom";
		dev_name = "amvideom";
		status = "okay";
		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vsync";
	};

	aml_reboot {
		compatible = "aml, reboot";
		sys_reset = <0x84000009>;
		sys_poweroff = <0x84000008>;
	};

	ddr_bandwidth {
		compatible = "amlogic, ddr-bandwidth";
		status = "okay";
		reg = <0xc8838000 0x100 0xc8837000 0x100>;
		sec_base = <0xda838400>;
		interrupts = <GIC_SPI 52 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "ddr_bandwidth";
	};

	dmc_monitor {
		compatible = "amlogic, dmc_monitor";
		status = "okay";
		reg_base = <0xda838400>;
		interrupts = <GIC_SPI 51 IRQ_TYPE_EDGE_RISING>;
	};

	/* meson-gx-socinfo reads the chip ID here, so soc0 names the GXLX2 (S905L3) */
	ao-secure@c8100140 {
		compatible = "amlogic,meson-gx-ao-secure", "syscon";
		reg = <0xc8100140 0x140>;
		amlogic,has-chip-id;
	};

	firmware {

		/* meson_sm: the chip serial, as firmware:secure-monitor */
		secure-monitor {
			compatible = "amlogic,meson-gxbb-sm";
		};

		android {
			compatible = "android,firmware";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,boot,system,vendor";
				by_name_prefix = "/dev/block";
			};

			fstab {
				compatible = "android,fstab";

				system {
					compatible = "android,system";
					dev = "/dev/block/system";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};

				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};

				odm {
					compatible = "android,odm";
					dev = "/dev/block/odm";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};

				product {
					compatible = "android,product";
					dev = "/dev/block/product";
					type = "ext4";
					mnt_flags = "ro,barrier=1,inode_readahead_blks=8";
					fsmgr_flags = "wait";
				};
			};
		};
	};

	partitions: partitions {
		parts = <17>;
		part-0 = <&logo>;
		part-1 = <&recovery>;
		part-2 = <&misc>;
		part-3 = <&dtbo>;
		part-4 = <&cri_data>;
		part-5 = <&param>;
		part-6 = <&boot>;
		part-7 = <&rsv>;
		part-8 = <&metadata>;
		part-9 = <&vbmeta>;
		part-10 = <&tee>;
		part-11 = <&vendor>;
		part-12 = <&odm>;
		part-13 = <&system>;
		part-14 = <&product>;
		part-15 = <&cache>;
		part-16 = <&data>;
		phandle = <0xc5>;

		logo: logo {
			pname = "logo";
			size = <0x00 0x800000>;
			mask = <0x01>;
			phandle = <0x2a>;
		};

		recovery: recovery {
			pname = "recovery";
			size = <0x00 0x1800000>;
			mask = <0x01>;
			phandle = <0x2b>;
		};

		misc: misc {
			pname = "misc";
			size = <0x00 0x800000>;
			mask = <0x01>;
			phandle = <0x2c>;
		};

		dtbo: dtbo {
			pname = "dtbo";
			size = <0x00 0x800000>;
			mask = <0x01>;
			phandle = <0x2d>;
		};

		cri_data: cri_data {
			pname = "cri_data";
			size = <0x00 0x800000>;
			mask = <0x02>;
			phandle = <0x2e>;
		};

		rsv: rsv {
			pname = "rsv";
			size = <0x00 0x1000000>;
			mask = <0x01>;
			phandle = <0x31>;
		};

		metadata: metadata {
			pname = "metadata";
			size = <0x00 0x1000000>;
			mask = <0x01>;
			phandle = <0x32>;
		};

		vbmeta: vbmeta {
			pname = "vbmeta";
			size = <0x00 0x200000>;
			mask = <0x01>;
			phandle = <0x33>;
		};

		param: param {
			pname = "param";
			size = <0x00 0x1000000>;
			mask = <0x02>;
			phandle = <0x2f>;
		};

		boot: boot {
			pname = "boot";
			size = <0x00 0x1000000>;
			mask = <0x01>;
			phandle = <0x30>;
		};

		tee: tee {
			pname = "tee";
			size = <0x00 0x2000000>;
			mask = <0x01>;
			phandle = <0x34>;
		};

		vendor: vendor {
			pname = "vendor";
			size = <0x00 0x14000000>;
			mask = <0x01>;
			phandle = <0x35>;
		};

		odm: odm {
			pname = "odm";
			size = <0x00 0x8000000>;
			mask = <0x01>;
			phandle = <0x36>;
		};

		system: system {
			pname = "system";
			size = <0x00 0x60000000>;
			mask = <0x01>;
			phandle = <0x37>;
		};

		product: product {
			pname = "product";
			size = <0x00 0x8000000>;
			mask = <0x01>;
			phandle = <0x38>;
		};

		cache: cache {
			pname = "cache";
			size = <0x00 0x46000000>;
			mask = <0x02>;
			phandle = <0x39>;
		};

		data: data {
			pname = "data";
			size = <0xffffffff 0xffffffff>;
			mask = <0x04>;
			phandle = <0x3a>;
		};
	};

	ion_dev {
		compatible = "amlogic, ion_dev";
		memory-region = <&ion_reserved>;
	};

	aliases {
		serial0 = "/soc/aobus@c8100000/serial@4c0";
		serial1 = "/soc/cbus@c1100000/serial@84c0";
		serial2 = "/soc/cbus@c1100000/serial@84dc";
		serial3 = "/soc/cbus@c1100000/serial@8700";
		serial4 = "/soc/aobus@c8100000/serial@4e0";
	};

	memory@00000000 {
		device_type = "memory";
		linux,usable-memory = <0x100000 0x7ff00000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		ramoops@0x07400000 {
			compatible = "ramoops";
			reg = <0x7400000 0x100000>;
			record-size = <0x8000>;
			console-size = <0x8000>;
			ftrace-size = <0x40000>;
		};

		/* The vendor's pools, for drivers mainline does not have. secmon's overlaid BL31,
		   which U-Boot /memreserve/s: as reusable CMA its pages went to the page allocator. */
		secmon_reserved: linux,secmon {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x400000>;
			alignment = <0x400000>;
			alloc-ranges = <0x10000000 0x400000>;
			phandle = <0x0e>;
		};

		secos_reserved: linux,secos {
			status = "disable";
			compatible = "amlogic, aml_secos_memory";
			reg = <0x5300000 0x2000000>;
			no-map;
			phandle = <0xc6>;
		};

		logo_reserved: linux,meson-fb {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x800000>;
			alignment = <0x400000>;
			alloc-ranges = <0x7f800000 0x800000>;
			phandle = <0x3d>;
		};

		di_cma_reserved: linux,di_cma {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4400000>;
			alignment = <0x400000>;
			phandle = <0x42>;
		};

		ion_reserved: linux,ion-dev {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x7c00000>;
			alignment = <0x400000>;
			alloc-ranges = <0x30000000 0x50000000>;
			phandle = <0x3b>;
		};

		ppmgr_reserved: linux,ppmgr {
			status = "disabled";
			compatible = "shared-dma-pool";
			size = <0x00>;
			phandle = <0x41>;
		};

		codec_mm_cma: linux,codec_mm_cma {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x10400000>;
			alignment = <0x400000>;
			linux,contiguous-region;
			phandle = <0x3e>;
		};

		picdec_cma_reserved: linux,picdec {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00>;
			alignment = <0x00>;
			linux,contiguous-region;
			phandle = <0x40>;
		};

		codec_mm_reserved: linux,codec_mm_reserved {
			status = "disabled";
			compatible = "amlogic, codec-mm-reserved";
			size = <0x00>;
			alignment = <0x100000>;
			phandle = <0x3f>;
		};

		vdin1_cma_reserved: linux,vdin1_cma {
			status = "disabled";
			compatible = "shared-dma-pool";
			reusable;
			size = <0x1000000>;
			alignment = <0x400000>;
			phandle = <0x43>;
		};

		/* 4K at 60 fps, decoded and copied into render buffers, outgrows 384 MiB */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x30000000>;
			alignment = <0x400000>;
			linux,cma-default;
		};
	};

	sysled {
		compatible = "amlogic, sysled";
		dev_name = "sysled";
		status = "disabled";
		led_gpio = <&gpio 76 GPIO_ACTIVE_HIGH>;
		led_active_low = <0x01>;
	};

	gpioleds {
		compatible = "gpio-leds";
		status = "okay";

		/* The board's one LED, blue: the factory's sys_red. Its disabled sysled node names
		   the pin led_active_low, which is why the factory's active-high "off" lit it.
		   power is the name the shared LED hooks drive. */
		power {
			label = "power";
			gpios = <&gpio 73 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		/* NOT FITTED - the factory's sys_green, GPIOZ_14: driven either way, it lights
		   nothing on this unit. */
	};

	gpio_keypad {
		compatible = "amlogic, gpio_keypad";
		status = "okay";
		scan_period = <20>;
		key_num = <1>;
		key_name = "f11";
		key_code = <0x45>;
		key-gpios = <&gpio_ao 2 GPIO_ACTIVE_LOW>;
		detect_mode = <0x00>;
	};

	vout {
		compatible = "amlogic, vout";
		dev_name = "vout";
		status = "okay";
		fr_auto_policy = <0x00>;
	};


	meson-fb {
		compatible = "amlogic, meson-gxl";
		memory-region = <&logo_reserved>;
		dev_name = "meson-fb";
		status = "okay";
		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "viu-vsync", "rdma";
		mem_size = <0x800000 0x1800000 0x100000>;
		display_mode_default = "720p60hz";
		scale_mode = <0x01>;
		display_size_default = <0x500 0x2d0 0x500 0x870 0x20>;
		logo_addr = "0x7f800000";
	};


	codec_io {
		compatible = "amlogic, codec_io";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		io_cbus_base {
			reg = <0xc1100000 0x100000>;
		};

		io_dos_base {
			reg = <0xc8820000 0x10000>;
		};

		io_hiubus_base {
			reg = <0xc883c000 0x2000>;
		};

		io_aobus_base {
			reg = <0xc8100000 0x100000>;
		};

		io_vcbus_base {
			reg = <0xd0100000 0x40000>;
		};

		io_dmc_base {
			reg = <0xc8838000 0x400>;
		};
	};

	codec_mm {
		compatible = "amlogic, codec, mm";
		memory-region = <&codec_mm_cma>, <&codec_mm_reserved>;
		dev_name = "codec_mm";
		status = "okay";
	};

	canvas {
		compatible = "amlogic, meson, canvas";
		dev_name = "amlogic-canvas";
		status = "ok";
		reg = <0xc8838000 0x400>;
	};


	vdec {
		compatible = "amlogic, vdec";
		dev_name = "vdec.0";
		status = "okay";
		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 23 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 32 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 43 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 44 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vsync", "demux", "parser", "mailbox_0", "mailbox_1", "mailbox_2";
	};

	picdec {
		compatible = "amlogic, picdec";
		memory-region = <&picdec_cma_reserved>;
		dev_name = "picdec";
		status = "okay";
	};

	ppmgr {
		compatible = "amlogic, ppmgr";
		memory-region = <&ppmgr_reserved>;
		dev_name = "ppmgr";
		status = "okay";
	};

	deinterlace {
		compatible = "amlogic, deinterlace";
		status = "okay";
		flag_cma = <0x04>;
		memory-region = <&di_cma_reserved>;
		interrupts = <GIC_SPI 46 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 6 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "de_irq", "timerc";
		buffer-size = <0x2fd000>;
		hw-version = <0x02>;
	};

	tunnel_sync {
		compatible = "amlogic, tunnel_sync";
		dev_name = "tunnel_sync";
		status = "okay";
		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vsync";
	};

	ionvideo {
		compatible = "amlogic, ionvideo";
		dev_name = "ionvideo";
		status = "okay";
	};

	amlvideo {
		compatible = "amlogic, amlvideo";
		dev_name = "amlvideo";
		status = "okay";
	};

	meson_uvm {
		compatible = "amlogic, meson_uvm";
		status = "okay";
	};

	meson_videotunnel {
		compatible = "amlogic, meson_videotunnel";
		status = "okay";
	};

	video_composer {
		compatible = "amlogic, video_composer";
		dev_name = "video_composer";
		status = "okay";
	};

	dvb {
		compatible = "amlogic, dvb";
		dev_name = "dvb";
		status = "disabled";
		ts2 = "parallel";
		ts2_control = <0x00>;
		ts2_invert = <0x00>;
		interrupts = <GIC_SPI 23 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 5 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 53 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 19 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 25 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 18 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 24 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "demux0_irq", "demux1_irq", "demux2_irq", "dvr0_irq", "dvr1_irq", "dvrfill0_fill", "dvrfill1_flush";
		clocks = <&clkc CLKID_DEMUX>,
		         <&clkc CLKID_ASYNC_FIFO>,
		         <&clkc CLKID_AHB_ARB0>,
		         <&clkc CLKID_DOS_PARSER>;
		clock-names = "demux", "asyncfifo", "ahbarb0", "uparsertop";
	};

	vdin0 {
		compatible = "amlogic, vdin";
		dev_name = "vdin0";
		status = "disabled";
		reserve-iomap = "true";
		flag_cma = <0x01>;
		cma_size = <0x18>;
		interrupts = <GIC_SPI 83 IRQ_TYPE_EDGE_RISING>;
		rdma-irq = <0x02>;
		vdin_id = <0x00>;
		tv_bit_mode = <0x15>;
	};

	vdin1 {
		compatible = "amlogic, vdin";
		memory-region = <&vdin1_cma_reserved>;
		dev_name = "vdin1";
		status = "disabled";
		reserve-iomap = "true";
		flag_cma = <0x00>;
		interrupts = <GIC_SPI 85 IRQ_TYPE_EDGE_RISING>;
		rdma-irq = <0x04>;
		vdin_id = <0x01>;
		tv_bit_mode = <0x01>;
	};

	amlvecm {
		compatible = "amlogic, vecm";
		dev_name = "aml_vecm";
		status = "okay";
		gamma_en = <0x00>;
		wb_en = <0x00>;
		cm_en = <0x00>;
		wb_sel = <0x00>;
		cfg_en_osd_100 = <0x03>;
		tx_op_color_primary = <0x00>;
	};

	amvenc_avc {
		compatible = "amlogic, amvenc_avc";
		dev_name = "amvenc_avc";
		status = "okay";
		interrupts = <GIC_SPI 45 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "mailbox_2";
	};

	hevc_enc {
		compatible = "cnm, HevcEnc";
		dev_name = "HevcEnc";
		status = "okay";
		interrupts = <GIC_SPI 187 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wave420l_irq";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		io_reg_base {
			reg = <0xc8810000 0x4000>;
		};
	};


	/* The display pipeline, as mainline's meson-drm describes it. The vendor nodes beside
	   it (vout, amhdmitx, canvas) bind to no mainline driver. */
	canvas: video-lut@c8838048 {
		compatible = "amlogic,canvas";
		reg = <0xc8838048 0x14>;
	};

	vpu: vpu@d0100000 {
		compatible = "amlogic,meson-gxl-vpu", "amlogic,meson-gx-vpu";
		reg = <0xd0100000 0x100000>, <0xc883c000 0x1000>;
		reg-names = "vpu", "hhi";
		interrupts = <GIC_SPI 3 IRQ_TYPE_EDGE_RISING>;
		amlogic,canvas = <&canvas>;
		power-domains = <&pwrc 0>;
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <0x01>;

			hdmi_tx_out: endpoint {
				remote-endpoint = <&hdmi_tx_in>;
			};
		};
	};

	/* the HDMI DDC lines as a full I2C bus: dw-hdmi's own master reads the EDID but refuses DDC/CI */
	hdmi_ddc: i2c-hdmi-ddc {
		compatible = "i2c-gpio";
		sda-gpios = <&gpio 17 GPIO_OPEN_DRAIN>;
		scl-gpios = <&gpio 18 GPIO_OPEN_DRAIN>;
		i2c-gpio,delay-us = <5>;
		pinctrl-names = "default";
		pinctrl-0 = <&hdmitx_ddc_gpio>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	/* GXLX2 maps the controller directly, as G12A does, where GXL went through an
	   address/data port at 0xc883a000. The gxlx2 match is TVBian's meson-dw-hdmi patch;
	   the GXL fallback is what meson-drm matches. */
	hdmi_tx: hdmi-tx@da800000 {
		compatible = "amlogic,meson-gxlx2-dw-hdmi", "amlogic,meson-gxl-dw-hdmi";
		reg = <0xda800000 0x10000>;
		interrupts = <GIC_SPI 57 IRQ_TYPE_EDGE_RISING>;
		resets = <&reset RESET_HDMITX_CAPB3>,
		         <&reset RESET_HDMI_SYSTEM_RESET>,
		         <&reset RESET_HDMI_TX>;
		/* in-tree dw-hdmi takes its resets by name */
		reset-names = "hdmitx_apb", "hdmitx", "hdmitx_phy";
		clocks = <&clkc CLKID_HDMI>, <&clkc CLKID_HDMI_PCLK>, <&clkc CLKID_GCLK_VENCI_INT0>;
		clock-names = "isfr", "iahb", "venci";
		power-domains = <&pwrc 0>;
		assigned-clocks = <&clkc CLKID_HDMI_SEL>, <&clkc CLKID_HDMI>;
		assigned-clock-parents = <&xtal 0>;
		assigned-clock-rates = <0>, <24000000>;
		pinctrl-0 = <&hdmitx_hpd>;
		ddc-i2c-bus = <&hdmi_ddc>;
		pinctrl-names = "default";
		#sound-dai-cells = <0>;
		sound-name-prefix = "HDMITX";
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0x00>;

			hdmi_tx_in: endpoint {
				remote-endpoint = <&hdmi_tx_out>;
			};
		};

		port@1 {
			reg = <0x01>;

			hdmi_tx_tmds_out: endpoint {
				remote-endpoint = <&hdmi_connector_in>;
			};
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&hdmi_tx_tmds_out>;
			};
		};
	};

	/* meson-vdec's decoder; the vendor vdec beside it binds to nothing in mainline */
	video-codec@c8820000 {
		compatible = "amlogic,gxlx-vdec", "amlogic,gx-vdec";
		reg = <0xc8820000 0x10000>, <0xc110a580 0xe4>;
		reg-names = "dos", "esparser";
		interrupts = <GIC_SPI 44 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 32 IRQ_TYPE_EDGE_RISING>,
		             <GIC_SPI 43 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "vdec", "esparser", "mbox0";
		amlogic,ao-sysctrl = <&sysctrl_AO>;
		amlogic,canvas = <&canvas>;
		clocks = <&clkc CLKID_DOS_PARSER>,
		         <&clkc CLKID_DOS>,
		         <&clkc CLKID_VDEC_1>,
		         <&clkc CLKID_VDEC_HEVC>;
		clock-names = "dos_parser", "dos", "vdec_1", "vdec_hevc";
		resets = <&reset RESET_PARSER>;
		reset-names = "esparser";
	};

	/* mainline's audio controller and card: I2S into the HDMI transmitter */
	aiu: audio-controller@c1105400 {
		compatible = "amlogic,aiu-gxl", "amlogic,aiu";
		reg = <0xc1105400 0x2ac>;
		interrupts = <GIC_SPI 48 IRQ_TYPE_EDGE_RISING>, <GIC_SPI 50 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "i2s", "spdif";
		clocks = <&clkc CLKID_AIU_GLUE>,
		         <&clkc CLKID_I2S_OUT>,
		         <&clkc CLKID_AOCLK_GATE>,
		         <&clkc CLKID_CTS_AMCLK>,
		         <&clkc CLKID_MIXER_IFACE>,
		         <&clkc CLKID_IEC958>,
		         <&clkc CLKID_IEC958_GATE>,
		         <&clkc CLKID_CTS_MCLK_I958>,
		         <&clkc CLKID_CTS_I958>;
		clock-names = "pclk", "i2s_pclk", "i2s_aoclk", "i2s_mclk", "i2s_mixer", "spdif_pclk", "spdif_aoclk", "spdif_mclk", "spdif_mclk_sel";
		resets = <&reset RESET_AIU>;
		#sound-dai-cells = <2>;
		sound-name-prefix = "AIU";
	};

	sound {
		compatible = "amlogic,gx-sound-card";
		model = "H96-MAX-M20";
		assigned-clocks = <&clkc CLKID_MPLL0>, <&clkc CLKID_MPLL1>, <&clkc CLKID_MPLL2>;
		assigned-clock-parents = <0x00 0x00 0x00>;
		assigned-clock-rates = <294912000>, <270950400>, <393216000>;

		dai-link-0 {
			sound-dai = <&aiu 0 0>;
		};

		dai-link-1 {
			sound-dai = <&aiu 0 2>;
			dai-format = "i2s";
			mclk-fs = <256>;

			codec-0 {
				sound-dai = <&aiu 1 0>;
			};
		};

		dai-link-2 {
			sound-dai = <&aiu 1 2>;

			codec-0 {
				sound-dai = <&hdmi_tx>;
			};
		};
	};

	rdma {
		compatible = "amlogic, meson, rdma";
		dev_name = "amlogic-rdma";
		status = "ok";
		interrupts = <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "rdma";
	};

	rtc {
		compatible = "amlogic, aml_vrtc";
		alarm_reg_addr = <0xc81000a8>;
		timer_e_addr = <0xc1109988>;
		init_date = "2020/01/01";
		status = "okay";
	};

	bt-dev {
		compatible = "amlogic, bt-dev";
		dev_name = "bt-dev";
		status = "okay";
		gpio_en = <&gpio 99 GPIO_ACTIVE_HIGH>;
		gpio_reset = <&gpio 99 GPIO_ACTIVE_HIGH>;
	};


	/* The mmc core needs a supply to know what it may drive the bus at. The vendor tree
	   states it as ocr_avail in a sub-node only its own driver reads, so without this
	   mainline reports "no support for card's volts" and no card initialises. */
	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};


	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* GPIOX_6 is the combo chip's power-on and GPIOX_17 its Bluetooth enable - the
		   vendor wifi and bt-dev nodes' power_on_pin and gpio_en. Read as resets: active
		   low, so the sequencer drives both high to bring the chip up, and drops them on
		   power-off, which is the only way to get the part out of a wedged state. */
		reset-gpios = <&gpio 85 GPIO_ACTIVE_LOW>, <&gpio 96 GPIO_ACTIVE_LOW>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <100>;
	};

	wifi {
		compatible = "amlogic, aml_wifi";
		dev_name = "aml_wifi";
		status = "okay";
		interrupt_pin = <&gpio 100 GPIO_ACTIVE_HIGH>;
		interrupts = <GIC_SPI 68 IRQ_TYPE_LEVEL_HIGH>;
		irq_trigger_type = "GPIO_IRQ_HIGH";
		power_on_pin = <&gpio 88 GPIO_ACTIVE_HIGH>;
		dhd_static_buf;
		pinctrl-names = "wifi_32k_pins";
		pinctrl-0 = <&wifi_32k_pins>;
	};

	wifi_pwm_conf: wifi_pwm_conf {
		phandle = <0xc7>;

		pwm_channel1_conf {
			pwms = <&pwm_ef 0 30541 0>;
			duty-cycle = <15270>;
			times = <8>;
		};

		pwm_channel2_conf {
			pwms = <&pwm_ef 2 30500 0>;
			duty-cycle = <15250>;
			times = <12>;
		};
	};

	sd_emmc_c: emmc@d0074000 {
		status = "okay";
		/* mainline meson-gx-mmc for eMMC: its own clkc clocks,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset RESET_SD_EMMC_C>;
		reg = <0xd0074000 0x2000>;
		interrupts = <GIC_SPI 218 IRQ_TYPE_EDGE_RISING>;
		/* Linux applies only the state named "default". The vendor's first state muxes clk
		   and cmd alone - the eight data lines are in emmc_conf_pull_up - so naming that one
		   default left the data pins unconfigured and reads returned I/O errors. */
		pinctrl-names = "default";
		pinctrl-0 = <&emmc_conf_pull_up>, <&emmc_conf_pull_done>;
		clocks = <&clkc CLKID_SD_EMMC_C>,
		         <&clkc CLKID_SD_EMMC_C_CLK0>,
		         <&clkc CLKID_FCLK_DIV2>;
		clock-names = "core", "clkin0", "clkin1";
		vmmc-supply = <&vcc_3v3>;
		vqmmc-supply = <&vcc_3v3>;
		bus-width = <8>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		/* 200 MHz is HS200/HS400, which needs the 1.8 V signalling this board never switches
		   to; 50 MHz is the fastest mode a fixed 3.3 V rail supports. */
		max-frequency = <50000000>;
		non-removable;
		disable-wp;
		phandle = <0xc8>;

		emmc {
			pinname = "emmc";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_8_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED", "MMC_CAP_NONREMOVABLE", "MMC_CAP_HW_RESET", "MMC_CAP_ERASE", "MMC_CAP_CMD23";
			f_min = <400000>;
			f_max = <50000000>;
			max_req_size = <0x20000>;
			gpio_dat3 = <&gpio 32 GPIO_ACTIVE_HIGH>;
			hw_reset = <&gpio 38 GPIO_ACTIVE_HIGH>;
			card_type = <0x01>;
		};
	};

	sd_emmc_b: sd@d0072000 {
		status = "okay";
		/* mainline meson-gx-mmc for the SD slot: its own clkc clocks,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset RESET_SD_EMMC_B>;
		reg = <0xd0072000 0x2000>;
		interrupts = <GIC_SPI 217 IRQ_TYPE_EDGE_RISING>;
		/* Linux registers the pin map for every state at probe, and the vendor's spare
		   states mux these pins to uart_ao_a_card, a function mainline's gxl pinctrl does
		   not have - two dozen "invalid function" errors per boot. Only "default" is ever
		   applied, so the rest are dropped rather than translated. */
		pinctrl-names = "default";
		pinctrl-0 = <&sd_all_pins>;
		clocks = <&clkc CLKID_SD_EMMC_B>,
		         <&clkc CLKID_SD_EMMC_B_CLK0>,
		         <&clkc CLKID_FCLK_DIV2>;
		clock-names = "core", "clkin0", "clkin1";
		bus-width = <4>;
		cap-sd-highspeed;
		max-frequency = <100000000>;
		disable-wp;
		phandle = <0xc9>;

		sd {
			pinname = "sd";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_4_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED";
			f_min = <400000>;
			f_max = <100000000>;
			max_req_size = <0x20000>;
			gpio_dat3 = <&gpio 49 GPIO_ACTIVE_HIGH>;
			jtag_pin = <&gpio 45 GPIO_ACTIVE_HIGH>;
			gpio_cd = <&gpio 51 GPIO_ACTIVE_HIGH>;
			card_type = <0x05>;
		};
	};

	sd_emmc_a: sdio@d0070000 {
		status = "okay";
		/* mainline meson-gx-mmc for the SDIO Wi-Fi: its own clkc clocks,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset RESET_SD_EMMC_A>;
		reg = <0xd0070000 0x2000>;
		interrupts = <GIC_SPI 216 IRQ_TYPE_LEVEL_HIGH>;
		/* Linux applies the state called "default" and nothing else; the vendor names its
		   states for its own driver's lookup, so without this the SDIO pins are never muxed
		   and the bus is dead. The eMMC only escapes that because the bootloader muxed it. */
		pinctrl-names = "default";
		pinctrl-0 = <&sdio_all_pins>;
		clocks = <&clkc CLKID_SD_EMMC_A>,
		         <&clkc CLKID_SD_EMMC_A_CLK0>,
		         <&clkc CLKID_FCLK_DIV2>;
		clock-names = "core", "clkin0", "clkin1";
		mmc-pwrseq = <&sdio_pwrseq>;
		vmmc-supply = <&vcc_3v3>;
		vqmmc-supply = <&vcc_3v3>;
		bus-width = <4>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		/* 100 MHz is SDR104, which needs 1.8 V signalling this board does not switch to.
		   Enumeration survives it because that runs at 400 kHz in 1-bit mode. */
		max-frequency = <50000000>;
		non-removable;
		disable-wp;
		#address-cells = <1>;
		#size-cells = <0>;
		phandle = <0xca>;

		sdio {
			pinname = "sdio";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_4_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED", "MMC_CAP_NONREMOVABLE", "MMC_CAP_UHS_SDR12", "MMC_CAP_UHS_SDR25", "MMC_CAP_UHS_SDR50", "MMC_PM_KEEP_POWER", "MMC_CAP_SDIO_IRQ";
			f_min = <400000>;
			f_max = <50000000>;
			max_req_size = <0x20000>;
			card_type = <0x03>;
			auto_clk_close = <0x01>;
		};
	};

	mtd_nand {
		compatible = "amlogic, aml_mtd_nand";
		dev_name = "mtdnand";
		status = "disabled";
		reg = <0xd0074800 0x200>;
		interrupts = <GIC_SPI 34 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "nand_rb_mod", "nand_norb_mod", "nand_cs_only";
		pinctrl-0 = <&all_nand_pins>;
		pinctrl-1 = <&all_nand_pins>;
		pinctrl-2 = <&nand_cs_pins>;
		device_id = <0x00>;
		plat-names = "bootloader", "nandnormal";
		plat-num = <2>;
		plat-part-0 = <&bootloader>;
		plat-part-1 = <&nandnormal>;

		bootloader: bootloader {
			enable_pad = "ce0";
			busy_pad = "rb0";
			timming_mode = "mode5";
			bch_mode = "bch60_1k";
			t_rea = <0x14>;
			t_rhoh = <0x0f>;
			chip_num = <1>;
			part_num = <0>;
			rb_detect = <0x01>;
			phandle = <0x53>;
		};

		nandnormal: nandnormal {
			enable_pad = "ce0", "ce1";
			busy_pad = "rb0", "rb1";
			timming_mode = "mode5";
			bch_mode = "bch60_1k";
			plane_mode = "twoplane";
			t_rea = <0x14>;
			t_rhoh = <0x0f>;
			chip_num = <2>;
			part_num = <3>;
			partition = <&nand_partitions>;
			rb_detect = <0x01>;
			phandle = <0x54>;
		};

		nand_partitions: nand_partition {
			phandle = <0x55>;

			logo {
				offset = <0x00 0x00>;
				size = <0x00 0x200000>;
			};

			recovery {
				offset = <0x00 0x00>;
				size = <0x00 0x1000000>;
			};

			boot {
				offset = <0x00 0x00>;
				size = <0x00 0xc00000>;
			};

			system {
				offset = <0x00 0x00>;
				size = <0x00 0xdc40000>;
			};

			data {
				offset = <0xffffffff 0xffffffff>;
				size = <0x00 0x00>;
			};
		};
	};

	ethmac: ethernet@0xc9410000 {
		/* NOT FITTED - no Ethernet socket on this board. The SoC MAC block is
		   real and the driver binds to it, which is where eth0 and its stored
		   mac unifykey come from, but nothing is routed out, so it never gets
		   carrier. Left disabled rather than waiting on a PHY that cannot answer. */
		compatible = "amlogic,meson-gxbb-dwmac", "snps,dwmac";
		status = "disabled";
		reg = <0xc9410000 0x10000 0xc8834540 0x08 0xc8834558 0x0c 0xc1104408 0x04>;
		interrupts = <GIC_SPI 8 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "external_eth_pins";
		pinctrl-0 = <&external_eth_pins>;
		rst_pin-gpios = <&gpio 14 GPIO_ACTIVE_HIGH>;
		GPIOZ4_pin-gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
		GPIOZ5_pin-gpios = <&gpio 5 GPIO_ACTIVE_HIGH>;
		mc_val_internal_phy = <0x1800>;
		mc_val_external_phy = <0x1621>;
		cali_val = <0x20000>;
		interrupt-names = "macirq";
		clocks = <&clkc CLKID_ETH>;
		clock-names = "ethclk81";
		internal_phy = <0x01>;
		phandle = <0xcb>;
	};

	/* mainline's gxl USB is a controller wrapper holding dwc2 and dwc3, fed by
	   two usb2 phys. The vendor tree has a flat dwc3 with a vendor "usb-phy"
	   property and its own phy bindings, which no mainline driver claims - so the
	   host controller never probes, /sys/bus/usb/devices stays empty, and there is
	   no /dev/sda to mount a rootfs from. */
	usb2_phy0: phy@d0078000 {
		compatible = "amlogic,meson-gxl-usb2-phy";
		#phy-cells = <0>;
		reg = <0xd0078000 0x20>;
		clocks = <&clkc CLKID_USB>;
		clock-names = "phy";
		resets = <&reset RESET_USB_OTG>;
		reset-names = "phy";
		status = "okay";
	};

	usb2_phy1: phy@d0078020 {
		compatible = "amlogic,meson-gxl-usb2-phy";
		#phy-cells = <0>;
		reg = <0xd0078020 0x20>;
		clocks = <&clkc CLKID_USB>;
		clock-names = "phy";
		resets = <&reset RESET_USB_OTG>;
		reset-names = "phy";
		status = "okay";
	};

	usb: usb@d0078080 {
		compatible = "amlogic,meson-gxl-usb-ctrl";
		reg = <0xd0078080 0x20>;
		interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		clocks = <&clkc CLKID_USB>, <&clkc CLKID_USB1_DDR_BRIDGE>;
		clock-names = "usb_ctrl", "ddr";
		resets = <&reset RESET_USB_OTG>;
		dr_mode = "host";
		phys = <&usb2_phy0>, <&usb2_phy1>;
		phy-names = "usb2-phy0", "usb2-phy1";
		status = "okay";

		dwc2: usb@c9100000 {
			compatible = "amlogic,meson-g12a-usb", "snps,dwc2";
			reg = <0xc9100000 0x40000>;
			interrupts = <GIC_SPI 31 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clkc CLKID_USB1>;
			clock-names = "otg";
			phys = <&usb2_phy1>;
			dr_mode = "peripheral";
			g-rx-fifo-size = <0xc0>;
			g-np-tx-fifo-size = <0x80>;
			g-tx-fifo-size = <0x80 0x80 0x10 0x10 0x10>;
		};

		dwc3: usb@c9000000 {
			compatible = "snps,dwc3";
			reg = <0xc9000000 0x100000>;
			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
			dr_mode = "host";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
		};
	};



	unifykey {
		compatible = "amlogic, unifykey";
		status = "ok";
		unifykey-num = <19>;
		unifykey-index-0 = <0x59>;
		unifykey-index-1 = <0x5a>;
		unifykey-index-2 = <0x5b>;
		unifykey-index-3 = <0x5c>;
		unifykey-index-4 = <0x5d>;
		unifykey-index-5 = <0x5e>;
		unifykey-index-6 = <0x5f>;
		unifykey-index-7 = <0x60>;
		unifykey-index-8 = <0x61>;
		unifykey-index-9 = <0x62>;
		unifykey-index-10 = <0x63>;
		unifykey-index-11 = <0x64>;
		unifykey-index-12 = <0x65>;
		unifykey-index-13 = <0x66>;
		unifykey-index-14 = <0x67>;
		unifykey-index-15 = <0x68>;
		unifykey-index-16 = <0x69>;
		unifykey-index-17 = <0x6a>;
		unifykey-index-18 = <0x6b>;

		keysn_0: key_0 {
			key-name = "usid";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x59>;
