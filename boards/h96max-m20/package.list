# tvb-h96max-m20's files (mode src dest, src under boards/). package/board.sh adds the tree,
# the loader and the u-boot-menu drop-in; tvb-base holds what every board shares. Firmware goes
# under updates/, ahead of Debian's own.

# the decoder's GXLX2 builds from tvb-firmware-amlogic, ahead of Debian's of the same names
link /usr/lib/firmware/updates/meson/gxlx2/g12a_hevc_mmu.bin /usr/lib/tvb/firmware/meson/vdec/g12a_hevc_mmu.bin
link /usr/lib/firmware/updates/meson/gxlx2/g12a_vp9.bin      /usr/lib/tvb/firmware/meson/vdec/g12a_vp9.bin
link /usr/lib/firmware/updates/meson/gxlx2/gxl_mjpeg.bin     /usr/lib/tvb/firmware/meson/vdec/gxl_mjpeg.bin

# keys neither suspend nor power off a box nothing can wake
0644 h96max-m20/powerkey.conf    /usr/lib/systemd/logind.conf.d/zz-tvb-powerkey.conf
