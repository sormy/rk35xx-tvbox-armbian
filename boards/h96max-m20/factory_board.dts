		compatible = "amlogic, aml-pcm-dai";
		pinctrl-names = "audio_pcm";
		clocks = <&clkc CLKID_MPLL0>,
		         <&clkc CLKID_PCM_MCLK_COMP>,
		         <&clkc CLKID_PCM_SCLK_GATE>;
		clock-names = "mpll0", "pcm_mclk", "pcm_sclk";
		pcm_mode = <0x01>;
		dai-format = "dsp_a";
		dai-tdm-slot-tx-mask = <0x01>;
		dai-tdm-slot-rx-mask = <0x01>;
		dai-tdm-slot-num = <2>;
		dai-tdm-slot-width = <16>;
		phandle = <0x7d>;
	};

	i2s_plat: i2s_platform {
		compatible = "amlogic, aml-i2s";
		interrupts = <GIC_SPI 29 IRQ_TYPE_EDGE_RISING>;
		phandle = <0x79>;
	};

	pcm_plat: pcm_platform {
		compatible = "amlogic, aml-pcm";
		phandle = <0x7a>;
	};

	spdif_codec: spdif_codec {
		#sound-dai-cells = <0>;
		compatible = "amlogic, aml-spdif-codec";
		pinctrl-names = "audio_spdif_out";
		pinctrl-0 = <&audio_spdif_pins>;
		phandle = <0x7f>;
	};

	pcm_codec: pcm_codec {
		#sound-dai-cells = <0>;
		compatible = "amlogic, pcm2BT-codec";
		phandle = <0x80>;
	};

	dummy_codec: dummy {
		#sound-dai-cells = <0>;
		compatible = "amlogic, aml_dummy_codec";
		status = "disable";
		phandle = <0xd0>;
	};

	amlogic_codec: t9015 {
		#sound-dai-cells = <0>;
		compatible = "amlogic, aml_codec_T9015";
		reg = <0xc8832000 0x14>;
		status = "okay";
		phandle = <0x7e>;
	};

	aml_sound_meson {
		compatible = "aml, meson-snd-card";
		status = "okay";
		aml-sound-card,format = "i2s";
		aml_sound_card,name = "AML-MESONAUDIO";
		aml,audio-routing = "Ext Spk", "LOUTL", "Ext Spk", "LOUTR";
		mute_gpio-gpios = <&gpio 21 GPIO_ACTIVE_HIGH>;
		mute_inv;
		hp_disable;
		hp_paraments = <0x320 0x12c 0x00 0x05 0x01>;
		pinctrl-names = "audio_i2s";
		pinctrl-0 = <&audio_i2s_pins>;
		cpu_list = <&cpudai0>, <&cpudai1>, <&cpudai2>;
		codec_list = <&codec0>, <&codec1>, <&codec2>;
		plat_list = <&i2s_plat>, <&i2s_plat>, <&pcm_plat>;

		cpudai0: cpudai0 {
			sound-dai = <&i2s_dai>;
			phandle = <0x73>;
		};

		cpudai1: cpudai1 {
			sound-dai = <&spdif_dai>;
			phandle = <0x74>;
		};

		cpudai2: cpudai2 {
			sound-dai = <&pcm_dai>;
			phandle = <0x75>;
		};

		codec0: codec0 {
			sound-dai = <&amlogic_codec>;
			phandle = <0x76>;
		};

		codec1: codec1 {
			sound-dai = <&spdif_codec>;
			phandle = <0x77>;
		};

		codec2: codec2 {
			sound-dai = <&pcm_codec>;
			phandle = <0x78>;
		};
	};

	aml_sensor0: aml-sensor@0 {
		compatible = "amlogic, aml-thermal";
		device_name = "thermal";
		status = "okay";
		#thermal-sensor-cells = <1>;
		phandle = <0x81>;

		cooling_devices {

			cpufreq_cool_cluster0 {
				min_state = <1000000>;
				dyn_coeff = <140>;
				cluster_id = <0>;
				node_name = "cpufreq_cool0";
				device_type = "cpufreq";
			};

			cpucore_cool_cluster0 {
				min_state = <2>;
				dyn_coeff = <0>;
				cluster_id = <0>;
				node_name = "cpucore_cool0";
				device_type = "cpucore";
			};

			gpufreq_cool {
				min_state = <400>;
				dyn_coeff = <437>;
				cluster_id = <0>;
				node_name = "mali";
				device_type = "gpufreq";
			};

			gpucore_cool {
				min_state = <1>;
				dyn_coeff = <0>;
				cluster_id = <0>;
				node_name = "gpucore_cool0";
				device_type = "gpucore";
			};
		};

		cpufreq_cool0: cpufreq_cool0 {
			#cooling-cells = <2>;
			phandle = <0x83>;
		};

		cpucore_cool0: cpucore_cool0 {
			#cooling-cells = <2>;
			phandle = <0x84>;
		};

		gpucore_cool0: gpucore_cool0 {
			#cooling-cells = <2>;
			phandle = <0x86>;
		};
	};

	thermal-zones {

		soc_thermal {
			polling-delay = <1000>;
			polling-delay-passive = <100>;
			sustainable-power = <2150>;
			thermal-sensors = <&aml_sensor0 3>;

			trips {

				switch_on: trip-point@0 {
					temperature = <75000>;
					hysteresis = <1000>;
					type = "passive";
					phandle = <0xd1>;
				};

				control: trip-point@1 {
					temperature = <85000>;
					hysteresis = <1000>;
					type = "passive";
					phandle = <0x82>;
				};

				hot: trip-point@2 {
					temperature = <95000>;
					hysteresis = <5000>;
					type = "hot";
					phandle = <0xd2>;
				};

				critical: trip-point@3 {
					temperature = <260000>;
					hysteresis = <1000>;
					type = "critical";
					phandle = <0xd3>;
				};
			};

			cooling-maps {

				cpufreq_cooling_map {
					trip = <&control>;
					cooling-device = <&cpufreq_cool0 0 4>;
					contribution = <1024>;
				};

				cpucore_cooling_map {
					trip = <&control>;
					cooling-device = <&cpucore_cool0 0 3>;
					contribution = <1024>;
				};

				gpufreq_cooling_map {
					trip = <&control>;
					cooling-device = <&gpu 0 4>;
					contribution = <1024>;
				};

				gpucore_cooling_map {
					trip = <&control>;
					cooling-device = <&gpucore_cool0 0 2>;
					contribution = <1024>;
				};
			};
		};
	};
};
