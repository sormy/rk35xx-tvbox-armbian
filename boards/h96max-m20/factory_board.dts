		status = "okay";
		clocks = <&clkc CLKID_DOS_PARSER>,
		         <&clkc CLKID_DEMUX>,
		         <&clkc CLKID_DOS>,
		         <&clkc CLKID_CLK81>,
		         <&clkc CLKID_VDEC_MUX>,
		         <&clkc CLKID_HCODEC_MUX>,
		         <&clkc CLKID_HEVC_MUX>;
