		interrupt-names = "demux0_irq", "demux1_irq", "demux2_irq", "dvr0_irq", "dvr1_irq", "dvrfill0_fill", "dvrfill1_flush";
		clocks = <&clkc CLKID_DEMUX>,
		         <&clkc CLKID_ASYNC_FIFO>,
