# tvb-h96max-h313's files (mode src dest, src under boards/; link target dest for a symlink).
# package/board.sh adds the tree, the loader and the u-boot-menu drop-in; tvb-base holds what every
# board shares.

# the radio's RF settings from tvb-firmware-swt6621s, by the name the driver asks for first: the
# tree's compatible. A stand-alone BT antenna, FDD coexistence.
link /usr/lib/firmware/updates/swt6621s/SWT6621S_NV_SDIO_STANDALONE_FDD.bin /usr/lib/tvb/firmware/SWT6621S_NV_SDIO.h96max-h313,rk3518-tvbox.bin

# LEDs: red while off or asleep, blue while on (the tree's retain-state properties keep them)
0755 common/led-shutdown           /usr/lib/systemd/system-shutdown/tvb-led
0755 common/led-sleep              /usr/lib/systemd/system-sleep/tvb-led

# a short press suspends, IR wakes it; no PMIC, so poweroff parks the SoC powered
0644 common/suspend.conf           /usr/lib/systemd/sleep.conf.d/zz-tvb-suspend.conf
0644 common/powerkey.conf          /usr/lib/systemd/logind.conf.d/zz-tvb-powerkey.conf

# the video engines for a normal user, Bluetooth unblocked at registration
0644 common/vpu.rules              /usr/lib/udev/rules.d/99-tvb-vpu.rules
0644 common/rfkill-bt.rules        /usr/lib/udev/rules.d/60-tvb-rfkill-bt.rules
