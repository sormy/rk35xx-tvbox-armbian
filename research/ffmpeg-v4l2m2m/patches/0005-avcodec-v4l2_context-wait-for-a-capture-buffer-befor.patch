From a9f52e73e82f96183e911ae66b3abe9fd41d6385 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 13 Oct 2026 14:49:21 -0400
Subject: [PATCH] avcodec/v4l2_context: wait for a capture buffer before
 ending a drain

Draining with every capture buffer out in userspace was taken as the
end of the stream. A decoder that still holds input and ends its
drain with a LAST buffer is only waiting for the caller to free a
frame: an MPEG-4 stream from a fast reader ended after 15 of 60
pictures. Wait up to two seconds for a buffer to go back to the
driver first; LAST still ends the drain at once.
---
 libavcodec/v4l2_context.c | 23 +++++++++++++----------
 1 file changed, 13 insertions(+), 10 deletions(-)

diff --git a/libavcodec/v4l2_context.c b/libavcodec/v4l2_context.c
index be1df37..302fe47 100644
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -28,12 +28,15 @@
 #include <fcntl.h>
 #include <poll.h>
 #include "libavutil/mem.h"
+#include "libavutil/time.h"
 #include "libavcodec/avcodec.h"
 #include "decode.h"
 #include "v4l2_buffers.h"
 #include "v4l2_fmt.h"
 #include "v4l2_m2m.h"
 
+#define V4L2_DRAIN_WAIT_MS 2000
+
 struct v4l2_format_update {
     uint32_t v4l2_fmt;
     int update_v4l2;
@@ -290,17 +293,17 @@ static V4L2Buffer* v4l2_dequeue_v4l2buf(V4L2Context *ctx, int timeout)
                                                 "packets/frames.\n");
     }
 
-    /* if we are draining and there are no more capture buffers queued in the driver we are done */
+    /*
+     * Draining with no capture buffer in the driver: a decoder that ends a
+     * drain with a LAST buffer may only be waiting for the caller to free a
+     * frame, so give it V4L2_DRAIN_WAIT_MS before taking the stream as done.
+     */
     if (!V4L2_TYPE_IS_OUTPUT(ctx->type) && ctx_to_m2mctx(ctx)->draining) {
-        for (i = 0; i < ctx->num_buffers; i++) {
-            /* capture buffer initialization happens during decode hence
-             * detection happens at runtime
-             */
-            if (!ctx->buffers)
-                break;
-
-            if (ctx->buffers[i].status == V4L2BUF_IN_DRIVER)
-                goto start;
+        for (int ms = 0; ctx->buffers && ms <= V4L2_DRAIN_WAIT_MS; ms++) {
+            for (i = 0; i < ctx->num_buffers; i++)
+                if (ctx->buffers[i].status == V4L2BUF_IN_DRIVER)
+                    goto start;
+            av_usleep(1000);
         }
         ctx->done = 1;
         return NULL;
-- 
2.55.0

