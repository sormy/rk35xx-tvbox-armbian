From bad183e868fc07dfeace984e678fcfe97dd0bf2a Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Tue, 13 Oct 2026 14:22:49 -0400
Subject: [PATCH 1/5] avcodec/v4l2_m2m_dec: leave frames of an unstamped stream
 unstamped

A packet without pts went to the driver as 0, so every frame came
back at 0 and a constant-rate output kept a handful. Number such
packets for the driver instead, and hand their frames back without a
pts, as the software decoders do, so the caller times them.
---
 libavcodec/v4l2_buffers.c | 10 ++++++++--
 libavcodec/v4l2_m2m.h     |  4 ++++
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/libavcodec/v4l2_buffers.c b/libavcodec/v4l2_buffers.c
index f96c267..327e2d7 100644
--- a/libavcodec/v4l2_buffers.c
+++ b/libavcodec/v4l2_buffers.c
@@ -456,7 +456,7 @@ int ff_v4l2_buffer_buf_to_avframe(AVFrame *frame, V4L2Buffer *avbuf)
     frame->colorspace = v4l2_get_color_space(avbuf);
     frame->color_range = v4l2_get_color_range(avbuf);
     frame->color_trc = v4l2_get_color_trc(avbuf);
-    frame->pts = v4l2_get_pts(avbuf);
+    frame->pts = buf_to_m2mctx(avbuf)->no_pts ? AV_NOPTS_VALUE : v4l2_get_pts(avbuf);
     frame->pkt_dts = AV_NOPTS_VALUE;
     v4l2_get_interlacing(frame, avbuf);
 
@@ -507,7 +507,13 @@ int ff_v4l2_buffer_avpkt_to_buf(const AVPacket *pkt, V4L2Buffer *out)
     if (ret)
         return ret;
 
-    v4l2_set_pts(out, pkt->pts);
+    if (pkt->pts == AV_NOPTS_VALUE) {
+        V4L2m2mContext *s = buf_to_m2mctx(out);
+
+        s->no_pts = 1;
+        v4l2_set_pts(out, s->nopts_seq++);
+    } else
+        v4l2_set_pts(out, pkt->pts);
 
     if (pkt->flags & AV_PKT_FLAG_KEY)
         out->flags = V4L2_BUF_FLAG_KEYFRAME;
diff --git a/libavcodec/v4l2_m2m.h b/libavcodec/v4l2_m2m.h
index 4ba33dc..f8b92f0 100644
--- a/libavcodec/v4l2_m2m.h
+++ b/libavcodec/v4l2_m2m.h
@@ -58,6 +58,10 @@ typedef struct V4L2m2mContext {
     int draining;
     AVPacket buf_pkt;
 
+    /* the stream's packets carry no pts: number them, return frames unstamped */
+    int no_pts;
+    int64_t nopts_seq;
+
     /* Reference to a frame. Only used during encoding */
     AVFrame *frame;
 
