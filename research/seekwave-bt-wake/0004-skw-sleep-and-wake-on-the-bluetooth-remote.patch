+	 * it go back down. Set it only on the way out clean: resume is what clears it, and the
+	 * PM core does not resume a device whose suspend returned an error.
+	 */
+	if (!ret)
+		skw_sdio->suspend_wake_unlock_enable = 1;
 	return ret;
