#!/bin/sh
# rk35xx-update — apply the current repo's firmware to THIS running box, no reflash. Idempotent.
# Installs the payload (firmware/<board>/payload.list) into place, refreshes + rebuilds the DKMS
# drivers, reinstalls the device tree, reloads systemd + restarts the changed services, and reboots
# ONLY if the DTB actually changed. Run from a repo checkout on the box, or with --pull to fetch it.
#   usage: sudo rk35xx-update [--board <id>] [--pull] [--reboot | --no-reboot]
#
# The board is auto-detected from the identity dir; --board overrides. Every installed name derives
# from the board's BOARD_PREFIX (see firmware/<board>/board.conf), which is rk35xx- on every board.
#
# Deliberately does NOT redo the one-time image-build steps (rebrand, the unit-enable drop-in, the
# console/armbianEnv edit, board drop-ins) — those are already in place on a booted box, and the
# Wi-Fi/Bluetooth fixups live in the board's first-boot script. The bootloader (idbloader/uboot.itb)
# is never touched here; changing it on a live boot device is a separate, riskier operation.
set -e
[ "$(id -u)" = 0 ] || { echo "run as root (sudo rk35xx-update)"; exit 1; }

BOARD=""
PULL=0
REBOOT=ask
while [ $# -gt 0 ]; do
  case "$1" in
    --board)      BOARD="${2:?--board needs a board id}"; shift ;;
    --pull)       PULL=1 ;;
    --reboot)     REBOOT=yes ;;
    --no-reboot)  REBOOT=no ;;
    *) echo "unknown arg: $1"; exit 1 ;;
  esac
  shift
done

# board identity: explicit flag, else the shipped board-id, else the R69's pre-board-id layout
if [ -z "$BOARD" ]; then
  if [ -f /usr/local/share/rk35xx/board-id ]; then
    BOARD="$(cat /usr/local/share/rk35xx/board-id)"
  elif [ -d /usr/local/share/r69 ]; then
    BOARD=r69
  else
    echo "cannot tell which board this is (no /usr/local/share/rk35xx/board-id); pass --board"; exit 1
  fi
fi

REPO_URL=https://github.com/enoshei-beep/rk35xx-tvbox-armbian
SELF="$(cd "$(dirname "$0")" && pwd)"
if [ "$PULL" = 1 ]; then
  # pull in place when we're already in a checkout; otherwise clone beside the board's identity dir
  if [ -d "$SELF/.git" ]; then
    REPO="$SELF"
    git -C "$REPO" remote set-url origin "$REPO_URL"   # heals clones after a repo rename
    git -C "$REPO" pull --ff-only
  else
    case "$BOARD" in
      r69) REPO=/usr/local/share/r69/repo ;;      # the historical path deployed boxes already use
      *)   REPO=/usr/local/share/rk35xx/repo ;;
    esac
    # rk35xx-deploy leaves a non-git tree — host-owned files, a stale .git git refuses to open —
    # so probe the repo instead of the directory, and let origin win when it is not one.
    if git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$REPO" remote set-url origin "$REPO_URL" # heals clones after a repo rename
      git -C "$REPO" pull --ff-only
    else
      rm -rf "$REPO"
      git clone --depth 1 "$REPO_URL" "$REPO"
    fi
  fi
elif [ -f "$SELF/firmware/$BOARD/payload.list" ]; then
  REPO="$SELF"
else
  echo "not in a repo checkout (no firmware/$BOARD/payload.list next to me); re-run with --pull"; exit 1
fi
FW="$REPO/firmware"
[ -f "$FW/$BOARD/board.conf" ] || {
  echo "unknown board '$BOARD'; pass --board, one of: $(cd "$FW" && ls -d */board.conf | cut -d/ -f1 | tr '\n' ' ')"; exit 1; }
# shellcheck source=/dev/null
. "$FW/$BOARD/board.conf"
P="${BOARD_PREFIX:?board.conf must set BOARD_PREFIX}"

SHARE=/usr/local/share/$P
DKMS_IR=/usr/src/rockchip-pwm-remotectl-$P-1.0

dtbsum() { [ -f "$SHARE/board.dtb" ] && md5sum "$SHARE/board.dtb" | cut -d' ' -f1 || echo none; }
OLD_DTB="$(dtbsum)"

# pre-rename r69- units and hooks run alongside the rk35xx- ones if left in place.
# /usr/local/share/r69 stays: the running checkout may live under it.
# Delete artifacts of earlier layouts. Paths are named here only so they can be removed; what the
# payload installs is payload.list.
migrate() {
	old_units="r69-firstboot.service r69-mac-pin.service r69-bt.service"
	for u in $old_units; do
		[ -e "/etc/systemd/system/$u" ] || continue
		echo "  migrating: removing $u"
		systemctl disable --now "$u" >/dev/null 2>&1 || true
		rm -f "/etc/systemd/system/$u"
	done
	for f in /usr/local/sbin/r69-firstboot /usr/local/sbin/r69-mac-pin /usr/local/sbin/r69-bt \
		/usr/local/sbin/r69-boardname /usr/local/sbin/r69-update \
		/usr/local/sbin/rockchip-pwm-remotectl-r69-setup /usr/local/sbin/rk630-phy-r69-setup \
		/usr/lib/systemd/system-shutdown/r69-led /usr/lib/systemd/system-sleep/r69-led \
		/etc/systemd/sleep.conf.d/zz-r69-suspend.conf /etc/systemd/logind.conf.d/zz-r69-powerkey.conf \
		/etc/systemd/system.conf.d/zz-r69-watchdog.conf /etc/udev/rules.d/99-r69-vpu.rules \
		/etc/apt/apt.conf.d/99-r69-boardname /etc/update-motd.d/99-r69-bluetooth \
		/etc/kernel/postinst.d/r69-dtb-persist /etc/kernel/postinst.d/00-r69-kernel-prepare; do
		if [ -e "$f" ]; then echo "  migrating: removing $f"; rm -f "$f"; fi
	done
	for m in rockchip-pwm-remotectl-r69/1.0 rk630-phy-r69/1.0 rk630-phy-rk35xx/1.0; do
		dkms status "$m" 2>/dev/null | grep -q . || continue
		echo "  migrating: removing DKMS $m"
		dkms remove "$m" --all >/dev/null 2>&1 || true
	done
	rm -rf /usr/src/rockchip-pwm-remotectl-r69-1.0 /usr/src/rk630-phy-r69-1.0 /usr/src/rk630-phy-rk35xx-1.0

	# Stale on a board that disables the vendor fiq-debugger: the device never appears and the getty
	# waits out a 90 s timeout. Decide from board data — the run installing that DTB has no node yet.
	case "${BOARD_SERIALCON:-}" in
	*ttyFIQ0*) ;;
	*)
		for f in /etc/systemd/system/getty.target.wants/serial-getty@ttyFIQ0.service \
			/etc/systemd/system/serial-getty@ttyFIQ0.service; do
			if [ -e "$f" ]; then echo "  migrating: removing $f"; rm -f "$f"; fi
		done ;;
	esac

	# a board that stopped shipping the shared modules list must lose the copy an older image left,
	# or systemd-modules-load fails on every boot for modules it does not have
	if [ -e /etc/modules-load.d/rk35xx.conf ] &&
		! grep -q '/etc/modules-load.d/rk35xx.conf' "$FW/$BOARD_PAYLOAD"; then
		echo "  migrating: removing /etc/modules-load.d/rk35xx.conf"
		rm -f /etc/modules-load.d/rk35xx.conf
	fi

	# u-boot.itb was renamed to uboot.itb; the payload install right after this puts the new one in
	if [ -e "$SHARE/u-boot.itb" ]; then
		echo "  migrating: removing $SHARE/u-boot.itb"
		rm -f "$SHARE/u-boot.itb"
	fi

	return 0
}
migrate

# Step 5 restarts these; snapshot their bytes before the payload install rewrites them.
# Restarting an unchanged rk35xx-bt.service tears down a live radio for nothing.
UPDATE_UNITS="${BOARD_UPDATE_RESTART:-} ${BOARD_UPDATE_TRY_RESTART:-}"
unitsum() {
	for u in $UPDATE_UNITS; do
		f=$(systemctl show -p FragmentPath --value "$u" 2>/dev/null) || f=""
		echo "$u $f"
		if [ -f "$f" ]; then
			cat "$f"
			sed -n 's/^Exec[A-Za-z]*= *-*\([^ ]*\).*/\1/p' "$f" | while IFS= read -r b; do
				if [ -f "$b" ]; then md5sum "$b"; fi
			done
		fi
	done
}
UNITS_BEFORE=$(unitsum)

echo "[1/6] installing firmware payload ($BOARD)"
while read -r mode src dest; do
  case "$mode" in ''|\#*) continue ;; esac
  # one payload entry is this script: truncating the inode the shell is reading resumes it mid-token.
  # The staging name is hidden and .new-suffixed, which systemd and run-parts both skip.
  stage="$(dirname "$dest")/.$(basename "$dest").rk35xx-new"
  install -D -m "$mode" "$FW/$src" "$stage"
  mv -f "$stage" "$dest"
done < "$FW/$BOARD_PAYLOAD"
"/usr/local/sbin/$P-boardname"   # re-assert the login-banner name (apt upgrades reset it)

echo "[2/6] refreshing DKMS driver sources + rebuilding"
# dkms_rebuild() absorbs per-step failures with "continuing", so a missing dkms would read as a
# successful update while nothing rebuilt — and the next kernel update then ships without the
# IR module. Decide here, loudly, instead of three messages deep.
if [ -f "$DKMS_IR/dkms.conf" ] || [ -n "${BOARD_DKMS_FETCH:-}" ]; then
  command -v dkms >/dev/null 2>&1 || {
    echo "  dkms is not installed: these modules cannot be rebuilt and a kernel update would drop them." >&2
    echo "  fix: apt-get install --no-upgrade dkms   then re-run" >&2
    exit 1
  }
fi
# a board with no IR receiver ships neither the Makefile nor dkms.conf that the fetch needs
if [ -f "$DKMS_IR/dkms.conf" ]; then "$FW/common/fetch-dkms-src.sh" "$DKMS_IR"; fi

# rebuild so a changed source or a new kernel actually takes: remove --all, then add/build/install.
# Version comes from the directory name, so 1.0 and 1.0.0 packages both work.
dkms_rebuild() {
  d="$(basename "$1")"; name="${d%-*}"; ver="${d##*-}"
  dkms remove  -m "$name" -v "$ver" --all 2>/dev/null || true
  dkms add     -m "$name" -v "$ver" || { echo "  ($name dkms add failed; continuing)"; return 0; }
  dkms build   -m "$name" -v "$ver" || { echo "  ($name dkms build failed; continuing)"; return 0; }
  dkms install -m "$name" -v "$ver" || echo "  ($name dkms install failed; continuing)"
}
if [ -f "$DKMS_IR/dkms.conf" ]; then dkms_rebuild "$DKMS_IR"; fi

# boards that fetch their own DKMS sources declare them as "<pkg>-<ver>:<fetch script>" pairs
for e in ${BOARD_DKMS_FETCH:-}; do
  d="/usr/src/${e%%:*}"
  echo "  fetching ${e%%:*}"
  # the fetch swaps in place, so a failure leaves the previous tree whole — rebuild from it
  "$FW/${e#*:}" "$d" || echo "  (fetch failed; rebuilding the staged source)"
  dkms_rebuild "$d"
done

echo "[3/6] installing the DTB into the running kernel"
"/etc/kernel/postinst.d/$P-dtb-persist" "$(uname -r)"

echo "[4/6] checking the U-Boot FIT on the boot device"
# Only uboot.itb. The idbloader at sector 64 stays factory: its DDR tuning is the one thing no
# rebuild reproduces, and a bad one costs a maskrom recovery. A bad FIT does not — TPL/SPL still
# run, so ctrl+b and the recovery button both survive it.
UBOOT_SEEK=16384         # the uboot partition is two slots; build-image.sh writes the same two
UBOOT_SLOT_SECTORS=4096
UBOOT_COPIES=2
update_uboot() {
  src="$SHARE/uboot.itb"
  [ -f "$src" ] || { echo "  this board ships no uboot.itb"; return 0; }
  # mmcblk numbering moves between boots, so resolve the disk now rather than remember one
  dev="/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null)"
  [ -b "$dev" ] || { echo "  cannot resolve the disk / is on — skipped"; return 0; }
  [ "$(od -An -tx1 -N4 "$src" | tr -d ' \n')" = d00dfeed ] ||
    { echo "  $src is not a FIT — skipped"; return 0; }
  bytes=$(wc -c < "$src")
  [ "$bytes" -le $((UBOOT_SLOT_SECTORS * 512)) ] ||
    { echo "  $src is $bytes bytes, past the slot — skipped"; return 0; }

  slot() { dd if="$dev" bs=512 skip="$1" count="$UBOOT_SLOT_SECTORS" 2>/dev/null | head -c "$bytes" | md5sum; }
  want=$(md5sum < "$src")
  i=0
  while [ "$i" -lt "$UBOOT_COPIES" ]; do
    at=$((UBOOT_SEEK + i * UBOOT_SLOT_SECTORS)); i=$((i + 1))
    [ "$(slot "$at")" = "$want" ] && { echo "  slot $at already current"; continue; }
    # clear first, or the tail of a longer predecessor survives behind a shorter blob
    dd if=/dev/zero of="$dev" bs=512 seek="$at" count="$UBOOT_SLOT_SECTORS" conv=notrunc status=none
    dd if="$src"    of="$dev" bs=512 seek="$at" conv=notrunc,fsync status=none
    [ "$(slot "$at")" = "$want" ] && echo "  slot $at written and verified" ||
      echo "  slot $at VERIFY FAILED"
  done
}
update_uboot

echo "[5/6] reloading systemd + restarting changed services"
systemctl daemon-reload
# udev reads only the compiled hwdb.bin; skip the rebuild on boards that ship no keymap
[ -n "$(ls -A /etc/udev/hwdb.d 2>/dev/null)" ] && systemd-hwdb update || true
# device-node rules only apply to nodes that already exist after a re-trigger (VPU: mpp_class, misc)
udevadm control --reload
udevadm trigger --subsystem-match=mpp_class --subsystem-match=misc --subsystem-match=dma_heap \
  --subsystem-match=input
if [ "$(unitsum)" = "$UNITS_BEFORE" ]; then
  echo "  (restart-listed units unchanged — no service restarted)"
else
  for s in ${BOARD_UPDATE_RESTART:-}; do systemctl restart "$s" 2>/dev/null || true; done
  for s in ${BOARD_UPDATE_TRY_RESTART:-}; do systemctl try-restart "$s" 2>/dev/null || true; done
fi
echo "  (power-key / suspend drop-ins take effect after 'systemctl restart systemd-logind' or a reboot)"

echo "[6/6] done"
if [ "$OLD_DTB" != "$(dtbsum)" ]; then
  echo "device tree changed — a reboot is required to load it."
  case "$REBOOT" in
    yes) echo "rebooting now…"; reboot ;;
    no)  echo "reboot skipped (--no-reboot); run 'reboot' when ready." ;;
    ask) printf "reboot now? [y/N] "; read -r ans; case "$ans" in [yY]) reboot ;; *) echo "run 'reboot' when ready." ;; esac ;;
  esac
else
  echo "device tree unchanged — no reboot needed. New drivers/services are live."
fi
