#!/usr/bin/env bash
# rk35xx-deploy — push this repo to a running box over SSH and apply it in place (no reflash). A thin
# transport around rk35xx-update: tar the repo to the box (excluding git + images), then run
# rk35xx-update there. All the apply logic lives in rk35xx-update, so host and box stay in sync.
#   usage: ./rk35xx-deploy [user@]host [--board <id>] [--reboot | --no-reboot]
# The board is read off the box when not given. Needs SSH to a root (or passwordless-sudo) account;
# default is NOT to auto-reboot.
set -euo pipefail

HOST="${1:?usage: rk35xx-deploy [user@]host [--board <id>] [--reboot|--no-reboot]}"; shift || true
BOARD=""
REBOOT_ARG="--no-reboot"
while [ $# -gt 0 ]; do
  case "$1" in
    --board)     BOARD="${2:?--board needs a board id}"; shift ;;
    --reboot)    REBOOT_ARG="--reboot" ;;
    --no-reboot) REBOOT_ARG="--no-reboot" ;;
    *) echo "unknown arg: $1"; exit 1 ;;
  esac
  shift
done

REPO="$(cd "$(dirname "$0")" && pwd)"
if [ -z "$BOARD" ]; then
  BOARD="$(ssh "$HOST" 'cat /usr/local/share/rk35xx/board-id 2>/dev/null || { [ -d /usr/local/share/r69 ] && echo r69; }')"
  [ -n "$BOARD" ] || { echo "cannot tell which board $HOST is; pass --board"; exit 1; }
  echo "→ board: $BOARD (detected)"
fi
[ -f "$REPO/firmware/$BOARD/board.conf" ] || { echo "unknown board '$BOARD' (no firmware/$BOARD/board.conf)"; exit 1; }
# shellcheck source=/dev/null
. "$REPO/firmware/$BOARD/board.conf"
DEST=/usr/local/share/${BOARD_PREFIX:?board.conf must set BOARD_PREFIX}/repo

echo "→ syncing repo to $HOST:$DEST"
tar czf - -C "$REPO" \
  --exclude=.git --exclude=images --exclude=uboot-build --exclude='backup*' --exclude='*.img' --exclude='*.img.xz' . \
  | ssh "$HOST" "sudo mkdir -p '$DEST' && sudo tar xzf - -C '$DEST'"

echo "→ applying on $HOST  (rk35xx-update --board $BOARD $REBOOT_ARG)"
ssh -t "$HOST" "sudo '$DEST/rk35xx-update' --board '$BOARD' $REBOOT_ARG"
