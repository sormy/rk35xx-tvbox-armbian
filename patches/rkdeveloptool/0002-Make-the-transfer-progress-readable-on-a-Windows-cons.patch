From: Artem Butusov <art.sormy@gmail.com>
Subject: [PATCH] Make the transfer progress readable on a Windows console

A console created by cmd.exe starts with VT processing disabled, so the
escapes the progress line rewrites itself with print as literal text, and
a redirected stdout is block-buffered, holding the percentage back until
the transfer ends.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
--- a/main.cpp
+++ b/main.cpp
@@ -25,6 +25,25 @@
 #define CURSOR_CLEAR_SCREEN printf("%c[2J", 0x1B)
 #define ERROR_COLOR_ATTR  printf("%c[30;41m", 0x1B);
 #define NORMAL_COLOR_ATTR  printf("%c[0m", 0x1B);
+
+#ifdef __MINGW32__
+#include <windows.h>
+/* cmd.exe starts with VT processing off, so the escapes the progress line rewrites
+   itself with print as literal text, and a redirected stdout holds the percentage
+   back until the transfer ends. */
+static void enable_console_output(void)
+{
+	HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);
+	DWORD mode;
+
+	if (hOut != INVALID_HANDLE_VALUE && GetConsoleMode(hOut, &mode))
+		SetConsoleMode(hOut, mode | ENABLE_VIRTUAL_TERMINAL_PROCESSING);
+	setvbuf(stdout, NULL, _IONBF, 0);
+}
+#else
+static void enable_console_output(void) {}
+#endif
+
 extern UINT CRC_32(unsigned char* pData, UINT ulSize);
 extern unsigned short CRC_16(unsigned char* aData, UINT aSize);
 extern void P_RC4(unsigned char* buf, unsigned short len);
@@ -3394,6 +3413,7 @@
 
 int main(int argc, char* argv[])
 {
+	enable_console_output();
 	CRKScan *pScan = NULL;
 	int ret;
 	char szProgramProcPath[100];
