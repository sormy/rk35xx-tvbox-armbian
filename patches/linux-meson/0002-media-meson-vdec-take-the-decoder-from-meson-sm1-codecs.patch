diff --git a/drivers/staging/media/meson/vdec/Kconfig b/drivers/staging/media/meson/vdec/Kconfig
index 19ffea9..efabafc 100644
--- a/drivers/staging/media/meson/vdec/Kconfig
+++ b/drivers/staging/media/meson/vdec/Kconfig
@@ -6,6 +6,17 @@ config VIDEO_MESON_VDEC
 	depends on ARCH_MESON || COMPILE_TEST
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
+	select V4L2_H264
 	select MESON_CANVAS
 	help
 	Support for the video decoder found in gxbb/gxl/gxm chips.
+
+config VIDEO_MESON_VDEC_KUNIT_TEST
+	bool "KUnit tests for the Amlogic video decoder" if !KUNIT_ALL_TESTS
+	depends on VIDEO_MESON_VDEC && KUNIT
+	default KUNIT_ALL_TESTS
+	help
+	  Build unit tests for the protocol and state handling used by the
+	  Amlogic video decoder. The tests cover H.264 picture order count,
+	  decoded picture buffer management and reference list construction.
+	  This option is intended for kernel developers.
