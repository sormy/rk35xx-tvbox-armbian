From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Sun, 11 Oct 2026 22:00:00 -0400
Subject: [PATCH] drm/meson: dw-hdmi: take the GXLX2 node from the built-in driver

Build the GXLX2-capable driver as its own module next to the built-in
one. The node's GXL fallback compatible is what built-in meson-drm
matches, so built-in meson-dw-hdmi binds the node first; the tree gives
the resets without reset-names, so that bind fails before it writes the
GXL port layout into the directly mapped window, which stops the boot.

At load, pin the node to this driver with driver_override, release it
from the built-in one, and take the resets by index.

Not for upstream: this exists only because the running kernel has
meson-dw-hdmi built in.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
  drivers/gpu/drm/meson/meson_dw_hdmi.c |   42 +++++++++++++++++++++++++++------
  1 file changed, 34 insertions(+), 8 deletions(-)

--- a/drivers/gpu/drm/meson/meson_dw_hdmi.c
+++ b/drivers/gpu/drm/meson/meson_dw_hdmi.c
@@ -11,6 +11,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
+#include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
 #include <linux/reset.h>
@@ -29,7 +30,7 @@
 #include "meson_dw_hdmi.h"
 #include "meson_registers.h"
 
-#define DRIVER_NAME "meson-dw-hdmi"
+#define DRIVER_NAME "meson-dw-hdmi-gxlx2"
 #define DRIVER_DESC "Amlogic Meson HDMI-TX DRM driver"
 
 /**
@@ -719,22 +720,22 @@
 	if (ret < 0 && ret != -ENODEV)
 		return ret;
 
-	meson_dw_hdmi->hdmitx_apb = devm_reset_control_get_exclusive(dev,
-						"hdmitx_apb");
+	meson_dw_hdmi->hdmitx_apb = devm_reset_control_get_exclusive_by_index(dev,
+						0);
 	if (IS_ERR(meson_dw_hdmi->hdmitx_apb)) {
 		dev_err(dev, "Failed to get hdmitx_apb reset\n");
 		return PTR_ERR(meson_dw_hdmi->hdmitx_apb);
 	}
 
-	meson_dw_hdmi->hdmitx_ctrl = devm_reset_control_get_exclusive(dev,
-						"hdmitx");
+	meson_dw_hdmi->hdmitx_ctrl = devm_reset_control_get_exclusive_by_index(dev,
+						1);
 	if (IS_ERR(meson_dw_hdmi->hdmitx_ctrl)) {
 		dev_err(dev, "Failed to get hdmitx reset\n");
 		return PTR_ERR(meson_dw_hdmi->hdmitx_ctrl);
 	}
 
-	meson_dw_hdmi->hdmitx_phy = devm_reset_control_get_exclusive(dev,
-						"hdmitx_phy");
+	meson_dw_hdmi->hdmitx_phy = devm_reset_control_get_exclusive_by_index(dev,
+						2);
 	if (IS_ERR(meson_dw_hdmi->hdmitx_phy)) {
 		dev_err(dev, "Failed to get hdmitx_phy reset\n");
 		return PTR_ERR(meson_dw_hdmi->hdmitx_phy);
@@ -886,7 +887,32 @@
 		.pm = &meson_dw_hdmi_pm_ops,
 	},
 };
-module_platform_driver(meson_dw_hdmi_platform_driver);
+
+/* The built-in meson-dw-hdmi binds the node first, through its GXL fallback. */
+static int __init meson_dw_hdmi_gxlx2_init(void)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	int ret = 0;
+
+	np = of_find_compatible_node(NULL, NULL, "amlogic,meson-gxlx2-dw-hdmi");
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (pdev) {
+		ret = device_set_driver_override(&pdev->dev, DRIVER_NAME);
+		if (!ret)
+			device_release_driver(&pdev->dev);
+		put_device(&pdev->dev);
+	}
+	return ret ?: platform_driver_register(&meson_dw_hdmi_platform_driver);
+}
+module_init(meson_dw_hdmi_gxlx2_init);
+
+static void __exit meson_dw_hdmi_gxlx2_exit(void)
+{
+	platform_driver_unregister(&meson_dw_hdmi_platform_driver);
+}
+module_exit(meson_dw_hdmi_gxlx2_exit);
 
 MODULE_AUTHOR("Neil Armstrong <narmstrong@baylibre.com>");
 MODULE_DESCRIPTION(DRIVER_DESC);
-- 
2.47.0

