+/* The calibration file ships identically to every board, so the address in it
+ * belongs to none of them. The chip's own is in the efuse.
+ */
+static void mt7615_eeprom_mac_from_efuse(struct mt7615_dev *dev)
+{
+	u32 base = round_down(MT_EE_MAC_ADDR, MT7615_EFUSE_BLOCK_SIZE);
+	u8 block[MT7615_EFUSE_BLOCK_SIZE];
+	u8 *addr = block + MT_EE_MAC_ADDR - base;
+
+	if (mt7615_mcu_get_efuse(dev, MT_EE_MAC_ADDR, block) ||
+	    !is_valid_ether_addr(addr)) {
+		dev_warn(dev->mt76.dev, "no address in the efuse, using a random one\n");
+		eth_random_addr(addr);
+	}
+
+	memcpy(dev->mt76.eeprom.data + MT_EE_MAC_ADDR, addr, ETH_ALEN);
+}
