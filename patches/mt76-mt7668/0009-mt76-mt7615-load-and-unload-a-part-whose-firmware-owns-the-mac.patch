+/* Where the efuse register window is unreachable, the firmware still answers
+ * for it: one block, from a block-aligned address.
+ */
+int mt7615_mcu_get_efuse(struct mt7615_dev *dev, u32 offset, u8 *buf)
+{
+	struct mt7615_efuse_block {
+		__le32 addr;
+		__le32 valid;
+		u8 data[MT7615_EFUSE_BLOCK_SIZE];
+	} __packed req = {
+		.addr = cpu_to_le32(round_down(offset,
+					       MT7615_EFUSE_BLOCK_SIZE)),
+	};
+	struct mt7615_efuse_block *res;
+	struct sk_buff *skb;
+	int ret;
+
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76, MCU_EXT_QUERY(EFUSE_ACCESS),
+					&req, sizeof(req), true, &skb);
+	if (ret)
+		return ret;
+
+	res = (struct mt7615_efuse_block *)skb->data;
+	if (skb->len < sizeof(*res))
+		ret = -EINVAL;
+	else
+		memcpy(buf, res->data, MT7615_EFUSE_BLOCK_SIZE);
+
+	dev_kfree_skb(skb);
+
+	return ret;
+}
+
+#define MT7615_EE_SOURCE_BUFFER		1
+#define MT7615_EE_COUNT_UNUSED		0xff
+
+/* A four-byte header - the source, an unused block count and the format -
+ * then the calibration window alone, not the whole EEPROM.
+ */
+
+static int mt7615_mcu_set_eeprom_window(struct mt7615_dev *dev)
+{
+	struct {
+		u8 source_mode;
+		u8 count;
+		u8 cmd_type;
+		u8 __rsv;
+	} __packed req_hdr = {
+		.source_mode = MT7615_EE_SOURCE_BUFFER,
+		.count = MT7615_EE_COUNT_UNUSED,
+		.cmd_type = dev->fw->ee_cmd_type,
+	};
+	u8 *eep = (u8 *)dev->mt76.eeprom.data;
+	struct sk_buff *skb;
+
+	skb = mt76_mcu_msg_alloc(&dev->mt76, NULL,
+				 sizeof(req_hdr) + dev->fw->ee_cal_len);
+	if (!skb)
+		return -ENOMEM;
+
+	skb_put_data(skb, &req_hdr, sizeof(req_hdr));
+	skb_put_data(skb, eep + dev->fw->ee_cal_start, dev->fw->ee_cal_len);
+
+	return mt76_mcu_skb_send_msg(&dev->mt76, skb,
+				     MCU_EXT_CMD(EFUSE_BUFFER_MODE), true);
+}
