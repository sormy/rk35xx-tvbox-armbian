+/* the MT7668 splits its cr4 image in two as well, and starts each without an
+ * override address
+ */
+static int mt7668_load_ram(struct mt7615_dev *dev, const char *name, u32 flag)
+{
+	const struct mt7615_fw_trailer *hdr;
+	const struct firmware *fw;
+	int ret;
+
+	ret = request_firmware(&fw, name, dev->mt76.dev);
+	if (ret)
+		return ret;
+
+	if (fw->size < N9_REGION_NUM * sizeof(*hdr)) {
+		dev_err(dev->mt76.dev, "Invalid firmware %s\n", name);
+		ret = -EINVAL;
+		goto out;
+	}
+
+	hdr = (const void *)(fw->data + fw->size - N9_REGION_NUM * sizeof(*hdr));
+	dev_info(dev->mt76.dev, "%s Version: %.10s, Build Time: %.15s\n",
+		 name, hdr->fw_ver, hdr->build_date);
+
+	ret = mt7615_mcu_send_ram_firmware(dev, hdr, fw->data, N9_REGION_NUM,
+					   flag & FW_START_WORKING_PDA_CR4);
+	if (!ret)
+		ret = mt76_connac_mcu_start_firmware(&dev->mt76, 0, flag);
+
+out:
+	release_firmware(fw);
+	return ret;
+}
