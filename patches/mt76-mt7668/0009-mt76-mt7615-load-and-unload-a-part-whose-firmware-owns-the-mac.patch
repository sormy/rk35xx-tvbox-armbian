+/* Where MT_TOP_MISC2_FW_N9_RDY stays zero, the host interface's ready bit is
+ * what says a firmware is already running. One that is will not give up the
+ * patch semaphore and the download times out.
+ */
+static bool mt7663s_fw_resident(struct mt7615_dev *dev)
+{
+	struct sdio_func *func = dev->mt76.sdio.func;
+	int err = 0;
+	u32 val;
+
+	sdio_claim_host(func);
+	val = sdio_readl(func, MCR_WCIR, &err);
+	sdio_release_host(func);
+
+	if (err)
+		return false;
+
+	return val & WCIR_WLAN_READY;
+}
+
+/* Power the firmware down and wait for the host interface to say it has gone,
+ * or the next download cannot take the patch semaphore.
+ */
+void mt7663s_mcu_exit(struct mt7615_dev *dev)
+{
+	bool resident;
+
+	if (!test_and_clear_bit(MT76_STATE_MCU_RUNNING, &dev->mphy.state))
+		return;
+
+	mt76_connac_mcu_restart(&dev->mt76);
+
+	if (read_poll_timeout(mt7663s_fw_resident, resident, !resident,
+			      MT7663S_FW_GONE_POLL_US,
+			      MT7663S_FW_GONE_TIMEOUT_US, false, dev))
+		dev_warn(dev->mt76.dev, "firmware did not power down\n");
+
+	/* keeping driver ownership across an unload leaves the next download
+	 * unanswered
+	 */
+	mt7615_mcu_set_fw_ctrl(dev);
+}
