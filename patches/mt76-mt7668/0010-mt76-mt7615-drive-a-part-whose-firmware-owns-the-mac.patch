+	phy = mvif->mt76.band_idx ? mt7615_ext_phy(dev) : &dev->phy;
+
+	mt7615_mutex_acquire(dev);
+	ret = mt7668_mcu_assoc(phy, vif, sta);
+	mt7615_mutex_release(dev);
+
+	return ret;
