+
+static int mt7668_mcu_add_dev_info(struct mt7615_phy *phy,
+				   struct ieee80211_vif *vif, bool enable)
+{
+	return 0;
+}
+
+static int mt7668_mcu_add_bss_info(struct mt7615_phy *phy,
+				   struct ieee80211_vif *vif,
+				   struct ieee80211_sta *sta, bool enable)
+{
+	if (sta)
+		return mt7668_mcu_join(phy, vif, sta, enable);
+
+	if (!enable)
+		mt7668_mcu_leave(phy, vif);
+
+	return 0;
+}
