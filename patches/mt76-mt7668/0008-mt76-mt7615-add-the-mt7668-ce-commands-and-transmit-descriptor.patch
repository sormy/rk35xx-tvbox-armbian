--- a/mt7615/mcu_ce.c	2026-08-09 14:25:30
+++ b/mt7615/mcu_ce.c	2026-09-21 12:00:00
@@ -0,0 +1,910 @@
+// SPDX-License-Identifier: ISC
+/* Copyright (C) 2026 Artem Butusov <art.sormy@gmail.com> */
+
+/* The CE command set of a firmware that owns the MAC: flat structures. */
+
+#include <linux/etherdevice.h>
+#include "mt7615.h"
+#include "mcu.h"
+
+#define MT7668_PHY_HR_DSSS	BIT(0)
+#define MT7668_PHY_ERP	BIT(1)
+#define MT7668_PHY_OFDM	BIT(3)
+#define MT7668_PHY_HT	BIT(4)
+#define MT7668_PHY_VHT	BIT(5)
+#define MT7668_RATES_2G	0x3fcf
+#define MT7668_RATES_5G	0x3fc0
+#define MT7668_BASIC_2G	0x000f
+#define MT7668_BASIC_5G	0x0540
+#define MT7668_STA_LEGACY_AP	(BIT(0) | BIT(6))
+#define MT7668_JOIN_INTERVAL	4000	/* ms */
+#define MT7668_JOIN_GRANT_TIMEOUT	(5 * HZ)
+#define MT7668_ROC_TOKEN	1
+#define MT7668_ROC_JOIN		0	/* request type */
+#define MT7668_WTBL_RESERVED	0xff
+#define MT7668_STA_IDX	0
+
+#define MT7668_MCS_ALL	0xff
+#define MT7668_NSS		2
+#define MT7668_STA_NONE	0xfe
+#define MT7668_RTS_LEGACY	3
+/* the capability reply's transmit resource element */
+#define MT7668_CAP_TX_RESOURCE	0
+/* TxBaSize and RxHtBaSize, and TxMaxAmsduInAmpduLen */
+#define MT7668_BA_SIZE	64
+#define MT7668_MAX_AMSDU_LEN	0x0fff
+
+enum {
+	MT7668_BSS_CONNECTED,
+	MT7668_BSS_DISCONNECTED,
+};
+
+/* station states, by the frame classes the part will accept */
+enum {
+	MT7668_STA_STATE_1,		/* class 1 */
+	MT7668_STA_STATE_2,		/* class 1 and 2 */
+	MT7668_STA_STATE_3,		/* class 1, 2 and 3 */
+};
+
+struct mt7668_bss_rlm {
+	u8 bss_idx;
+	u8 band;
+	u8 pri_ch;
+	u8 sco;
+	u8 erp_prot_mode;
+	u8 ht_prot_mode;
+	u8 gf_mode;
+	u8 rifs_mode;
+	__le16 ht_op_info3;
+	__le16 ht_op_info2;
+	u8 ht_op_info1;
+	u8 short_preamble;
+	u8 short_slot;
+	u8 vht_bw;
+	u8 vht_ch_s1;
+	u8 vht_ch_s2;
+	__le16 vht_basic_mcs;
+	u8 nss;
+	u8 __rsv;
+} __packed;
+
+struct mt7668_bss_info {
+	u8 bss_idx;
+	u8 conn_state;
+	u8 op_mode;
+	u8 ssid_len;
+	u8 ssid[IEEE80211_MAX_SSID_LEN];
+	u8 bssid[ETH_ALEN];
+	u8 qbss;
+	u8 __rsv0;
+	__le16 op_rates;
+	__le16 basic_rates;
+	u8 ap_sta_idx;
+	u8 __rsv1;
+	__le16 fixed_rate;
+	u8 non_ht_phy_type;
+	u8 auth_mode;
+	u8 enc_status;
+	u8 phy_type_set;
+	u8 wapi_mode;
+	u8 ap_mode;
+	u8 bmc_wlan_idx;
+	u8 hidden_ssid_mode;
+	u8 disconnect_detect_th;
+	u8 __rsv2[3];
+	__le32 private_data;
+	struct mt7668_bss_rlm rlm;
+	u8 dbdc_band;
+	u8 wmm_set;
+	u8 dbdc_action;
+	u8 nss;
+	u8 __rsv3[22];
+} __packed;
+
+struct mt7668_sta_rec {
+	u8 sta_idx;
+	u8 sta_type;
+	u8 addr[ETH_ALEN];
+	__le16 aid;
+	__le16 listen_interval;
+	u8 bss_idx;
+	u8 phy_type_set;
+	__le16 non_ht_rates;
+	__le16 basic_rates;
+	u8 qos;
+	u8 uapsd;
+	u8 state;
+	u8 mcs_set;
+	u8 sup_mcs32;
+	u8 __rsv0;
+	u8 rx_mcs_bitmask[10];
+	__le16 rx_highest_rate;
+	__le32 tx_rate_info;
+	__le16 ht_cap_info;
+	__le16 ht_ext_cap;
+	__le32 tx_bf_cap;
+	u8 ampdu_param;
+	u8 asel_cap;
+	u8 rcpi;
+	u8 need_resp;
+	u8 uapsd_ac;
+	u8 uapsd_sp;
+	u8 wlan_idx;
+	u8 bmc_wlan_idx;
+	__le32 vht_cap_info;
+	__le16 vht_rx_mcs_map;
+	__le16 vht_rx_highest_rate;
+	__le16 vht_tx_mcs_map;
+	__le16 vht_tx_highest_rate;
+	u8 rts_policy;
+	u8 vht_op_mode;
+	u8 traffic_type;
+	u8 tx_gf_mode;
+	u8 tx_sgi_mode;
+	u8 tx_stbc_mode;
+	__le16 fixed_rate;
+	u8 tx_ampdu;
+	u8 rx_ampdu;
+	u8 __rsv1[2];
+	__le32 fixed_phy_rate;
+	__le16 max_link_speed;
+	__le16 min_link_speed;
+	__le32 flags;
+	u8 tx_ba_size;
+	u8 rx_ba_size;
+	u8 __rsv2[2];
+	u8 tx_bf_pfmu[32];
+	u8 tx_amsdu_in_ampdu;
+	u8 rx_amsdu_in_ampdu;
+	u8 __rsv3[2];
+	__le32 tx_max_amsdu_len;
+} __packed;
+
+/* the part numbers its bands from one, zero meaning none */
+static u8 mt7668_band(struct cfg80211_chan_def *chandef)
+{
+	return chandef->chan->band == NL80211_BAND_2GHZ ? 1 : 2;
+}
+
+static u8 mt7668_phy_types(struct cfg80211_chan_def *chandef,
+			   struct ieee80211_sta *sta)
+{
+	if (chandef->chan->band == NL80211_BAND_2GHZ)
+		return MT7668_PHY_HR_DSSS | MT7668_PHY_ERP |
+		       MT7668_PHY_HT;
+
+	if (sta && sta->deflink.vht_cap.vht_supported)
+		return MT7668_PHY_OFDM | MT7668_PHY_HT |
+		       MT7668_PHY_VHT;
+
+	return MT7668_PHY_OFDM | MT7668_PHY_HT;
+}
+
+/* where the secondary channel sits */
+enum {
+	MT7668_SCN,
+	MT7668_SCA,
+	MT7668_SCB = 3,
+};
+
+static u8 mt7668_sco(struct cfg80211_chan_def *chandef)
+{
+	int pri40;
+
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_40:
+	case NL80211_CHAN_WIDTH_80:
+	case NL80211_CHAN_WIDTH_80P80:
+	case NL80211_CHAN_WIDTH_160:
+		pri40 = cfg80211_chandef_primary(chandef, NL80211_CHAN_WIDTH_40,
+						 NULL);
+		return pri40 > chandef->chan->center_freq ? MT7668_SCA
+							   : MT7668_SCB;
+	default:
+		return MT7668_SCN;
+	}
+}
+
+static u8 mt7668_vht_bw(struct cfg80211_chan_def *chandef)
+{
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_80:
+		return IEEE80211_VHT_CHANWIDTH_80MHZ;
+	case NL80211_CHAN_WIDTH_80P80:
+		return IEEE80211_VHT_CHANWIDTH_80P80MHZ;
+	case NL80211_CHAN_WIDTH_160:
+		return IEEE80211_VHT_CHANWIDTH_160MHZ;
+	default:
+		return IEEE80211_VHT_CHANWIDTH_USE_HT;
+	}
+}
+
+/* the firmware transmits no wider than the bss it is given */
+static void mt7668_fill_rlm(struct mt7668_bss_rlm *rlm,
+			    struct cfg80211_chan_def *chandef, u8 bss_idx)
+{
+	rlm->bss_idx = bss_idx;
+	rlm->band = mt7668_band(chandef);
+	rlm->pri_ch = chandef->chan->hw_value;
+	rlm->nss = MT7668_NSS;
+	rlm->sco = mt7668_sco(chandef);
+	if (rlm->sco != MT7668_SCN)
+		rlm->ht_op_info1 = rlm->sco | IEEE80211_HT_PARAM_CHAN_WIDTH_ANY;
+
+	rlm->vht_bw = mt7668_vht_bw(chandef);
+	if (rlm->vht_bw != IEEE80211_VHT_CHANWIDTH_USE_HT)
+		rlm->vht_ch_s1 =
+			ieee80211_frequency_to_channel(chandef->center_freq1);
+	if (chandef->center_freq2)
+		rlm->vht_ch_s2 =
+			ieee80211_frequency_to_channel(chandef->center_freq2);
+}
+
+static int mt7668_mcu_send(struct mt7615_dev *dev, int cmd, const void *req,
+			   int len)
+{
+	int ret;
+
+	ret = mt76_mcu_send_msg(&dev->mt76, cmd, req, len, false);
+	if (ret)
+		dev_err(dev->mt76.dev, "ce command %#04x failed: %d\n",
+			cmd & 0xff, ret);
+
+	return ret;
+}
+
+/* the station record removal that takes every station of the bss */
+#define MT7668_DROP_BSS	1
+
+static int mt7668_mcu_drop_bss(struct mt7615_dev *dev, u8 bss_idx)
+{
+	struct {
+		u8 action;
+		u8 sta_idx;
+		u8 bss_idx;
+		u8 __rsv;
+	} __packed req = {
+		.action = MT7668_DROP_BSS,
+		.bss_idx = bss_idx,
+	};
+
+	return mt7668_mcu_send(dev, MCU_CE_CMD(REMOVE_STA_RECORD), &req,
+			       sizeof(req));
+}
+
+struct mt7668_cap_hdr {
+	__le16 n_element;
+	u8 __rsv[2];
+} __packed;
+
+struct mt7668_cap_tlv {
+	__le32 type;
+	__le32 len;
+} __packed;
+
+struct mt7668_tx_resource {
+	__le32 mcu_total;
+	__le32 mcu_unit;
+	__le32 lmac_total;
+	__le32 lmac_unit;
+} __packed;
+
+/* how many frames each port holds; one frame more than the lmac port holds
+ * stalls the sdio write behind it
+ */
+int mt7668_mcu_tx_resource(struct mt7615_dev *dev)
+{
+	struct mt76_sdio *sdio = &dev->mt76.sdio;
+	struct mt7668_tx_resource *res;
+	struct mt7668_cap_hdr *hdr;
+	struct mt7668_cap_tlv *tlv;
+	struct sk_buff *skb;
+	int i, n, ret;
+
+	ret = mt76_mcu_send_and_get_msg(&dev->mt76, MCU_CE_CMD(GET_NIC_CAPAB),
+					NULL, 0, true, &skb);
+	if (ret)
+		return ret;
+
+	if (skb->len < sizeof(struct mt7615_mcu_rxd) + sizeof(*hdr)) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	skb_pull(skb, sizeof(struct mt7615_mcu_rxd));
+	hdr = (void *)skb->data;
+	n = le16_to_cpu(hdr->n_element);
+	skb_pull(skb, sizeof(*hdr));
+
+	for (i = 0; i < n && skb->len >= sizeof(*tlv); i++) {
+		int len;
+
+		tlv = (void *)skb->data;
+		skb_pull(skb, sizeof(*tlv));
+		len = le32_to_cpu(tlv->len);
+		if (skb->len < len)
+			break;
+
+		if (le32_to_cpu(tlv->type) == MT7668_CAP_TX_RESOURCE &&
+		    len >= sizeof(*res)) {
+			res = (void *)skb->data;
+			sdio->pse_mcu_quota_max = le32_to_cpu(res->mcu_total);
+			sdio->sched.pse_data_quota = le32_to_cpu(res->lmac_total);
+		}
+		skb_pull(skb, len);
+	}
+
+out:
+	dev_kfree_skb(skb);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt7668_mcu_tx_resource);
+
+static int mt7668_mcu_abort_pm(struct mt7615_dev *dev, u8 bss_idx)
+{
+	struct {
+		u8 bss_idx;
+		u8 __rsv[3];
+	} __packed req = {
+		.bss_idx = bss_idx,
+	};
+
+	return mt7668_mcu_send(dev, MCU_CE_CMD(SET_BSS_ABORT), &req,
+			       sizeof(req));
+}
+
+int mt7668_mcu_activate(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+			bool enable)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct {
+		u8 bss_idx;
+		u8 active;
+		u8 network_type;	/* 0: the infrastructure network */
+		u8 omac_idx;
+		u8 omac_addr[ETH_ALEN];
+		u8 bmc_wcid;
+		u8 __rsv;
+	} __packed req = {
+		.bss_idx = mvif->mt76.idx,
+		.active = enable,
+		.omac_idx = mvif->mt76.omac_idx,
+	};
+
+	memcpy(req.omac_addr, vif->addr, ETH_ALEN);
+
+	return mt7668_mcu_send(phy->dev, MCU_CE_CMD(BSS_ACTIVATE_CTRL),
+			       &req, sizeof(req));
+}
+
+static int mt7668_mcu_bss(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+			  struct ieee80211_sta *sta, u8 conn_state)
+{
+	struct cfg80211_chan_def *chandef = &phy->mt76->chandef;
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	bool band_2g = chandef->chan->band == NL80211_BAND_2GHZ;
+	struct mt7668_bss_info req = {
+		.bss_idx = mvif->mt76.idx,
+		.conn_state = conn_state,
+		.ssid_len = vif->cfg.ssid_len,
+		.nss = MT7668_NSS,
+		.fixed_rate = cpu_to_le16(mt7668_mac_basic_rate(phy->mt76)),
+	};
+
+	BUILD_BUG_ON(sizeof(req) != 116);
+
+	mt7668_fill_rlm(&req.rlm, chandef, mvif->mt76.idx);
+
+	/* before the join the bss carries neither ssid nor bssid */
+	if (conn_state == MT7668_BSS_DISCONNECTED) {
+		req.ap_sta_idx = MT7668_STA_NONE;
+		req.bmc_wlan_idx = MT7668_WTBL_RESERVED;
+	} else {
+		req.op_rates = cpu_to_le16(band_2g ? MT7668_RATES_2G
+						   : MT7668_RATES_5G);
+		req.basic_rates = cpu_to_le16(band_2g ? MT7668_BASIC_2G
+						      : MT7668_BASIC_5G);
+		req.non_ht_phy_type = band_2g ? ffs(MT7668_PHY_ERP) - 1
+					      : ffs(MT7668_PHY_OFDM) - 1;
+		req.phy_type_set = mt7668_phy_types(chandef, sta);
+		req.qbss = 1;
+		req.rlm.short_slot = 1;
+		memcpy(req.ssid, vif->cfg.ssid, vif->cfg.ssid_len);
+		if (vif->bss_conf.bssid)
+			memcpy(req.bssid, vif->bss_conf.bssid, ETH_ALEN);
+	}
+
+	return mt7668_mcu_send(phy->dev, MCU_CE_CMD(SET_BSS_INFO), &req,
+			       sizeof(req));
+}
+
+static int mt7668_mcu_sta(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+			  struct ieee80211_sta *sta, u8 state)
+{
+	struct cfg80211_chan_def *chandef = &phy->mt76->chandef;
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	bool band_2g = chandef->chan->band == NL80211_BAND_2GHZ;
+	struct mt7615_sta *msta = (struct mt7615_sta *)sta->drv_priv;
+	struct mt7615_dev *dev = phy->dev;
+	struct mt7668_sta_rec req = {
+		.sta_idx = MT7668_STA_IDX,
+		.sta_type = MT7668_STA_LEGACY_AP,
+		.bss_idx = mvif->mt76.idx,
+		.phy_type_set = mt7668_phy_types(chandef, sta),
+		.non_ht_rates = cpu_to_le16(band_2g ? MT7668_RATES_2G
+						    : MT7668_RATES_5G),
+		.basic_rates = cpu_to_le16(band_2g ? MT7668_BASIC_2G
+						   : MT7668_BASIC_5G),
+		.qos = 1,
+		.uapsd = 1,
+		.state = state,
+		.wlan_idx = msta->wcid.idx,
+		/* the part's own reserved entry, which is not the last of the
+		 * table the way mt76 counts it
+		 */
+		.bmc_wlan_idx = MT7668_WTBL_RESERVED,
+		.rts_policy = MT7668_RTS_LEGACY,
+		.fixed_rate = cpu_to_le16(mt7668_mac_basic_rate(phy->mt76)),
+		.tx_ampdu = 1,
+		/* the firmware agrees a receive session itself and reports it,
+		 * and the host reorders
+		 */
+		.rx_ampdu = 1,
+		.tx_ba_size = MT7668_BA_SIZE,
+		.rx_ba_size = MT7668_BA_SIZE,
+		.tx_max_amsdu_len = cpu_to_le32(MT7668_MAX_AMSDU_LEN),
+	};
+
+	BUILD_BUG_ON(sizeof(req) != 136);
+
+	memcpy(req.addr, sta->addr, ETH_ALEN);
+
+	if (state == MT7668_STA_STATE_3) {
+		struct ieee80211_sta_ht_cap *ht = &sta->deflink.ht_cap;
+		struct ieee80211_sta_vht_cap *vht = &sta->deflink.vht_cap;
+		int signal = -ewma_signal_read(&msta->wcid.rssi);
+
+		/* the association id is this station's, not the peer's */
+		req.aid = cpu_to_le16(vif->cfg.aid);
+		req.listen_interval =
+			cpu_to_le16(phy->mt76->hw->conf.listen_interval);
+		/* the firmware starts its rate selection from the peer's
+		 * signal, in 802.11k rcpi
+		 */
+		req.rcpi = clamp((signal + 110) * 2, 0, 220);
+		req.need_resp = 1;
+
+		/* the firmware picks the rates itself, from this record: left
+		 * without the peer's ht capabilities it stays on the floor
+		 */
+		if (ht->ht_supported) {
+			req.ht_cap_info = cpu_to_le16(ht->cap);
+			req.ampdu_param = ht->ampdu_factor |
+					  (ht->ampdu_density <<
+					   IEEE80211_HT_AMPDU_PARM_DENSITY_SHIFT);
+			req.mcs_set = MT7668_MCS_ALL;
+			memcpy(req.rx_mcs_bitmask, ht->mcs.rx_mask,
+			       sizeof(req.rx_mcs_bitmask));
+			req.tx_rate_info = cpu_to_le32(ht->mcs.tx_params);
+		}
+		if (vht->vht_supported) {
+			req.vht_cap_info = cpu_to_le32(vht->cap);
+			req.vht_rx_mcs_map = vht->vht_mcs.rx_mcs_map;
+			req.vht_rx_highest_rate = vht->vht_mcs.rx_highest;
+			req.vht_tx_mcs_map = vht->vht_mcs.tx_mcs_map;
+			req.vht_tx_highest_rate = vht->vht_mcs.tx_highest;
+			req.rx_amsdu_in_ampdu = 1;
+			/* without it the firmware transmits at 20 MHz on one
+			 * stream, whatever the bss says
+			 */
+			req.vht_op_mode = min_t(u8, sta->deflink.bandwidth,
+						IEEE80211_STA_RX_BW_160) |
+					  (sta->deflink.rx_nss - 1) <<
+					  IEEE80211_OPMODE_NOTIF_RX_NSS_SHIFT;
+		}
+	}
+
+	return mt7668_mcu_send(dev, MCU_CE_CMD(UPDATE_STA_RECORD),
+			       &req, sizeof(req));
+}
+
+/* the part's own cipher numbering */
+enum {
+	MT7668_CIPHER_NONE,
+	MT7668_CIPHER_WEP40,
+	MT7668_CIPHER_TKIP,
+	MT7668_CIPHER_TKIP_NO_MIC,
+	MT7668_CIPHER_CCMP,
+	MT7668_CIPHER_WEP104,
+	MT7668_CIPHER_BIP,
+	MT7668_CIPHER_WEP128,
+	MT7668_CIPHER_WPI,
+	MT7668_CIPHER_CCMP_CCX,
+	MT7668_CIPHER_GCMP,
+};
+
+u8 mt7668_mcu_cipher(u32 cipher)
+{
+	switch (cipher) {
+	case WLAN_CIPHER_SUITE_TKIP:
+		return MT7668_CIPHER_TKIP;
+	case WLAN_CIPHER_SUITE_CCMP:
+		return MT7668_CIPHER_CCMP;
+	case WLAN_CIPHER_SUITE_GCMP:
+		return MT7668_CIPHER_GCMP;
+	case WLAN_CIPHER_SUITE_AES_CMAC:
+		return MT7668_CIPHER_BIP;
+	default:
+		return MT7668_CIPHER_NONE;
+	}
+}
+
+int mt7668_mcu_key(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+		   struct ieee80211_sta *sta,
+		   struct ieee80211_key_conf *key)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	bool pairwise = !!(key->flags & IEEE80211_KEY_FLAG_PAIRWISE);
+	struct {
+		u8 add;
+		u8 tx_key;
+		u8 pairwise;
+		u8 authenticator;
+		u8 peer[ETH_ALEN];
+		u8 bss_idx;
+		u8 cipher;
+		u8 key_id;
+		u8 key_len;
+		u8 wlan_idx;
+		u8 mgmt_protection;
+		u8 material[32];
+		u8 rsc[16];
+	} __packed req = {
+		.add = 1,
+		/* a station transmits with its pairwise key, never the group one */
+		.tx_key = pairwise,
+		.pairwise = pairwise,
+		.bss_idx = mvif->mt76.idx,
+		.cipher = mt7668_mcu_cipher(key->cipher),
+		.key_id = key->keyidx,
+		.key_len = key->keylen,
+		/* the broadcast key lives in the entry the part named as the
+		 * bss's own when it was activated, not in the peer's
+		 */
+		.wlan_idx = MT7668_WTBL_BMC,
+	};
+
+	BUILD_BUG_ON(sizeof(req) != 64);
+
+	memcpy(req.material, key->key, key->keylen);
+	if (sta) {
+		struct mt7615_sta *msta = (struct mt7615_sta *)sta->drv_priv;
+
+		memcpy(req.peer, sta->addr, ETH_ALEN);
+		if (pairwise)
+			req.wlan_idx = msta->wcid.idx;
+	} else {
+		memcpy(req.peer, vif->bss_conf.bssid, ETH_ALEN);
+	}
+
+	return mt7668_mcu_send(phy->dev, MCU_CE_CMD(ADD_REMOVE_KEY), &req,
+			       sizeof(req));
+}
+
+/* what the firmware hands up: its receive filter is a firmware setting, not the
+ * MT_WF_RFCR register
+ */
+enum {
+	MT7668_RX_DIRECTED	= BIT(0),
+	MT7668_RX_MULTICAST	= BIT(1),
+	MT7668_RX_ALL_MCAST	= BIT(2),
+	MT7668_RX_BROADCAST	= BIT(3),
+};
+
+static int mt7668_mcu_rx_filter(struct mt7615_dev *dev)
+{
+	struct {
+		__le32 filter;
+		u8 __rsv[64];
+	} __packed req = {
+		.filter = cpu_to_le32(MT7668_RX_DIRECTED |
+				      MT7668_RX_MULTICAST |
+				      MT7668_RX_ALL_MCAST |
+				      MT7668_RX_BROADCAST),
+	};
+
+	BUILD_BUG_ON(sizeof(req) != 68);
+
+	return mt7668_mcu_send(dev, MCU_CE_CMD(SET_RX_FILTER), &req,
+			       sizeof(req));
+}
+
+/* the firmware takes the whole edca table, in its own access class order, and
+ * does not answer the ext command that sets one class at a time
+ */
+int mt7668_mcu_wmm(struct mt7615_phy *phy, struct ieee80211_vif *vif)
+{
+	static const u8 ac_to_mac80211[] = {
+		IEEE80211_AC_BE, IEEE80211_AC_BK,
+		IEEE80211_AC_VI, IEEE80211_AC_VO,
+	};
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct {
+		struct {
+			__le16 cw_min;
+			__le16 cw_max;
+			__le16 txop;
+			__le16 aifsn;
+			u8 guard_time;
+			u8 acm;
+		} __packed ac[IEEE80211_NUM_ACS];
+		u8 bss_idx;
+		u8 qbss;
+		u8 wmm_set;
+		u8 __rsv;
+	} __packed req = {
+		.bss_idx = mvif->mt76.idx,
+		.qbss = 1,
+	};
+	int i;
+
+	BUILD_BUG_ON(sizeof(req) != 44);
+
+	for (i = 0; i < IEEE80211_NUM_ACS; i++) {
+		const struct ieee80211_tx_queue_params *p;
+
+		p = &mvif->tx_q[ac_to_mac80211[i]];
+		req.ac[i].cw_min = cpu_to_le16(p->cw_min);
+		req.ac[i].cw_max = cpu_to_le16(p->cw_max);
+		req.ac[i].txop = cpu_to_le16(p->txop);
+		req.ac[i].aifsn = cpu_to_le16(p->aifs);
+		req.ac[i].acm = p->acm;
+	}
+
+	return mt7668_mcu_send(phy->dev, MCU_CE_CMD(SET_EDCA_PARMS), &req,
+			       sizeof(req));
+}
+
+/* this firmware lacks the ext commands that take an interface down, so the bss
+ * goes down through the ce ones - a firmware still holding it will not power
+ * down when the driver unloads
+ */
+static void mt7668_mcu_leave(struct mt7615_phy *phy,
+			     struct ieee80211_vif *vif)
+{
+	mt7668_mcu_bss(phy, vif, NULL, MT7668_BSS_DISCONNECTED);
+	mt7668_mcu_activate(phy, vif, false);
+}
+
+static int mt7668_mcu_privilege(struct mt7615_phy *phy,
+				struct ieee80211_vif *vif, bool enable)
+{
+	struct cfg80211_chan_def *chandef = &phy->mt76->chandef;
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct mt7615_dev *dev = phy->dev;
+	struct mt7615_roc_tlv req = {
+		.bss_idx = mvif->mt76.idx,
+		.token = MT7668_ROC_TOKEN,
+		.active = !enable,
+		.primary_chan = chandef->chan->hw_value,
+		.sco = mt7668_sco(chandef),
+		.band = mt7668_band(chandef),
+		.width = mt7668_vht_bw(chandef),
+		.freq_seg1 = ieee80211_frequency_to_channel(chandef->center_freq1),
+		.req_type = MT7668_ROC_JOIN,
+		.max_interval = cpu_to_le32(MT7668_JOIN_INTERVAL),
+	};
+	int ret;
+
+	BUILD_BUG_ON(sizeof(req) != 24);
+
+	phy->roc_grant = false;
+
+	ret = mt7668_mcu_send(dev, MCU_CE_CMD(SET_ROC), &req, sizeof(req));
+	if (ret || !enable)
+		return ret;
+
+	/* the part can take seconds to answer */
+	if (!wait_event_timeout(phy->roc_wait, phy->roc_grant,
+				MT7668_JOIN_GRANT_TIMEOUT)) {
+		dev_err(dev->mt76.dev, "no channel granted to join on\n");
+		/* it holds the channel reserved until it is handed back, and
+		 * nothing else - a scan included - can be given one meanwhile
+		 */
+		mt7668_mcu_privilege(phy, vif, false);
+		return -ETIMEDOUT;
+	}
+
+	return 0;
+}
+
+int mt7668_mcu_assoc(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+		     struct ieee80211_sta *sta)
+{
+	int ret;
+
+	ret = mt7668_mcu_bss(phy, vif, sta, MT7668_BSS_CONNECTED);
+	if (ret)
+		return ret;
+
+	ret = mt7668_mcu_sta(phy, vif, sta, MT7668_STA_STATE_3);
+	if (ret)
+		return ret;
+
+	return mt7668_mcu_rx_filter(phy->dev);
+}
+
+static int mt7668_mcu_join(struct mt7615_phy *phy, struct ieee80211_vif *vif,
+			   struct ieee80211_sta *sta, bool enable)
+{
+	struct mt7615_vif *mvif = (struct mt7615_vif *)vif->drv_priv;
+	struct mt7615_dev *dev = phy->dev;
+	int ret;
+
+	if (!enable) {
+		/* with the station still recorded, or the bss still counted
+		 * connected, no later scan reports done
+		 */
+		mt7668_mcu_abort_pm(dev, mvif->mt76.idx);
+		mt7668_mcu_bss(phy, vif, NULL, MT7668_BSS_DISCONNECTED);
+		mt7668_mcu_drop_bss(dev, mvif->mt76.idx);
+		mt7668_mcu_activate(phy, vif, false);
+		return mt7668_mcu_privilege(phy, vif, false);
+	}
+
+	ret = mt7668_mcu_bss(phy, vif, sta, MT7668_BSS_DISCONNECTED);
+	if (ret)
+		return ret;
+
+	ret = mt7668_mcu_drop_bss(dev, mvif->mt76.idx);
+	if (ret)
+		return ret;
+
+	ret = mt7668_mcu_activate(phy, vif, true);
+	if (ret)
+		return ret;
+
+	ret = mt7668_mcu_privilege(phy, vif, true);
+	if (ret)
+		return ret;
+
+	ret = mt7668_mcu_sta(phy, vif, sta, MT7668_STA_STATE_1);
+	if (ret) {
+		dev_err(dev->mt76.dev, "join failed: %d\n", ret);
+		mt7668_mcu_privilege(phy, vif, false);
+	}
+
+	return ret;
+}
+
+/* the firmware answers the peer's ADDBA itself and reports the session, which
+ * the host still has to reorder
+ */
+struct mt7668_rx_addba {
+	u8 sta_idx;
+	u8 token;
+	__le16 param;
+	__le16 timeout;
+	__le16 ssc;
+} __packed;
+
+struct mt7668_rx_delba {
+	u8 sta_idx;
+	u8 tid;
+	u8 __rsv[2];
+} __packed;
+
+struct mt7668_ba_session {
+	u16 tid;
+	bool start;
+};
+
+static void mt7668_mcu_ba_iter(void *priv, u8 *mac, struct ieee80211_vif *vif)
+{
+	struct mt7668_ba_session *ba = priv;
+
+	if (vif->type != NL80211_IFTYPE_STATION || !vif->cfg.assoc)
+		return;
+
+	if (ba->start)
+		ieee80211_start_rx_ba_session_offl(vif, vif->bss_conf.bssid,
+						   ba->tid);
+	else
+		ieee80211_stop_rx_ba_session_offl(vif, vif->bss_conf.bssid,
+						  ba->tid);
+}
+
+void mt7668_mcu_ba_event(struct mt7615_dev *dev, struct sk_buff *skb)
+{
+	struct mt7615_mcu_rxd *rxd = (struct mt7615_mcu_rxd *)skb->data;
+	struct mt7668_ba_session ba = {
+		.start = rxd->eid == MT7668_EVENT_RX_ADDBA,
+	};
+
+	skb_pull(skb, sizeof(*rxd));
+	if (ba.start) {
+		struct mt7668_rx_addba *ev = (struct mt7668_rx_addba *)skb->data;
+
+		if (skb->len < sizeof(*ev))
+			return;
+		ba.tid = u16_get_bits(le16_to_cpu(ev->param),
+				      IEEE80211_ADDBA_PARAM_TID_MASK);
+	} else {
+		struct mt7668_rx_delba *ev = (struct mt7668_rx_delba *)skb->data;
+
+		if (skb->len < sizeof(*ev))
+			return;
+		ba.tid = ev->tid & IEEE80211_QOS_CTL_TID_MASK;
+	}
+
+	ieee80211_iterate_active_interfaces_atomic(mt76_hw(dev),
+						   IEEE80211_IFACE_ITER_NORMAL,
+						   mt7668_mcu_ba_iter, &ba);
+}
+
+/* the firmware keeps block ack, the station table and its power state to
+ * itself; the host only raises and drops the bss
+ */
