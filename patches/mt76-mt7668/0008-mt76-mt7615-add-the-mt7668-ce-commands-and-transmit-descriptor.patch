--- a/mt7615/mac_ce.c	2026-08-09 14:25:30
+++ b/mt7615/mac_ce.c	2026-09-21 12:00:00
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: ISC
+/* Copyright (C) 2026 Artem Butusov <art.sormy@gmail.com> */
+
+/* The transmit descriptor of a part whose firmware owns the MAC: data goes to
+ * the lmac port with an append, the firmware building the 802.11 header of an
+ * ethernet frame; management is a command on the mcu port; rate, aggregation
+ * and status are the firmware's.
+ */
+
+#include <linux/etherdevice.h>
+#include "mt7615.h"
+#include "mac.h"
+
+/* the header the mcu port puts ahead of a frame */
+#define MT7668_PSE_HDR_LEN	4
+/* transmit attempts, the same for every queue */
+#define MT7668_TX_COUNT	30
+/* the lifetime of a frame with an 802.11 header, 2000 ms in units of 32 tu */
+#define MT7668_TX_TIME	61
+/* the spatial extension index the firmware transmits with */
+#define MT7668_SPE_IDX	0x18
+
+int mt7668_mac_txd_append_len(struct mt7615_dev *dev, struct sk_buff *skb)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+
+	/* every data frame goes to the lmac port, which wants the append */
+	if (!dev->fw->owns_mac ||
+	    (!(info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP) &&
+	     !ieee80211_is_data(hdr->frame_control)))
+		return 0;
+
+	return sizeof(struct mt7668_txd_append);
+}
+EXPORT_SYMBOL_GPL(mt7668_mac_txd_append_len);
+
+/* the lowest basic rate of the band as a tx rate code, where mt76's hw_value
+ * keeps the phy type a byte up
+ */
+u16 mt7668_mac_basic_rate(struct mt76_phy *mphy)
+{
+	struct ieee80211_supported_band *sband;
+	u16 rate;
+
+	sband = mphy->hw->wiphy->bands[mphy->chandef.chan->band];
+	rate = sband->bitrates[0].hw_value;
+
+	return FIELD_PREP(MT_TX_RATE_MODE, rate >> 8) |
+	       FIELD_PREP(MT_TX_RATE_IDX, rate & 0xff);
+}
+
+/* the rate of a frame with an 802.11 header: mac80211's if it gave one, else
+ * the band's lowest basic rate, fixed
+ */
+static int mt7668_mac_80211_rate(struct mt7615_dev *dev,
+				 struct mt76_phy *mphy, __le32 *txwi,
+				 struct sk_buff *skb, bool mmpdu)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_tx_rate *rate = &info->control.rates[0];
+	u16 rateval;
+	u8 bw;
+
+	txwi[2] |= cpu_to_le32(MT_TXD2_FIX_RATE);
+
+	if (rate->idx < 0 || !rate->count ||
+	    (info->flags & IEEE80211_TX_CTL_RATE_CTRL_PROBE)) {
+		if (mmpdu)
+			txwi[6] = cpu_to_le32(FIELD_PREP(MT_TXD6_TX_RATE,
+							 mt7668_mac_basic_rate(mphy)));
+		else
+			txwi[2] &= ~cpu_to_le32(MT_TXD2_FIX_RATE);
+		return MT7668_TX_COUNT;
+	}
+
+	rateval = mt7615_mac_tx_rate_val(dev, mphy, rate,
+					 info->flags & IEEE80211_TX_CTL_STBC,
+					 &bw);
+	/* the firmware picks the bandwidth itself */
+	txwi[6] = cpu_to_le32(FIELD_PREP(MT_TXD6_BW, bw) |
+			      FIELD_PREP(MT_TXD6_TX_RATE, rateval));
+	if (rate->flags & IEEE80211_TX_RC_SHORT_GI)
+		txwi[6] |= cpu_to_le32(MT_TXD6_SGI);
+	if (info->flags & IEEE80211_TX_CTL_LDPC)
+		txwi[6] |= cpu_to_le32(MT_TXD6_LDPC);
+	if (!mmpdu &&
+	    !(rate->flags & (IEEE80211_TX_RC_MCS | IEEE80211_TX_RC_VHT_MCS)))
+		txwi[2] |= cpu_to_le32(MT_TXD2_BA_DISABLE);
+
+	return rate->count;
+}
+
+int mt7668_mac_write_txwi(struct mt7615_dev *dev, __le32 *txwi,
+			  struct sk_buff *skb, struct mt76_wcid *wcid,
+			  int pid, struct ieee80211_key_conf *key,
+			  enum mt76_txq_id qid)
+{
+	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
+	struct ieee80211_hdr *hdr = (struct ieee80211_hdr *)skb->data;
+	bool is_8023 = info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP;
+	/* an 802.3 frame starts with its destination */
+	bool multicast = is_multicast_ether_addr(is_8023 ? skb->data :
+						 hdr->addr1);
+	int sz_append = mt7668_mac_txd_append_len(dev, skb);
+	struct ieee80211_vif *vif = info->control.vif;
+	struct mt76_phy *mphy = &dev->mphy;
+	u8 fc_type = 0, fc_stype = 0, omac_idx = 0, wmm_idx = 0, q_idx;
+	u8 port = MT_TX_PORT_IDX_LMAC;
+	int eth_type_ofs = MT7668_PSE_HDR_LEN;
+	int tx_count = MT7668_TX_COUNT;
+	u32 val;
+
+	if (vif) {
+		struct mt76_vif_link *mvif = (struct mt76_vif_link *)vif->drv_priv;
+
+		omac_idx = mvif->omac_idx;
+		wmm_idx = mvif->wmm_idx;
+	}
+
+	if (qid >= MT_TXQ_PSD)
+		q_idx = MT_LMAC_ALTX0;
+	else
+		q_idx = wmm_idx * MT7615_MAX_WMM_SETS +
+			mt7615_lmac_mapping(dev, skb_get_queue_mapping(skb));
+
+	memset(txwi, 0, MT_TXD_SIZE);
+
+	if (is_8023) {
+		eth_type_ofs += ETH_HLEN - ETH_TLEN;
+		val = FIELD_PREP(MT_TXD1_HDR_FORMAT, MT_HDR_FORMAT_802_3) |
+		      FIELD_PREP(MT_TXD1_TID, skb->priority &
+					      IEEE80211_QOS_CTL_TID_MASK) |
+		      FIELD_PREP(MT_TXD1_PKT_FMT, MT_TX_TYPE_CT);
+		if (get_unaligned_be16(skb->data + 2 * ETH_ALEN) >=
+		    ETH_P_802_3_MIN)
+			val |= MT_TXD1_ETH_802_3;
+	} else {
+		__le16 fc = hdr->frame_control;
+		bool mmpdu = !ieee80211_is_data(fc);
+
+		eth_type_ofs += ieee80211_get_hdrlen_from_skb(skb);
+		if (!mmpdu)
+			eth_type_ofs += sizeof(rfc1042_header);
+		fc_type = (le16_to_cpu(fc) & IEEE80211_FCTL_FTYPE) >> 2;
+		fc_stype = (le16_to_cpu(fc) & IEEE80211_FCTL_STYPE) >> 4;
+		val = FIELD_PREP(MT_TXD1_HDR_FORMAT, MT_HDR_FORMAT_802_11) |
+		      FIELD_PREP(MT_TXD1_HDR_INFO,
+				 ieee80211_get_hdrlen_from_skb(skb) / 2) |
+		      FIELD_PREP(MT_TXD1_PKT_FMT,
+				 mmpdu ? MT_TX_TYPE_CMD : MT_TX_TYPE_CT);
+		/* management is a command on the mcu port */
+		if (mmpdu) {
+			port = MT_TX_PORT_IDX_MCU;
+			q_idx = MT_TX_MCU_PORT_RX_Q1;
+		}
+		txwi[2] = cpu_to_le32(FIELD_PREP(MT_TXD2_MAX_TX_TIME,
+						 MT7668_TX_TIME));
+		txwi[3] = cpu_to_le32(MT_TXD3_DURATION_CTRL);
+		tx_count = mt7668_mac_80211_rate(dev, mphy, txwi, skb, mmpdu);
+	}
+
+	/* the ethertype's offset is in words, from the mcu port's header */
+	txwi[0] = cpu_to_le32(FIELD_PREP(MT_TXD0_P_IDX, port) |
+			      FIELD_PREP(MT_TXD0_Q_IDX, q_idx) |
+			      FIELD_PREP(MT_TXD0_TX_BYTES, skb->len +
+					 MT_TXD_SIZE + sz_append) |
+			      FIELD_PREP(MT_TXD0_ETH_TYPE_OFFSET,
+					 eth_type_ofs / 2));
+	txwi[1] = cpu_to_le32(val | MT_TXD1_LONG_FORMAT |
+			      FIELD_PREP(MT_TXD1_WLAN_IDX, wcid->idx) |
+			      FIELD_PREP(MT_TXD1_OWN_MAC, omac_idx));
+	txwi[2] |= cpu_to_le32(FIELD_PREP(MT_TXD2_FRAME_TYPE, fc_type) |
+			       FIELD_PREP(MT_TXD2_SUB_TYPE, fc_stype) |
+			       FIELD_PREP(MT_TXD2_MULTICAST, multicast));
+	if (key)
+		txwi[3] |= cpu_to_le32(MT_TXD3_PROTECT_FRAME);
+	txwi[3] |= cpu_to_le32(FIELD_PREP(MT_TXD3_REM_TX_COUNT, tx_count));
+	if (info->flags & IEEE80211_TX_CTL_NO_ACK)
+		txwi[3] |= cpu_to_le32(MT_TXD3_NO_ACK);
+	if (!is_8023 && (info->flags & IEEE80211_TX_CTL_INJECTED)) {
+		u16 seqno = le16_to_cpu(hdr->seq_ctrl);
+
+		if (ieee80211_is_back_req(hdr->frame_control))
+			seqno = le16_to_cpu(((struct ieee80211_bar *)hdr)->start_seq_num);
+		txwi[3] |= cpu_to_le32(MT_TXD3_SN_VALID |
+				       FIELD_PREP(MT_TXD3_SEQ,
+						  IEEE80211_SEQ_TO_SN(seqno)));
+	}
+
+	val = FIELD_PREP(MT_TXD5_PID, pid);
+	/* a status only for a frame something waits on; one per data frame
+	 * floods the receive path
+	 */
+	if (!is_8023 || pid >= MT_PACKET_ID_FIRST)
+		val |= MT_TXD5_TX_STATUS_HOST;
+	txwi[5] = cpu_to_le32(val);
+
+	txwi[7] = cpu_to_le32(FIELD_PREP(MT_TXD7_SPE_IDX, MT7668_SPE_IDX));
+
+	if (sz_append) {
+		struct mt7668_txd_append *append = (void *)(txwi + MT_TXD_SIZE / 4);
+
+		memset(append, 0, sz_append);
+		append->pkt_flags = cpu_to_le16(MT7668_TXD_APPEND_CT_WITH_TXD);
+		append->bss_idx = omac_idx;
+	}
+
+	return 0;
+}
--- a/mt7615/mac.c	2026-08-09 14:25:30
+++ b/mt7615/mac.c	2026-09-21 12:00:00
@@ -649,7 +649,7 @@
 	return 0;
 }
 
-static u16
+u16
 mt7615_mac_tx_rate_val(struct mt7615_dev *dev,
 		       struct mt76_phy *mphy,
 		       const struct ieee80211_tx_rate *rate,
--- a/mt7615/mac.h	2026-08-09 14:25:30
+++ b/mt7615/mac.h	2026-09-21 12:00:00
@@ -169,6 +169,11 @@
 #define MT_TXD1_TXD_LEN			BIT(16)
 #define MT_TXD1_LONG_FORMAT		BIT(15)
 #define MT_TXD1_HDR_FORMAT		GENMASK(14, 13)
+/* an ethernet II frame; the top bit of MT_TXD1_HDR_INFO, which a frame that is
+ * not 802.11 does not use for a header length
+ */
+#define MT_TXD1_ETH_802_3		BIT(12)
+
 #define MT_TXD1_HDR_INFO		GENMASK(12, 8)
 #define MT_TXD1_WLAN_IDX		GENMASK(7, 0)
 
@@ -194,6 +199,7 @@
 #define MT_TXD3_SEQ			GENMASK(27, 16)
 #define MT_TXD3_REM_TX_COUNT		GENMASK(15, 11)
 #define MT_TXD3_TX_COUNT		GENMASK(10, 6)
+#define MT_TXD3_DURATION_CTRL		BIT(4)
 #define MT_TXD3_PROTECT_FRAME		BIT(1)
 #define MT_TXD3_NO_ACK			BIT(0)
 
@@ -322,4 +328,19 @@
 	return MT_WTBL_BASE(dev) + wcid * MT_WTBL_ENTRY_SIZE;
 }
 
+/* what an MT7668 data frame carries between its descriptor and the frame; the
+ * firmware reads the bss index from here
+ */
+struct mt7668_txd_append {
+	__le16 pkt_flags;
+	__le16 msdu_token;
+	u8 bss_idx;
+	u8 reserved[2];
+	u8 buf_num;
+	__le32 buf_ptr[6];
+	__le16 buf_len[6];
+} __packed;
+
+#define MT7668_TXD_APPEND_CT_WITH_TXD	BIT(0)
+
 #endif
