From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Artem Butusov <art.sormy@gmail.com>
Date: Mon, 12 Oct 2026 07:00:00 -0400
Subject: [PATCH] media: meson: vdec: helpers to reboot a microcode and end a drain

Two helpers for the legacy codecs that follow.

amvdec_reboot_firmware(): some microcodes latch their canvases when they
boot, and the core boots them at OUTPUT STREAMON, before any CAPTURE
buffer exists. Such a codec raises a source change at start, maps the
canvases on resume, and boots the microcode again with this.

amvdec_drain_empty_last(): input buffers that carried no picture, such
as a stream header, keep the queued count above the LAST threshold on
decoder STOP; this ends the drain with an empty LAST buffer.

Signed-off-by: Artem Butusov <art.sormy@gmail.com>
---
 vdec/vdec_helpers.c |   28 ++++++++++++++++++++++++++++
 vdec/vdec_helpers.h |    2 ++
 2 files changed, 30 insertions(+)

diff -ruN a/vdec/vdec_helpers.c b/vdec/vdec_helpers.c
--- a/vdec/vdec_helpers.c
+++ b/vdec/vdec_helpers.c
@@ -9,6 +9,7 @@
 #include <media/v4l2-event.h>
 #include <media/videobuf2-dma-contig.h>
 
+#include "esparser.h"
 #include "vdec_helpers.h"
 
 #define NUM_CANVAS_NV12 2
@@ -325,6 +326,22 @@
 }
 EXPORT_SYMBOL_GPL(amvdec_set_canvases);
 
+/*
+ * For firmwares that latch their canvases at boot: the core boots them
+ * before the CAPTURE buffers exist, so boot again once they are mapped.
+ */
+int amvdec_reboot_firmware(struct amvdec_session *sess)
+{
+	int ret;
+
+	ret = sess->fmt_out->vdec_ops->resume(sess, false);
+	if (ret)
+		return ret;
+
+	return esparser_power_up(sess);
+}
+EXPORT_SYMBOL_GPL(amvdec_reboot_firmware);
+
 void amvdec_free_canvases(struct amvdec_session *sess)
 {
 	unsigned int i;
@@ -555,6 +572,17 @@
 }
 EXPORT_SYMBOL_GPL(amvdec_dst_buf_done_empty_last);
 
+/*
+ * Decoder STOP: input buffers that carried no picture (stream headers) keep
+ * the queued count above the LAST threshold; end with an empty LAST.
+ */
+void amvdec_drain_empty_last(struct amvdec_session *sess)
+{
+	if (sess->eos_drain && !v4l2_m2m_has_stopped(sess->m2m_ctx))
+		amvdec_dst_buf_done_empty_last(sess);
+}
+EXPORT_SYMBOL_GPL(amvdec_drain_empty_last);
+
 void amvdec_dst_buf_done(struct amvdec_session *sess,
 			 struct vb2_v4l2_buffer *vbuf, u32 field, u32 type)
 {
diff -ruN a/vdec/vdec_helpers.h b/vdec/vdec_helpers.h
--- a/vdec/vdec_helpers.h
+++ b/vdec/vdec_helpers.h
@@ -18,6 +18,7 @@
  */
 int amvdec_set_canvases(struct amvdec_session *sess,
 			u32 reg_base[], u32 reg_num[]);
+int amvdec_reboot_firmware(struct amvdec_session *sess);
 void amvdec_free_canvases(struct amvdec_session *sess);
 void amvdec_restore_canvases(struct amvdec_session *sess);
 
@@ -57,6 +58,7 @@
 				 u32 type,
 				 const struct amvdec_timestamp_info *timestamp);
 bool amvdec_dst_buf_done_empty_last(struct amvdec_session *sess);
+void amvdec_drain_empty_last(struct amvdec_session *sess);
 void amvdec_dst_buf_done_offset(struct amvdec_session *sess,
 				struct vb2_v4l2_buffer *vbuf,
 				u32 offset, u32 field, u32 type, bool allow_drop);
