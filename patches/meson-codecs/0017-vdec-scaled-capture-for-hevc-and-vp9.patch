diff -ruN a/vdec/codec_hevc_common.h b/vdec/codec_hevc_common.h
--- a/vdec/codec_hevc_common.h
+++ b/vdec/codec_hevc_common.h
@@ -36,24 +36,38 @@
 	u32 ref_buffer_count;
 };
 
-/* Returns 1 if we must use framebuffer compression */
-static inline int codec_hevc_use_fbc(u32 pixfmt, int is_10bit)
+/* Returns 1 if references are compressed: 10-bit, or a downscaled CAPTURE */
+static inline int codec_hevc_use_fbc(struct amvdec_session *sess, int is_10bit)
 {
-	/* TOFIX: Handle Amlogic Compressed buffer for 8bit also */
-	return is_10bit;
+	return is_10bit || sess->dw_ratio > 1;
 }
 
-/* Returns 1 if we are decoding 10-bit but outputting 8-bit NV12 */
-static inline int codec_hevc_use_downsample(u32 pixfmt, int is_10bit)
+/* Returns 1 if CAPTURE gets the decoder's second, uncompressed write */
+static inline int codec_hevc_use_downsample(struct amvdec_session *sess,
+					    int is_10bit)
 {
-	return is_10bit;
+	return codec_hevc_use_fbc(sess, is_10bit);
 }
 
 /* Returns 1 if we are decoding using the IOMMU */
-static inline int codec_hevc_use_mmu(u32 revision, u32 pixfmt, int is_10bit)
+static inline int codec_hevc_use_mmu(u32 revision, struct amvdec_session *sess,
+				     int is_10bit)
 {
 	return revision >= VDEC_REVISION_G12A &&
-	       codec_hevc_use_fbc(pixfmt, is_10bit);
+	       codec_hevc_use_fbc(sess, is_10bit);
+}
+
+/* HEVC_SAO_CTRL5[23:16], the double write's scaler: h0, h1, v0, v1 */
+static inline u32 codec_hevc_dw_scale(u32 dw_ratio)
+{
+	switch (dw_ratio) {
+	case 2:
+		return 0x33 << 16;
+	case 4:
+		return 0xff << 16;
+	default:
+		return 0;
+	}
 }
 
 /* Configure decode head read mode */
