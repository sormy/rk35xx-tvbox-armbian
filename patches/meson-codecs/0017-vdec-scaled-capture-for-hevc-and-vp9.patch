+/*
+ * The CAPTURE ratio for a picture: the smallest of 1, 2 and 4 that fits it
+ * in a COMPOSE selection's rectangle, else in capture_max_height.
+ */
+u32 amvdec_dw_ratio(struct amvdec_session *sess, u32 width, u32 height)
+{
+	u32 max_width = sess->dw_request_width ?: UINT_MAX;
+	u32 max_height = sess->dw_request_height ?: amvdec_capture_max_height;
+	u32 ratio = 1;
+
+	if (!sess->fmt_out->codec_ops->downscale || !max_height)
+		return 1;
+	while (ratio < VDEC_MAX_DW_RATIO &&
+	       (width / ratio > max_width || height / ratio > max_height))
+		ratio *= 2;
+	return ratio;
+}
+EXPORT_SYMBOL_GPL(amvdec_dw_ratio);
