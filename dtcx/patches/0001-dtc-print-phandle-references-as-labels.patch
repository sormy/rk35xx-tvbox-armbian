+/*
+ * Reconstruct &label references when reading a blob.
+ *
+ * dtc emits "&label" for a cell only when the property carries a REF_PHANDLE
+ * marker at that offset. The parser creates those markers; the blob reader
+ * cannot, because nothing in a DTB says which cells are phandles. The
+ * information is still present though: #<specifier>-cells on the target node
+ * gives the group width, and __symbols__ gives the label names. This walks the
+ * well-known phandle-bearing properties and adds the missing markers, so
+ * -I dtb -O dts prints references instead of raw numbers.
+ *
+ * Properties are only marked when the walk consumes the value exactly; any
+ * mismatch leaves the property untouched and numeric.
+ */
+struct phandle_prop {
+	const char *name;
+	const char *cells_prop;		/* NULL: bare phandle, no specifier */
+};
+
+static const struct phandle_prop phandle_props[] = {
+	{ "clocks",			"#clock-cells" },
+	{ "assigned-clocks",		"#clock-cells" },
+	{ "assigned-clock-parents",	"#clock-cells" },
+	{ "interrupts-extended",	"#interrupt-cells" },
+	{ "resets",			"#reset-cells" },
+	{ "dmas",			"#dma-cells" },
+	{ "phys",			"#phy-cells" },
+	{ "pwms",			"#pwm-cells" },
+	{ "iommus",			"#iommu-cells" },
+	{ "power-domains",		"#power-domain-cells" },
+	{ "mboxes",			"#mbox-cells" },
+	{ "sound-dai",			"#sound-dai-cells" },
+	{ "thermal-sensors",		"#thermal-sensor-cells" },
+	{ "cooling-device",		"#cooling-cells" },
+	{ "hwlocks",			"#hwlock-cells" },
+	{ "gpios",			"#gpio-cells" },
+	{ "interrupt-parent",		NULL },
+	{ "memory-region",		NULL },
+	{ "mmc-pwrseq",			NULL },
+	{ "operating-points-v2",	NULL },
+	{ "next-level-cache",		NULL },
+	{ "phy-handle",			NULL },
+	{ "remote-endpoint",		NULL },
+	{ "nvmem-cells",		NULL },
+	{ "cpu",			NULL },
+	{ NULL,				NULL },
+};
+
+static bool phandle_prop_lookup(const char *name, const char **cells_prop)
+{
+	const struct phandle_prop *pp;
+	size_t len = strlen(name);
+
+	for (pp = phandle_props; pp->name; pp++)
+		if (streq(name, pp->name)) {
+			*cells_prop = pp->cells_prop;
+			return true;
+		}
+
+	if (len > 7 && streq(name + len - 7, "-supply")) {
+		*cells_prop = NULL;
+		return true;
+	}
+	/* vendor trees use both "reset-gpios" and "reset_gpios" spellings */
+	if (len > 6 && streq(name + len - 5, "gpios") &&
+	    (name[len - 6] == '-' || name[len - 6] == '_')) {
+		*cells_prop = "#gpio-cells";
+		return true;
+	}
+	if (len > 5 && streq(name + len - 4, "gpio") &&
+	    (name[len - 5] == '-' || name[len - 5] == '_')) {
+		*cells_prop = "#gpio-cells";
+		return true;
+	}
+	if (len > 8 && !strncmp(name, "pinctrl-", 8) &&
+	    name[8] >= '0' && name[8] <= '9') {
+		*cells_prop = NULL;
+		return true;
+	}
+
+	return false;
+}
+
+/*
+ * A node may carry several labels, and their order depends on how __symbols__
+ * was written. Pick the lexicographically smallest so the emitted reference is
+ * the same no matter what order they arrive in - otherwise two dumps of the
+ * same hardware disagree on the name and diff noisily.
+ */
+static const char *phandle_ref_name(struct node *n)
+{
+	const char *best = NULL;
+	struct label *l;
+
+	for_each_label(n->labels, l)
+		if (!best || strcmp(l->label, best) < 0)
+			best = l->label;
+
+	return best ? best : n->fullpath;
+}
+
+static bool phandle_refs_walk(struct dt_info *dti, struct property *prop,
+			      const char *cells_prop, bool apply)
+{
+	unsigned int off = 0;
+
+	if (prop->val.len == 0 || prop->val.len % 4)
+		return false;
+
+	while (off < (unsigned int)prop->val.len) {
+		struct node *target;
+		struct property *cp;
+		unsigned int ncells = 0;
+		cell_t ph = propval_cell_n(prop, off / 4);
+
+		if (ph == 0 || ph == (cell_t)-1)
+			return false;
+
+		target = get_node_by_phandle(dti->dt, ph);
+		if (!target)
+			return false;
+
+		if (cells_prop) {
+			cp = get_property(target, cells_prop);
+			if (!cp || cp->val.len != 4)
+				return false;
+			ncells = propval_cell(cp);
+		}
+
+		if (off + 4 + ncells * 4 > (unsigned int)prop->val.len)
+			return false;
+
+		if (apply) {
+			/*
+			 * Claim the whole value as one uint32 group before the
+			 * first reference. add_type_markers() inserts a 4-byte
+			 * TYPE_UINT32 per REF_PHANDLE otherwise, which splits
+			 * "clocks = <&cru 1>" into "<&cru>, <1>"; it bails out
+			 * when the property is already type-marked.
+			 */
+			if (off == 0)
+				property_add_marker(prop, TYPE_UINT32, 0, NULL);
+
+			property_add_marker(prop, REF_PHANDLE, off,
+					    xstrdup(phandle_ref_name(target)));
+		}
+
+		off += 4 + ncells * 4;
+	}
+
+	return true;
+}
+
+static void generate_phandle_refs_node(struct dt_info *dti, struct node *node)
+{
+	struct property *prop;
+	struct node *child;
+
+	/* __symbols__, __fixups__, __local_fixups__ hold paths, not phandles */
+	if (node->name && node->name[0] == '_' && node->name[1] == '_')
+		return;
+
+	for_each_property(node, prop) {
+		const char *cells_prop;
+
+		if (streq(prop->name, "phandle") ||
+		    streq(prop->name, "linux,phandle"))
+			continue;
+		if (prop->val.markers)
+			continue;
+		if (!phandle_prop_lookup(prop->name, &cells_prop))
+			continue;
+		if (!phandle_refs_walk(dti, prop, cells_prop, false))
+			continue;
+
+		phandle_refs_walk(dti, prop, cells_prop, true);
+	}
+
+	for_each_child(node, child)
+		generate_phandle_refs_node(dti, child);
+}
+
+void generate_phandle_refs(struct dt_info *dti)
+{
+	generate_phandle_refs_node(dti, dti->dt);
+}
+
 void generate_labels_from_tree(struct dt_info *dti, const char *name)
 {
 	struct node *an;
