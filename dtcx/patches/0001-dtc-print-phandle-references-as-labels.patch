+	{ "rockchip,codec",		NULL },
+	{ "rockchip,taskqueue-node",	NULL },
+	{ "rockchip,resetgroup-node",	NULL },
 	{ "memory-region",		NULL },
 	{ "mmc-pwrseq",			NULL },
 	{ "operating-points-v2",	NULL },
@@ -1211,6 +1227,11 @@ static bool phandle_prop_lookup(const char *name, const char **cells_prop)
 			return true;
 		}
 
+	/* fixed layout, no #*-cells to consult: <&pinctrl gpio-off pin-off count> */
+	if (streq(name, "gpio-ranges")) {
+		*cells_prop = "";
+		return true;
+	}
 	if (len > 7 && streq(name + len - 7, "-supply")) {
 		*cells_prop = NULL;
 		return true;
@@ -1274,7 +1295,9 @@ static bool phandle_refs_walk(struct dt_info *dti, struct property *prop,
 		if (!target)
 			return false;
 
-		if (cells_prop) {
+		if (cells_prop && !cells_prop[0]) {
+			ncells = 3;			/* gpio-ranges */
+		} else if (cells_prop) {
 			cp = get_property(target, cells_prop);
 			if (!cp || cp->val.len != 4)
 				return false;
diff --git a/livetree.c b/livetree.c
index 75f0bd9..cd646d0 100644
--- a/livetree.c
+++ b/livetree.c
@@ -1202,6 +1202,11 @@ static const struct phandle_prop phandle_props[] = {
 	{ "rockchip,usbgrf",		NULL },
 	{ "rockchip,sram",		NULL },
 	{ "rockchip,cpu",		NULL },
+	{ "rockchip,srv",		NULL },
+	{ "connect",			NULL },
+	{ "ports",			NULL },
+	{ "pm_qos",			NULL },
+	{ "gpio",			"#gpio-cells" },
