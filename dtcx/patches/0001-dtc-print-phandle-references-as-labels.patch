 }
 
+/*
+ * rockchip,pins is <bank pin func &pcfg>: a fixed four-cell group whose phandle sits last, so the
+ * generic walk (phandle first, width from #*-cells) cannot express it.
+ */
+static bool phandle_refs_pins(struct dt_info *dti, struct property *prop, bool apply)
+{
+	unsigned int off;
+
+	if (prop->val.len == 0 || prop->val.len % 16)
+		return false;
+
+	for (off = 0; off < (unsigned int)prop->val.len; off += 16) {
+		struct node *target;
+		cell_t ph = propval_cell_n(prop, off / 4 + 3);
+
+		if (ph == 0 || ph == (cell_t)-1)
+			return false;
+
+		target = get_node_by_phandle(dti->dt, ph);
+		if (!target)
+			return false;
+
+		if (apply) {
+			if (off == 0)
+				property_add_marker(prop, TYPE_UINT32, 0, NULL);
+
+			property_add_marker(prop, REF_PHANDLE, off + 12,
+					    xstrdup(phandle_ref_name(target)));
+		}
+	}
+
+	return true;
+}
+
 static void generate_phandle_refs_node(struct dt_info *dti, struct node *node)
 {
 	struct property *prop;
@@ -1345,6 +1384,11 @@ static void generate_phandle_refs_node(struct dt_info *dti, struct node *node)
 			continue;
 		if (prop->val.markers)
 			continue;
+		if (streq(prop->name, "rockchip,pins")) {
+			if (phandle_refs_pins(dti, prop, false))
+				phandle_refs_pins(dti, prop, true);
+			continue;
+		}
 		if (!phandle_prop_lookup(prop->name, &cells_prop))
 			continue;
 		if (!phandle_refs_walk(dti, prop, cells_prop, false))
