#!/bin/sh
# Family first boot: board prep, hold the u-boot package (its postinst flashes ROCK-2F loaders =
# soft-brick), then build every staged DKMS source offline (the image ships kernel headers).
set -e

# first: the board may have to remove a DKMS package that conflicts with an in-tree driver, and the
# loop below would otherwise build it
if [ -x /usr/local/sbin/rk35xx-firstboot-board ]; then
  /usr/local/sbin/rk35xx-firstboot-board
fi

ub=$(dpkg-query -W -f='${Package}\n' 'linux-u-boot-*' 2>/dev/null | head -1)
[ -n "$ub" ] && apt-mark hold "$ub" >/dev/null 2>&1 || true

for conf in /usr/src/*/dkms.conf; do
  [ -f "$conf" ] || continue
  name=$(sed -n 's/^PACKAGE_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf")
  ver=$(sed -n 's/^PACKAGE_VERSION="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf")
  [ -n "$name" ] && [ -n "$ver" ] || continue
  dkms status "$name/$ver" 2>/dev/null | grep -q installed && continue
  # the kernel may already provide this driver, as a module or built in; either way ours cannot
  # take over the device, and dkms cannot override an unversioned module
  mod=$(sed -n 's/^BUILT_MODULE_NAME\[0\]="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf")
  if [ -n "$mod" ] && { find "/lib/modules/$(uname -r)/kernel" -name "$mod.ko*" 2>/dev/null | grep -q . \
       || grep -q "/$mod\.ko" "/lib/modules/$(uname -r)/modules.builtin" 2>/dev/null; }; then
    echo "$name: kernel provides $mod, skipping" >&2
    continue
  fi
  dkms remove "$name/$ver" --all >/dev/null 2>&1 || true
  dkms add "$name/$ver" 2>/dev/null || true
  # one bad package must not take the rest of first boot with it
  dkms build "$name/$ver" || { echo "$name: build failed, skipping" >&2; continue; }
  dkms install "$name/$ver" || echo "$name: install failed, skipping" >&2
done
depmod -a
systemctl restart systemd-modules-load 2>/dev/null || true

# interfaces whose driver was just built did not exist when mac-pin ran at boot. Call the script,
# not the unit: a blocking systemctl job from inside first boot can stall on ordering.
[ -x /usr/local/sbin/rk35xx-mac-pin ] && /usr/local/sbin/rk35xx-mac-pin || true
