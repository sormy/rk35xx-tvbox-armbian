#!/bin/sh
# Kernel postinst.d and header_postinst.d hook, 01- prefixed so it runs before dkms in both: a kernel
# of another series than the running one gets DKMS sources from its own version, or mt76 fails.
version="$1"
[ -n "$version" ] || exit 0
series() { echo "$1" | cut -d. -f1,2; }
[ "$(series "$version")" = "$(series "$(uname -r)")" ] && exit 0
me="$(basename "$0" | sed 's/^01-//')"
share="/usr/local/share/${me%-kernel-dkms-src}"
repo="$share/repo"
conf="$repo/firmware/$(cat "$share/board-id" 2>/dev/null)/board.conf"
[ -f "$conf" ] || { echo "$me: no repo at $repo; run ${me%-kernel-dkms-src}-update --kernel $version"; exit 0; }
for e in $(. "$conf"; echo $BOARD_DKMS_FETCH); do
  echo "$me: fetching ${e%%:*} for $version"
  "$repo/firmware/${e#*:}" "/usr/src/${e%%:*}" "${version%%-*}" || echo "$me: ${e%%:*}: fetch failed"
done
exit 0
