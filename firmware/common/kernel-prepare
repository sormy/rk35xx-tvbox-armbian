#!/bin/sh
# Kernel postinst.d hook, 00- prefixed so it sorts before the dkms hook: build the kernel-headers
# host tools first, or DKMS dies on a combined linux-image + linux-headers upgrade.
# Not modules_prepare -- that pulls in archprepare, which fails on Armbian stripped headers.
version="$1"
src="/usr/src/linux-headers-$version"
[ -n "$version" ] && [ -f "$src/Makefile" ] && [ -f "$src/.config" ] || exit 0
[ -x "$src/scripts/basic/fixdep" ] && [ -x "$src/scripts/mod/modpost" ] && exit 0
# self-naming: the hook installs under the board's own prefix (00-r69-… / 00-rk35xx-…), so the log
# follows it and deployed R69 boxes keep writing the path they always have
me="$(basename "$0" | sed 's/^00-//')"
echo "$me: pre-building kernel-headers tools for $version so DKMS can build"
ncpu=$(nproc 2>/dev/null || echo 1)
log=/var/log/$me.log
{
  echo "=== $me $version ==="
  make -C "$src" ARCH=arm64 olddefconfig
  make -C "$src" ARCH=arm64 -j"$ncpu" scripts
  make -C "$src" ARCH=arm64 -j"$ncpu" M=scripts/mod
} >>"$log" 2>&1 || true
exit 0
