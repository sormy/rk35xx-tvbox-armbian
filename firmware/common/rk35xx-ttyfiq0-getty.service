# Neutralises the base image's getty on ttyFIQ0. The ROCK 2F's console is the vendor fiq-debugger
# (ttyFIQ0); we disable that node so ff9f0000 can be a standard ttyS0, so the device never appears
# and the inherited getty makes systemd wait out the full 90 s device timeout on every boot.
#
# A unit file in /etc outranks the template instance that getty.target.wants points at, and the
# condition turns it into an instant no-op. Serial login is unaffected: systemd's getty generator
# spawns serial-getty@ttyS0 from console=ttyS0 on the kernel command line.
# Installed as /etc/systemd/system/serial-getty@ttyFIQ0.service.
[Unit]
Description=Getty on ttyFIQ0 (disabled: no such device on this board)
ConditionPathExists=/dev/ttyFIQ0

[Service]
Type=oneshot
ExecStart=/bin/true
