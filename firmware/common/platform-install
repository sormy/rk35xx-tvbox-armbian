# write_uboot_platform override: the stock version writes ROCK-2F loaders and soft-bricks the box.
# armbian-install sources this and then calls write_uboot_platform "$DIR" "$device", so DIR is read
# by the caller, not here - it is what points $1 at our loader pair instead of the ROCK 2F package.
DIR=/usr/local/share/rk35xx

write_uboot_platform() {
	local i=0
	# the BootROM scans five idbloader slots 1024 sectors apart; every copy in a blob is identical
	while [ "$i" -lt 5 ]; do
		dd if="$1/factory_idbloader.bin" of="$2" bs=512 seek=$((64 + i * 1024)) count=1024 \
			conv=notrunc status=none
		i=$((i + 1))
	done
	# both uboot slots get the same FIT, each cleared first so no tail of the factory one survives
	i=0
	while [ "$i" -lt 2 ]; do
		dd if=/dev/zero      of="$2" bs=512 seek=$((16384 + i * 4096)) count=4096 conv=notrunc status=none
		dd if="$1/uboot.itb" of="$2" bs=512 seek=$((16384 + i * 4096)) count=4096 conv=notrunc status=none
		i=$((i + 1))
	done
	sync
}

# stock Armbian's, verbatim: the installer calls this and then writes to the DEVICE it sets
setup_write_uboot_platform() {
	if grep -q "ubootpart" /proc/cmdline; then
		local tmp part dev
		tmp=$(cat /proc/cmdline)
		tmp="${tmp##*ubootpart=}"
		tmp="${tmp%% *}"
		[ -n "$tmp" ] && part=$(findfs PARTUUID=$tmp 2> /dev/null)
		[ -n "$part" ] && dev=$(lsblk -n -o PKNAME "$part" 2> /dev/null)
		[ -n "$dev" ] && DEVICE="/dev/$dev"
	fi
}
