[Unit]
Description=Pin per-unit MACs (factory address from vendor storage, else derived)
After=systemd-modules-load.service
Before=network-pre.target wpa_supplicant.service
Wants=network-pre.target
ConditionPathExists=/usr/local/share/rk35xx/mac-oui

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rk35xx-mac-pin
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
