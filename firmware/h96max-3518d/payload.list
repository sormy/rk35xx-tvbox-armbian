# H96 Max 3518D firmware payload — files copied verbatim into the rootfs (mode src dest, src under firmware/).
# Mechanism scripts are family-level (rk35xx-*, firmware/common/); this list is mostly board data.
# DKMS *sources* are fetched by board.conf's board_stage_dkms, built by rk35xx-firstboot.

# family first boot (enabled via a multi-user.target drop-in at image build)
0755 common/firstboot                                   /usr/local/sbin/rk35xx-firstboot
0644 common/firstboot.service                           /etc/systemd/system/rk35xx-firstboot.service

# Seekwave Wi-Fi/BT: module autoload + firmware, all shared (see common/seekwave-fw/README.md)
0644 common/seekwave-modules.conf                       /etc/modules-load.d/seekwave.conf
0644 common/seekwave-fw/SWT6621S_DRAM_SDIO.bin          /lib/firmware/SWT6621S_DRAM_SDIO.bin
0644 common/seekwave-fw/SWT6621S_IRAM_SDIO.bin          /lib/firmware/SWT6621S_IRAM_SDIO.bin
0644 common/seekwave-fw/SWT6621S_NV_SDIO_SHARED_TDD.bin /lib/firmware/SWT6621S_NV_SDIO.bin
0644 common/seekwave-fw/SWT6621S_SEEKWAVE_R00001.bin    /lib/firmware/SWT6621S_SEEKWAVE_R00001.bin
0644 common/seekwave-fw/sv6160lite.nvbin                /lib/firmware/sv6160lite.nvbin
0644 common/skwbt-options.conf                          /etc/modprobe.d/zz-rk35xx-skwbt.conf

# DKMS build files (sources fetched at image build; rk35xx-firstboot builds whatever is staged)

# per-boot MAC pin: label address from vendor storage, else derived from the SoC serial
0755 common/vendor-storage                              /usr/local/sbin/rk35xx-vendor-storage
0755 common/mac-pin                                     /usr/local/sbin/rk35xx-mac-pin
0644 common/mac-pin.service                             /etc/systemd/system/rk35xx-mac-pin.service
0644 h96max-3518d/mac-oui                               /usr/local/share/rk35xx/mac-oui


# standby-LED hooks + power-button behaviour
0755 common/led-shutdown                                /usr/lib/systemd/system-shutdown/rk35xx-led
0755 common/led-sleep                                   /usr/lib/systemd/system-sleep/rk35xx-led
0644 common/suspend.conf                                /etc/systemd/sleep.conf.d/zz-rk35xx-suspend.conf
0644 h96max-3518d/powerkey.conf                         /etc/systemd/logind.conf.d/zz-rk35xx-powerkey.conf

# login-banner board name (reads /usr/local/share/rk35xx/board-name)
0755 common/boardname                                   /usr/local/sbin/rk35xx-boardname
0644 common/boardname.apt                               /etc/apt/apt.conf.d/99-rk35xx-boardname
0644 h96max-3518d/board-name                            /usr/local/share/rk35xx/board-name
# board key (= firmware/<board>/), so rk35xx-update knows which payload to install
0644 h96max-3518d/board-id                              /usr/local/share/rk35xx/board-id

# DTB master copy + kernel postinst.d hooks
0644 h96max-3518d/board.dtb                             /usr/local/share/rk35xx/board.dtb
0755 common/dtb-persist                                 /etc/kernel/postinst.d/rk35xx-dtb-persist
0755 common/kernel-prepare                              /etc/kernel/postinst.d/00-rk35xx-kernel-prepare

# board loader pair + write_uboot_platform override (armbian-install soft-brick guard)
0644 h96max-3518d/factory_idbloader.bin                 /usr/local/share/rk35xx/factory_idbloader.bin
0644 h96max-3518d/uboot.itb                             /usr/local/share/rk35xx/uboot.itb
0644 common/platform-install                            /usr/lib/u-boot/platform_install.sh

# hardware watchdog: systemd pings it, the SoC resets the box if it stops (node enabled in board.dtb)
0644 common/watchdog.conf                               /etc/systemd/system.conf.d/zz-rk35xx-watchdog.conf

# hardware video codec: open the MPP/RGA/dma-heap nodes to group video (see docs/codec.md)
0644 common/vpu.rules                                   /etc/udev/rules.d/99-rk35xx-vpu.rules

# stable names for the integrated inputs, and clear the Android-style BT rfkill soft block
0644 common/input-names.rules                           /etc/udev/rules.d/60-rk35xx-input-names.rules
0644 common/rfkill-bt.rules                             /etc/udev/rules.d/60-rk35xx-rfkill-bt.rules
0644 common/bt-remote.hwdb                              /etc/udev/hwdb.d/60-rk35xx-bt-remote.hwdb

# in-place updater, so `rk35xx-update --pull` works on the box without a checkout
0755 ../rk35xx-update                                   /usr/local/sbin/rk35xx-update
