	/* The mmc core needs a supply to know what it may drive the bus at. The vendor tree
	   states it as ocr_avail in a sub-node only its own driver reads, so without this
	   mainline reports "no support for card's volts" and no card initialises. */
	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};


	wifi32k: wifi32k {
		compatible = "pwm-clock";
		#clock-cells = <0x00>;
		clock-frequency = <32768>;
		pwms = <&pwm_ef 0 30518 0>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* GPIOX_6 is the combo chip's power-on and GPIOX_17 its Bluetooth enable - the
		   vendor wifi and bt-dev nodes' power_on_pin and gpio_en. Read as resets: active
		   low, so the sequencer drives both high to bring the chip up, and drops them on
		   power-off, which is the only way to get the part out of a wedged state. */
		reset-gpios = <&gpio 85 1>, <&gpio 96 1>;
		clocks = <&wifi32k>;
		clock-names = "ext_clock";
		post-power-on-delay-ms = <100>;
	};

	wifi {
		compatible = "amlogic, aml_wifi";
		dev_name = "aml_wifi";
		status = "okay";
		interrupt_pin = <0x14 0x64 0x00>;
		interrupts = <0x00 0x44 0x04>;
		irq_trigger_type = "GPIO_IRQ_HIGH";
		power_on_pin = <0x14 0x58 0x00>;
		dhd_static_buf;
		pinctrl-names = "wifi_32k_pins";
		pinctrl-0 = <&wifi_32k_pins>;
	};

	wifi_pwm_conf: wifi_pwm_conf {
		phandle = <0xc7>;

		pwm_channel1_conf {
			pwms = <&pwm_ef 0x00 0x774d 0x00>;
			duty-cycle = <0x3ba6>;
			times = <0x08>;
		};

		pwm_channel2_conf {
			pwms = <&pwm_ef 0x02 0x7724 0x00>;
			duty-cycle = <0x3b92>;
			times = <0x0c>;
		};
	};

	sd_emmc_c: emmc@d0074000 {
		status = "okay";
		/* mainline meson-gx-mmc for eMMC: its own clkc gate numbers,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset 0x2e>;
		reg = <0xd0074000 0x2000>;
		interrupts = <0x00 0xda 0x01>;
		/* Linux applies only the state named "default". The vendor's first state muxes clk
		   and cmd alone - the eight data lines are in emmc_conf_pull_up - so naming that one
		   default left the data pins unconfigured and reads returned I/O errors. */
		pinctrl-names = "default";
		pinctrl-0 = <&emmc_conf_pull_up &emmc_conf_pull_done>;
		clocks = <&clkc 0x60 &clkc 0x7d &clkc 0x04>;
		clock-names = "core", "clkin0", "clkin1";
		vmmc-supply = <&vcc_3v3>;
		vqmmc-supply = <&vcc_3v3>;
		bus-width = <0x08>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		/* 200 MHz is HS200/HS400, which needs the 1.8 V signalling this board never switches
		   to; 50 MHz is the fastest mode a fixed 3.3 V rail supports. */
		max-frequency = <50000000>;
		non-removable;
		disable-wp;
		phandle = <0xc8>;

		emmc {
			pinname = "emmc";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_8_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED", "MMC_CAP_NONREMOVABLE", "MMC_CAP_HW_RESET", "MMC_CAP_ERASE", "MMC_CAP_CMD23";
			f_min = <0x61a80>;
			f_max = <0x2faf080>;
			max_req_size = <0x20000>;
			gpio_dat3 = <0x14 0x20 0x00>;
			hw_reset = <0x14 0x26 0x00>;
			card_type = <0x01>;
		};
	};

	sd_emmc_b: sd@d0072000 {
		status = "okay";
		/* mainline meson-gx-mmc for the SD slot: its own clkc gate numbers,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset 0x2d>;
		reg = <0xd0072000 0x2000>;
		interrupts = <0x00 0xd9 0x01>;
		/* Linux registers the pin map for every state at probe, and the vendor's spare
		   states mux these pins to uart_ao_a_card, a function mainline's gxl pinctrl does
		   not have - two dozen "invalid function" errors per boot. Only "default" is ever
		   applied, so the rest are dropped rather than translated. */
		pinctrl-names = "default";
		pinctrl-0 = <&sd_all_pins>;
		clocks = <&clkc 0x5f &clkc 0x7a &clkc 0x04>;
		clock-names = "core", "clkin0", "clkin1";
		bus-width = <0x04>;
		cap-sd-highspeed;
		max-frequency = <0x5f5e100>;
		disable-wp;
		phandle = <0xc9>;

		sd {
			pinname = "sd";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_4_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED";
			f_min = <0x61a80>;
			f_max = <0x5f5e100>;
			max_req_size = <0x20000>;
			gpio_dat3 = <0x14 0x31 0x00>;
			jtag_pin = <0x14 0x2d 0x00>;
			gpio_cd = <0x14 0x33 0x00>;
			card_type = <0x05>;
		};
	};

	sd_emmc_a: sdio@d0070000 {
		status = "okay";
		/* mainline meson-gx-mmc for the SDIO Wi-Fi: its own clkc gate numbers,
		   and a reset line the vendor driver did not use. */
		compatible = "amlogic,meson-gx-mmc", "amlogic,meson-gxbb-mmc";
		resets = <&reset 0x2c>;
		reg = <0xd0070000 0x2000>;
		interrupts = <0x00 0xd8 0x04>;
		/* Linux applies the state called "default" and nothing else; the vendor names its
		   states for its own driver's lookup, so without this the SDIO pins are never muxed
		   and the bus is dead. The eMMC only escapes that because the bootloader muxed it. */
		pinctrl-names = "default";
		pinctrl-0 = <&sdio_all_pins>;
		clocks = <&clkc 0x5e &clkc 0x77 &clkc 0x04>;
		clock-names = "core", "clkin0", "clkin1";
		mmc-pwrseq = <&sdio_pwrseq>;
		vmmc-supply = <&vcc_3v3>;
		vqmmc-supply = <&vcc_3v3>;
		bus-width = <0x04>;
		cap-sd-highspeed;
		cap-mmc-highspeed;
		/* 100 MHz is SDR104, which needs 1.8 V signalling this board does not switch to.
		   Enumeration survives it because that runs at 400 kHz in 1-bit mode. */
		max-frequency = <50000000>;
		non-removable;
		disable-wp;
		#address-cells = <1>;
		#size-cells = <0>;
		phandle = <0xca>;

		sdio {
			pinname = "sdio";
			ocr_avail = <0x200080>;
			caps = "MMC_CAP_4_BIT_DATA", "MMC_CAP_MMC_HIGHSPEED", "MMC_CAP_SD_HIGHSPEED", "MMC_CAP_NONREMOVABLE", "MMC_CAP_UHS_SDR12", "MMC_CAP_UHS_SDR25", "MMC_CAP_UHS_SDR50", "MMC_PM_KEEP_POWER", "MMC_CAP_SDIO_IRQ";
			f_min = <0x61a80>;
			f_max = <0x2faf080>;
			max_req_size = <0x20000>;
			card_type = <0x03>;
			auto_clk_close = <0x01>;
		};
	};

	mtd_nand {
		compatible = "amlogic, aml_mtd_nand";
		dev_name = "mtdnand";
		status = "disabled";
		reg = <0xd0074800 0x200>;
		interrupts = <0x00 0x22 0x01>;
		pinctrl-names = "nand_rb_mod", "nand_norb_mod", "nand_cs_only";
		pinctrl-0 = <&all_nand_pins>;
		pinctrl-1 = <&all_nand_pins>;
		pinctrl-2 = <&nand_cs_pins>;
		device_id = <0x00>;
		plat-names = "bootloader", "nandnormal";
		plat-num = <0x02>;
		plat-part-0 = <0x53>;
		plat-part-1 = <0x54>;

		bootloader: bootloader {
			enable_pad = "ce0";
			busy_pad = "rb0";
			timming_mode = "mode5";
			bch_mode = "bch60_1k";
			t_rea = <0x14>;
			t_rhoh = <0x0f>;
			chip_num = <0x01>;
			part_num = <0x00>;
			rb_detect = <0x01>;
			phandle = <0x53>;
		};

		nandnormal: nandnormal {
			enable_pad = "ce0", "ce1";
			busy_pad = "rb0", "rb1";
			timming_mode = "mode5";
			bch_mode = "bch60_1k";
			plane_mode = "twoplane";
			t_rea = <0x14>;
			t_rhoh = <0x0f>;
			chip_num = <0x02>;
			part_num = <0x03>;
			partition = <0x55>;
			rb_detect = <0x01>;
			phandle = <0x54>;
		};

		nand_partitions: nand_partition {
			phandle = <0x55>;

			logo {
				offset = <0x00 0x00>;
				size = <0x00 0x200000>;
			};

			recovery {
				offset = <0x00 0x00>;
				size = <0x00 0x1000000>;
			};

			boot {
				offset = <0x00 0x00>;
				size = <0x00 0xc00000>;
			};

			system {
				offset = <0x00 0x00>;
				size = <0x00 0xdc40000>;
			};

			data {
				offset = <0xffffffff 0xffffffff>;
				size = <0x00 0x00>;
			};
		};
	};

	ethmac: ethernet@0xc9410000 {
		/* NOT FITTED - no Ethernet socket on this board. The SoC MAC block is
		   real and the driver binds to it, which is where eth0 and its stored
		   mac unifykey come from, but nothing is routed out, so it never gets
		   carrier. Left disabled rather than waiting on a PHY that cannot answer. */
		compatible = "amlogic,meson-gxbb-dwmac", "snps,dwmac";
		status = "disabled";
		reg = <0xc9410000 0x10000 0xc8834540 0x08 0xc8834558 0x0c 0xc1104408 0x04>;
		interrupts = <0x00 0x08 0x01>;
		pinctrl-names = "external_eth_pins";
		pinctrl-0 = <&external_eth_pins>;
		rst_pin-gpios = <&gpio 0x0e 0x00>;
		GPIOZ4_pin-gpios = <&gpio 0x04 0x00>;
		GPIOZ5_pin-gpios = <&gpio 0x05 0x00>;
		mc_val_internal_phy = <0x1800>;
		mc_val_external_phy = <0x1621>;
		cali_val = <0x20000>;
		interrupt-names = "macirq";
		clocks = <&clkc 0x34>;
		clock-names = "ethclk81";
		internal_phy = <0x01>;
		phandle = <0xcb>;
	};

	/* mainline's gxl USB is a controller wrapper holding dwc2 and dwc3, fed by
	   two usb2 phys. The vendor tree has a flat dwc3 with a vendor "usb-phy"
	   property and its own phy bindings, which no mainline driver claims - so the
	   host controller never probes, /sys/bus/usb/devices stays empty, and there is
	   no /dev/sda to mount a rootfs from. */
	usb2_phy0: phy@d0078000 {
		compatible = "amlogic,meson-gxl-usb2-phy";
		#phy-cells = <0x00>;
		reg = <0xd0078000 0x20>;
		clocks = <&clkc 0x37>;
		clock-names = "phy";
		resets = <&reset 0x22>;
		reset-names = "phy";
		status = "okay";
	};

	usb2_phy1: phy@d0078020 {
		compatible = "amlogic,meson-gxl-usb2-phy";
		#phy-cells = <0x00>;
		reg = <0xd0078020 0x20>;
		clocks = <&clkc 0x37>;
		clock-names = "phy";
		resets = <&reset 0x22>;
		reset-names = "phy";
		status = "okay";
	};

	usb: usb@d0078080 {
		compatible = "amlogic,meson-gxl-usb-ctrl";
		reg = <0xd0078080 0x20>;
		interrupts = <0x00 0x10 0x04>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		clocks = <&clkc 0x37 &clkc 0x40>;
		clock-names = "usb_ctrl", "ddr";
		resets = <&reset 0x22>;
		dr_mode = "host";
		phys = <&usb2_phy0 &usb2_phy1>;
		phy-names = "usb2-phy0", "usb2-phy1";
		status = "okay";

		dwc2: usb@c9100000 {
			compatible = "amlogic,meson-g12a-usb", "snps,dwc2";
			reg = <0xc9100000 0x40000>;
			interrupts = <0x00 0x1f 0x04>;
			clocks = <&clkc 0x33>;
			clock-names = "otg";
			phys = <&usb2_phy1>;
			dr_mode = "peripheral";
			g-rx-fifo-size = <0xc0>;
			g-np-tx-fifo-size = <0x80>;
			g-tx-fifo-size = <0x80 0x80 0x10 0x10 0x10>;
		};

		dwc3: usb@c9000000 {
			compatible = "snps,dwc3";
			reg = <0xc9000000 0x100000>;
			interrupts = <0x00 0x1e 0x04>;
			dr_mode = "host";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
		};
	};


	dwc2_a {
		compatible = "amlogic, dwc2";
		device_name = "dwc2_a";
		reg = <0xc9100000 0x40000>;
		status = "okay";
		interrupts = <0x00 0x1f 0x04>;
		pl-periph-id = <0x00>;
		clock-src = "usb0";
		port-id = <0x00>;
		port-type = <0x02>;
		port-speed = <0x00>;
		port-config = <0x00>;
		port-dma = <0x00>;
		port-id-mode = <0x00>;
		usb-fifo = <0x2d8>;
		cpu-type = "gxl";
		controller-type = <0x01>;
		phy-reg = <0xd0078000>;
		phy-reg-size = <0xa0>;
		clocks = <&clkc 0x47 &clkc 0x52 &clkc 0x43>;
		clock-names = "usb_general", "usb1", "usb1_to_ddr";
	};

	unifykey {
		compatible = "amlogic, unifykey";
		status = "ok";
		unifykey-num = <0x13>;
		unifykey-index-0 = <0x59>;
		unifykey-index-1 = <0x5a>;
		unifykey-index-2 = <0x5b>;
		unifykey-index-3 = <0x5c>;
		unifykey-index-4 = <0x5d>;
		unifykey-index-5 = <0x5e>;
		unifykey-index-6 = <0x5f>;
		unifykey-index-7 = <0x60>;
		unifykey-index-8 = <0x61>;
		unifykey-index-9 = <0x62>;
		unifykey-index-10 = <0x63>;
		unifykey-index-11 = <0x64>;
		unifykey-index-12 = <0x65>;
		unifykey-index-13 = <0x66>;
		unifykey-index-14 = <0x67>;
		unifykey-index-15 = <0x68>;
		unifykey-index-16 = <0x69>;
		unifykey-index-17 = <0x6a>;
		unifykey-index-18 = <0x6b>;

		keysn_0: key_0 {
			key-name = "usid";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x59>;
		};

		keysn_1: key_1 {
			key-name = "mac";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x5a>;
		};

		keysn_2: key_2 {
			key-name = "hdcp";
			key-device = "secure";
			key-type = "sha1";
			key-permit = "read", "write", "del";
			phandle = <0x5b>;
		};

		keysn_3: key_3 {
			key-name = "secure_boot_set";
			key-device = "efuse";
			key-permit = "write";
			phandle = <0x5c>;
		};

		keysn_4: key_4 {
			key-name = "mac_bt";
			key-device = "normal";
			key-permit = "read", "write", "del";
			key-type = "mac";
			phandle = <0x5d>;
		};

		keysn_5: key_5 {
			key-name = "mac_wifi";
			key-device = "normal";
			key-permit = "read", "write", "del";
			key-type = "mac";
			phandle = <0x5e>;
		};

		keysn_6: key_6 {
			key-name = "hdcp2_tx";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x5f>;
		};

		keysn_7: key_7 {
			key-name = "hdcp2_rx";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x60>;
		};

		keysn_8: key_8 {
			key-name = "widevinekeybox";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x61>;
		};

		keysn_9: key_9 {
			key-name = "deviceid";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x62>;
		};

		keysn_10: key_10 {
			key-name = "hdcp22_fw_private";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x63>;
		};

		keysn_11: key_11 {
			key-name = "PlayReadykeybox25";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x64>;
		};

		keysn_12: key_12 {
			key-name = "prpubkeybox";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x65>;
		};

		keysn_13: key_13 {
			key-name = "prprivkeybox";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x66>;
		};

		keysn_14: key_14 {
			key-name = "attestationkeybox";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x67>;
		};

		keysn_15: key_15 {
			key-name = "region_code";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x68>;
		};

		keysn_16: key_16 {
			key-name = "netflix_mgkid";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x69>;
		};

		keysn_17: key_17 {
			key-name = "attestationdevidbox";
			key-device = "secure";
			key-permit = "read", "write", "del";
			phandle = <0x6a>;
		};

		keysn_18: key_18 {
			key-name = "oemkey";
			key-device = "normal";
			key-permit = "read", "write", "del";
			phandle = <0x6b>;
		};
	};

	amhdmitx: amhdmitx {
		compatible = "amlogic, amhdmitx";
		dev_name = "amhdmitx";
		status = "okay";
		vend-data = <0x6c>;
		pinctrl-names = "hdmitx_hpd", "hdmitx_ddc";
		pinctrl-0 = <&hdmitx_hpd>;
		pinctrl-1 = <&hdmitx_ddc>;
		interrupts = <0x00 0x39 0x01>;
		interrupt-names = "hdmitx_hpd";
		ic_type = <0x10>;
		phandle = <0xcd>;

		vend_data: vend_data {
			vendor_name = "Amlogic";
			vendor_id = <0x00>;
			product_desc = "MBox Meson Ref";
			phandle = <0x6c>;
		};
	};

	aocec: aocec {
		compatible = "amlogic, amlogic-aocec";
		device_name = "aocec";
		status = "okay";
		vendor_id = <0x00>;
		cec_osd_string = "MBox";
		cec_version = <0x05>;
		port_num = <0x01>;
		arc_port_mask = <0x00>;
		interrupts = <0x00 0xc7 0x01>;
		interrupt-names = "hdmi_aocec";
		pinctrl-names = "default";
		pinctrl-0 = <&hdmitx_aocec>;
		reg = <0xc810023c 0x04 0xc8100000 0x200>;
		reg-names = "ao_exit", "ao";
		phandle = <0xce>;
	};

	i2s_dai: I2S {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml-i2s-dai";
		clocks = <&clkc 0x0f &clkc 0xd1 &clkc 0x36 &clkc 0x37 &clkc 0x38 &clkc 0x39 &clkc 0x3a &clkc 0x3b &clkc 0x3c &clkc 0x3d &clkc 0x3f &clkc 0x68 &clkc 0x33>;
		clock-names = "mpll", "mclk", "top_glue", "aud_buf", "i2s_out", "amclk_measure", "aififo2", "aud_mixer", "mixer_reg", "adc", "top_level", "aoclk", "aud_in";
		i2s_pos_sync = <0x00>;
		phandle = <0x7b>;
	};

	dmic: snd_dmic {
		#sound-dai-cells = <0x00>;
		compatible = "aml, aml_snd_dmic";
		reg = <0xd0042000 0x2000>;
		status = "disabled";
		resets = <&clkc 0xd4>;
		reset-names = "pdm";
		pinctrl-names = "audio_dmic";
		pinctrl-0 = <&aml_dmic_pins>;
		clocks = <&clkc 0xd5 &clkc 0xd1>;
		clock-names = "pdm", "mclk";
		phandle = <0xcf>;
	};

	spdif_dai: SPDIF {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml-spdif-dai";
		clocks = <&clkc 0x0e &clkc 0xd9 &clkc 0xd1 &clkc 0xe0 &clkc 0x0c &clkc 0x37 &clkc 0x69>;
		clock-names = "mpll1", "i958", "mclk", "spdif", "clk_81", "iec958", "iec958_amclk";
		phandle = <0x7c>;
	};

	pcm_dai: PCM {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml-pcm-dai";
		pinctrl-names = "audio_pcm";
		clocks = <&clkc 0x0d &clkc 0xdd &clkc 0xdf>;
		clock-names = "mpll0", "pcm_mclk", "pcm_sclk";
		pcm_mode = <0x01>;
		dai-format = "dsp_a";
		dai-tdm-slot-tx-mask = <0x01>;
		dai-tdm-slot-rx-mask = <0x01>;
		dai-tdm-slot-num = <0x02>;
		dai-tdm-slot-width = <0x10>;
		phandle = <0x7d>;
	};

	i2s_plat: i2s_platform {
		compatible = "amlogic, aml-i2s";
		interrupts = <0x00 0x1d 0x01>;
		phandle = <0x79>;
	};

	pcm_plat: pcm_platform {
		compatible = "amlogic, aml-pcm";
		phandle = <0x7a>;
	};

	spdif_codec: spdif_codec {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml-spdif-codec";
		pinctrl-names = "audio_spdif_out";
		pinctrl-0 = <&audio_spdif_pins>;
		phandle = <0x7f>;
	};

	pcm_codec: pcm_codec {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, pcm2BT-codec";
		phandle = <0x80>;
	};

	dummy_codec: dummy {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml_dummy_codec";
		status = "disable";
		phandle = <0xd0>;
	};

	amlogic_codec: t9015 {
		#sound-dai-cells = <0x00>;
		compatible = "amlogic, aml_codec_T9015";
		reg = <0xc8832000 0x14>;
		status = "okay";
		phandle = <0x7e>;
	};

	aml_sound_meson {
		compatible = "aml, meson-snd-card";
		status = "okay";
		aml-sound-card,format = "i2s";
		aml_sound_card,name = "AML-MESONAUDIO";
		aml,audio-routing = "Ext Spk", "LOUTL", "Ext Spk", "LOUTR";
		mute_gpio-gpios = <&gpio 0x15 0x00>;
		mute_inv;
		hp_disable;
		hp_paraments = <0x320 0x12c 0x00 0x05 0x01>;
		pinctrl-names = "audio_i2s";
		pinctrl-0 = <&audio_i2s_pins>;
		cpu_list = <0x73 0x74 0x75>;
		codec_list = <0x76 0x77 0x78>;
		plat_list = <0x79 0x79 0x7a>;

		cpudai0: cpudai0 {
			sound-dai = <&i2s_dai>;
			phandle = <0x73>;
		};

		cpudai1: cpudai1 {
			sound-dai = <&spdif_dai>;
			phandle = <0x74>;
		};

		cpudai2: cpudai2 {
			sound-dai = <&pcm_dai>;
			phandle = <0x75>;
		};

		codec0: codec0 {
			sound-dai = <&amlogic_codec>;
			phandle = <0x76>;
		};

		codec1: codec1 {
			sound-dai = <&spdif_codec>;
			phandle = <0x77>;
		};

		codec2: codec2 {
			sound-dai = <&pcm_codec>;
			phandle = <0x78>;
		};
	};

	aml_sensor0: aml-sensor@0 {
		compatible = "amlogic, aml-thermal";
		device_name = "thermal";
		status = "okay";
		#thermal-sensor-cells = <0x01>;
		phandle = <0x81>;

		cooling_devices {

			cpufreq_cool_cluster0 {
				min_state = <0xf4240>;
				dyn_coeff = <0x8c>;
				cluster_id = <0x00>;
				node_name = "cpufreq_cool0";
				device_type = "cpufreq";
			};

			cpucore_cool_cluster0 {
				min_state = <0x02>;
				dyn_coeff = <0x00>;
				cluster_id = <0x00>;
				node_name = "cpucore_cool0";
				device_type = "cpucore";
			};

			gpufreq_cool {
				min_state = <0x190>;
				dyn_coeff = <0x1b5>;
				cluster_id = <0x00>;
				node_name = "mali";
				device_type = "gpufreq";
			};

			gpucore_cool {
				min_state = <0x01>;
				dyn_coeff = <0x00>;
				cluster_id = <0x00>;
				node_name = "gpucore_cool0";
				device_type = "gpucore";
			};
		};

		cpufreq_cool0: cpufreq_cool0 {
			#cooling-cells = <0x02>;
			phandle = <0x83>;
		};

		cpucore_cool0: cpucore_cool0 {
			#cooling-cells = <0x02>;
			phandle = <0x84>;
		};

		gpucore_cool0: gpucore_cool0 {
			#cooling-cells = <0x02>;
			phandle = <0x86>;
		};
	};

	thermal-zones {

		soc_thermal {
			polling-delay = <0x3e8>;
			polling-delay-passive = <0x64>;
			sustainable-power = <0x866>;
			thermal-sensors = <&aml_sensor0 0x03>;

			trips {

				switch_on: trip-point@0 {
					temperature = <0x124f8>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0xd1>;
				};

				control: trip-point@1 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x82>;
				};

				hot: trip-point@2 {
					temperature = <0x17318>;
					hysteresis = <0x1388>;
					type = "hot";
					phandle = <0xd2>;
				};

				critical: trip-point@3 {
					temperature = <0x3f7a0>;
					hysteresis = <0x3e8>;
					type = "critical";
					phandle = <0xd3>;
				};
			};

			cooling-maps {

				cpufreq_cooling_map {
					trip = <0x82>;
					cooling-device = <&cpufreq_cool0 0x00 0x04>;
					contribution = <0x400>;
				};

				cpucore_cooling_map {
					trip = <0x82>;
					cooling-device = <&cpucore_cool0 0x00 0x03>;
					contribution = <0x400>;
				};

				gpufreq_cooling_map {
					trip = <0x82>;
					cooling-device = <&gpu 0x00 0x04>;
					contribution = <0x400>;
				};

				gpucore_cooling_map {
					trip = <0x82>;
					cooling-device = <&gpucore_cool0 0x00 0x02>;
					contribution = <0x400>;
				};
			};
		};
	};
};
