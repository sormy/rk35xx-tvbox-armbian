	vcc_ddr_s3: vcc-ddr-s3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_ddr_s3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <0x124f80>;
		regulator-max-microvolt = <0x124f80>;
		vin-supply = <&vcc5v0_sys>;
		phandle = <0x1c3>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h &clkm1_32k_out>;
		post-power-on-delay-ms = <0xc8>;
		reset-gpios = <&gpio3 0x0a 0x01>;
		status = "okay";
		phandle = <0x79>;
	};

	wireless_bluetooth: wireless-bluetooth {
		compatible = "bluetooth-platdata";
		uart_rts_gpios = <&gpio1 0x0a 0x01>;
		pinctrl-names = "default", "rts_gpio";
		pinctrl-0 = <&uart2m1_rtsn>;
		pinctrl-1 = <&uart2m1_gpios>;
		BT,reset_gpio = <&gpio1 0x11 0x00>;
		BT,wake_gpio = <&gpio1 0x0c 0x00>;
		BT,wake_host_irq = <0xa7 0x12 0x00>;
		status = "disabled";
		phandle = <0x1c4>;
	};

	wireless_wlan: wireless-wlan {
		compatible = "wlan-platdata";
		rockchip,grf = <&grf>;
		wifi_chip_type = "ap6275s";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_irq>;
		WIFI,host_wake_irq = <0xa7 0x07 0x00>;
		status = "disabled";
		phandle = <0x1c5>;
	};

	seekwcn_boot: seekwcn_boot {
		compatible = "seekwave,sv6160lite";
		dma_type = <0x01>;
		seekwave_nv_name = "SEEKWAVE_NV_SWT6652.bin";
		status = "okay";
		gpio_host_wake = <0xa6 0x0b 0x01>;
		gpio_chip_wake = <0xa6 0x0c 0x00>;
		gpio_chip_en = <0xa6 0x0a 0x00>;
		phandle = <0x1c6>;
	};

	leds: gpio-leds {
		compatible = "gpio-leds";
		phandle = <0x1c7>;

		/* power/standby are the names the shared LED hooks drive; the factory called
		 * them work-green and work-red */
		power {
			gpios = <&gpio4 0x11 0x01>;
			linux,default-trigger = "none";
			default-state = "on";
			retain-state-suspended;
			retain-state-shutdown;
		};

		/* the standby half of the same rename; the factory called it work-red */
		standby {
			gpios = <&gpio4 0x0b 0x01>;
			linux,default-trigger = "none";
			default-state = "off";
			retain-state-suspended;
			retain-state-shutdown;
		};
	};

	/* chosen dropped: u-boot supplies bootargs, and the vendor string names ttyFIQ0 */

	fiq-debugger {
		compatible = "rockchip,fiq-debugger";
		rockchip,serial-id = <0x00>;
		rockchip,wake-irq = <0x00>;
		rockchip,irq-mode-enable = <0x01>;
		rockchip,baudrate = <0x16e360>;
		interrupts = <0x00 0xba 0x04>;
		pinctrl-names = "default";
		pinctrl-0 = <&uart0m0_xfer>;
		/* frees ff9f0000 for ttyS0 above */
		status = "disabled";
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x1c9>;

		cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x800000>;
			linux,cma-default;
		};

		drm_logo: drm-logo@0 {
			compatible = "rockchip,drm-logo";
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x15>;
		};

		drm_cubic_lut: drm-cubic-lut@0 {
			compatible = "rockchip,drm-cubic-lut";
			reg = <0x00 0x00 0x00 0x00>;
			phandle = <0x16>;
		};

		ramoops: ramoops@110000 {
			compatible = "ramoops";
			reg = <0x00 0x110000 0x00 0xe0000>;
			boot-log-size = <0x8000>;
			boot-log-count = <0x01>;
			console-size = <0x80000>;
			pmsg-size = <0x30000>;
			ftrace-size = <0x00>;
			record-size = <0x14000>;
			phandle = <0x1ca>;
		};
	};
};
