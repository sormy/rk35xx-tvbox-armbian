		reg = <0x00 0xff860000 0x00 0x500>;
		interrupts = <0x00 0x6a 0x04>;
		clocks = <&cru 0x14e &cru 0x14d &cru 0x14f>;
		clock-names = "aclk", "hclk", "sclk";
		rockchip,normal-rates = <0x1443fd00 0x00 0x1443fd00>;
