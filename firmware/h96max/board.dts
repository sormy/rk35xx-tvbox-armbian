	pwm4: pwm@ffa98000 {
		compatible = "rockchip,rk3528-pwm", "rockchip,rk3328-pwm";
		reg = <0x00 0xffa98000 0x00 0x10>;
		interrupts = <0x00 0x37 0x04>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm4m0_pins>;
		clocks = <&cru 0x82 &cru 0x81>;
		clock-names = "pwm", "pclk";
		status = "disabled";
		phandle = <0x108>;
	};

	pwm5: pwm@ffa98010 {
		compatible = "rockchip,rk3528-pwm", "rockchip,rk3328-pwm";
		reg = <0x00 0xffa98010 0x00 0x10>;
		interrupts = <0x00 0x37 0x04>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm5m0_pins>;
		clocks = <&cru 0x82 &cru 0x81>;
		clock-names = "pwm", "pclk";
		status = "disabled";
		phandle = <0x109>;
	};

	pwm6: pwm@ffa98020 {
		compatible = "rockchip,rk3528-pwm", "rockchip,rk3328-pwm";
		reg = <0x00 0xffa98020 0x00 0x10>;
		interrupts = <0x00 0x37 0x04>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm6m0_pins>;
		clocks = <&cru 0x82 &cru 0x81>;
		clock-names = "pwm", "pclk";
		status = "disabled";
		phandle = <0x10a>;
	};

	pwm7: pwm@ffa98030 {
		compatible = "rockchip,rk3528-pwm", "rockchip,rk3328-pwm";
		reg = <0x00 0xffa98030 0x00 0x10>;
		interrupts = <0x00 0x37 0x04 0x00 0x38 0x04>;
		#pwm-cells = <0x03>;
		pinctrl-names = "active";
		pinctrl-0 = <&pwm7m0_pins>;
		clocks = <&cru 0x82 &cru 0x81>;
		clock-names = "pwm", "pclk";
		status = "disabled";
		phandle = <0x10b>;
	};

	rktimer: timer@ffab0000 {
		compatible = "rockchip,rk3528-timer", "rockchip,rk3288-timer";
		reg = <0x00 0xffab0000 0x00 0x20>;
		interrupts = <0x00 0x1f 0x04>;
		clocks = <&cru 0x69 &cru 0x6a>;
		clock-names = "pclk", "timer";
		phandle = <0x10c>;
	};

	wdt: watchdog@ffac0000 {
		compatible = "snps,dw-wdt";
		reg = <0x00 0xffac0000 0x00 0x100>;
		clocks = <&cru 0x73 &cru 0x72>;
		clock-names = "tclk", "pclk";
		interrupts = <0x00 0x1c 0x04>;
		/* /dev/watchdog for systemd RuntimeWatchdogSec - also the only hang recorder */
		status = "okay";
		phandle = <0x10d>;
	};

	tsadc: tsadc@ffad0000 {
		compatible = "rockchip,rk3528-tsadc";
		reg = <0x00 0xffad0000 0x00 0x400>;
		rockchip,grf = <&grf>;
		interrupts = <0x00 0x8b 0x04>;
		clocks = <&cru 0x103 &cru 0x104 &cru 0x102>;
		clock-names = "tsadc", "tsadc_tsen", "apb_pclk";
		assigned-clocks = <&cru 0x103 &cru 0x104>;
		assigned-clock-rates = <0x124f80 0xb71b00>;
		resets = <&cru 0x20f &cru 0x20e>;
		reset-names = "tsadc", "tsadc-apb";
		#thermal-sensor-cells = <0x01>;
		rockchip,hw-tshut-temp = <0x1d4c0>;
		rockchip,hw-tshut-mode = <0x00>;
		rockchip,hw-tshut-polarity = <0x00>;
		nvmem-cells = <&cpu_tsadc_trim_l &cpu_tsadc_trim_h>;
		nvmem-cell-names = "trim_l", "trim_h";
		status = "okay";
		phandle = <0x1f>;
	};

	saradc: saradc@ffae0000 {
		compatible = "rockchip,rk3528-saradc";
		reg = <0x00 0xffae0000 0x00 0x10000>;
		interrupts = <0x00 0x8c 0x04>;
		#io-channel-cells = <0x01>;
		clocks = <&cru 0x101 &cru 0x100>;
		clock-names = "saradc", "apb_pclk";
		resets = <&cru 0x20b>;
		reset-names = "saradc-apb";
		status = "okay";
		vref-supply = <&vdd_1v8_s3>;
		phandle = <0x92>;
	};

	sai3: sai@ffb70000 {
		compatible = "rockchip,rk3528-sai", "rockchip,sai-v1";
		reg = <0x00 0xffb70000 0x00 0x1000>;
		interrupts = <0x00 0x80 0x04>;
		clocks = <&cru 0x184 &cru 0x183>;
		clock-names = "mclk", "hclk";
		assigned-clocks = <&cru 0x184>;
		assigned-clock-rates = <0x5dc000>;
		dmas = <&dmac 0x05>;
		dma-names = "tx";
		resets = <&cru 0x2a2 &cru 0x2a1>;
		reset-names = "m", "h";
		rockchip,always-on;
		#sound-dai-cells = <0x00>;
		status = "okay";
		phandle = <0x97>;
	};

	sai0: sai@ffb80000 {
		compatible = "rockchip,rk3528-sai", "rockchip,sai-v1";
		reg = <0x00 0xffb80000 0x00 0x1000>;
		interrupts = <0x00 0x7d 0x04>;
		clocks = <&cru 0xaf &cru 0xae>;
		clock-names = "mclk", "hclk";
		dmas = <&dmac 0x01 &dmac 0x00>;
		dma-names = "tx", "rx";
		resets = <&cru 0x1aa &cru 0x1a9>;
		reset-names = "m", "h";
		pinctrl-names = "default";
		pinctrl-0 = <&i2s0m0_lrck &i2s0m0_sclk &i2s0m0_sdi &i2s0m0_sdo>;
		#sound-dai-cells = <0x00>;
		status = "okay";
		phandle = <0x93>;
	};

	sai2: sai@ffb90000 {
		compatible = "rockchip,rk3528-sai", "rockchip,sai-v1";
		reg = <0x00 0xffb90000 0x00 0x1000>;
		interrupts = <0x00 0x7f 0x04>;
		clocks = <&cru 0xb1 &cru 0xb0>;
		clock-names = "mclk", "hclk";
		dmas = <&dmac 0x04>;
		dma-names = "tx";
		resets = <&cru 0x1ac &cru 0x1ab>;
		reset-names = "m", "h";
		#sound-dai-cells = <0x00>;
		status = "okay";
		phandle = <0x90>;
	};

	sai1: sai@ffba0000 {
		compatible = "rockchip,rk3528-sai", "rockchip,sai-v1";
		reg = <0x00 0xffba0000 0x00 0x1000>;
		interrupts = <0x00 0x7e 0x04>;
		clocks = <&cru 0x123 &cru 0x122>;
		clock-names = "mclk", "hclk";
		dmas = <&dmac 0x03 &dmac 0x02>;
		dma-names = "tx", "rx";
		resets = <&cru 0x24a &cru 0x249>;
		reset-names = "m", "h";
		pinctrl-names = "default";
		pinctrl-0 = <&i2s1_sclk &i2s1_lrck &i2s1_sdi0 &i2s1_sdi1 &i2s1_sdi2 &i2s1_sdi3 &i2s1_sdo0 &i2s1_sdo1 &i2s1_sdo2 &i2s1_sdo3>;
		#sound-dai-cells = <0x00>;
		status = "disabled";
		phandle = <0x95>;
	};

	pdm: pdm@ffbb0000 {
		compatible = "rockchip,rk3528-pdm", "rockchip,rk3568-pdm";
		reg = <0x00 0xffbb0000 0x00 0x1000>;
		clocks = <&cru 0x137 &cru 0x136>;
		clock-names = "pdm_clk", "pdm_hclk";
		dmas = <&dmac 0x06>;
		dma-names = "rx";
		pinctrl-names = "default";
		pinctrl-0 = <&pdm_clk0 &pdm_clk1 &pdm_sdi0 &pdm_sdi1 &pdm_sdi2 &pdm_sdi3>;
		#sound-dai-cells = <0x00>;
		status = "disabled";
		phandle = <0x99>;
	};

	spdif_8ch: spdif@ffbc0000 {
		compatible = "rockchip,rk3528-spdif", "rockchip,rk3568-spdif";
		reg = <0x00 0xffbc0000 0x00 0x1000>;
		interrupts = <0x00 0x82 0x04>;
		dmas = <&dmac 0x07>;
		dma-names = "tx";
		clock-names = "mclk", "hclk";
		clocks = <&cru 0x135 &cru 0x134>;
		#sound-dai-cells = <0x00>;
		pinctrl-names = "default";
		pinctrl-0 = <&spdifm0_pins>;
		status = "okay";
		phandle = <0x9b>;
	};

	gmac0: ethernet@ffbd0000 {
		compatible = "rockchip,rk3528-gmac", "snps,dwmac-4.20a";
		reg = <0x00 0xffbd0000 0x00 0x10000>;
		interrupts = <0x00 0x71 0x04 0x00 0x74 0x04>;
		interrupt-names = "macirq", "eth_wake_irq";
		rockchip,grf = <&grf>;
		clocks = <&cru 0x17b &cru 0x17c &cru 0x17e &cru 0x17d &cru 0x17a &cru 0x179>;
		clock-names = "stmmaceth", "clk_mac_ref", "mac_clk_rx", "mac_clk_tx", "pclk_mac", "aclk_mac";
		resets = <&cru 0x29a>;
		reset-names = "stmmaceth";
		snps,mixed-burst;
		snps,tso;
		snps,axi-config = <0x70>;
		snps,mtl-rx-config = <0x71>;
		snps,mtl-tx-config = <0x72>;
		phy-mode = "rmii";
		clock_in_out = "input";
		phy-handle = <&rmii0_phy>;
		nvmem-cells = <&macphy_bgs>;
		nvmem-cell-names = "bgs";
		status = "okay";
		phandle = <0x10e>;

		mdio0: mdio {
			compatible = "snps,dwmac-mdio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x10f>;

			rmii0_phy: ethernet-phy@2 {
				compatible = "ethernet-phy-id0044.1400", "ethernet-phy-ieee802.3-c22";
				reg = <0x02>;
				clocks = <&cru 0x18e>;
				resets = <&cru 0x2a3>;
				phy-is-integrated;
				pinctrl-names = "default";
				pinctrl-0 = <&fephym0_led_link &fephym0_led_spd>;
				nvmem-cells = <&macphy_txlevel>;
				nvmem-cell-names = "txlevel";
				rockchip,thermal-zone = "soc-thermal";
				phandle = <0x73>;
			};
		};

		gmac0_stmmac_axi_setup: stmmac-axi-config {
			snps,wr_osr_lmt = <0x04>;
			snps,rd_osr_lmt = <0x08>;
			snps,blen = <0x00 0x00 0x00 0x00 0x10 0x08 0x04>;
			phandle = <0x70>;
		};

		gmac0_mtl_rx_setup: rx-queues-config {
			snps,rx-queues-to-use = <0x01>;
			phandle = <0x71>;

			queue0 {
			};
		};

		gmac0_mtl_tx_setup: tx-queues-config {
			snps,tx-queues-to-use = <0x01>;
			phandle = <0x72>;

			queue0 {
			};
		};
	};

	sdhci: mmc@ffbf0000 {
		compatible = "rockchip,rk3528-dwcmshc";
		reg = <0x00 0xffbf0000 0x00 0x10000>;
		interrupts = <0x00 0x88 0x04>;
		assigned-clocks = <&cru 0xa6 &cru 0xa7 &cru 0xa3>;
		assigned-clock-rates = <0xbebc200 0x16e3600 0xbebc200>;
		clocks = <&cru 0xa3 &cru 0xa4 &cru 0xa5 &cru 0xa6 &cru 0xa7>;
		clock-names = "core", "bus", "axi", "block", "timer";
		resets = <&cru 0x19f &cru 0x1a0 &cru 0x1a1 &cru 0x1a2 &cru 0x1a3>;
		reset-names = "core", "bus", "axi", "block", "timer";
		max-frequency = <0x5f5e100>;
		status = "okay";
		bus-width = <0x08>;
		no-sd;
		no-sdio;
		non-removable;
		mmc-hs200-1_8v;
		phandle = <0x110>;
	};

	sfc: spi@ffc00000 {
		compatible = "rockchip,sfc";
		reg = <0x00 0xffc00000 0x00 0x4000>;
		interrupts = <0x00 0x87 0x04>;
		clocks = <&cru 0xa1 &cru 0xa0>;
		clock-names = "clk_sfc", "hclk_sfc";
		assigned-clocks = <&cru 0xa1>;
		assigned-clock-rates = <0x5f5e100>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		phandle = <0x111>;
	};

	sdio0: mmc@ffc10000 {
		compatible = "rockchip,rk3528-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x00 0xffc10000 0x00 0x4000>;
		interrupts = <0x00 0x89 0x04>;
		max-frequency = <0x8f0d180>;
		clocks = <&cru 0xf1 &cru 0xf0 &grf_cru 0x03 &grf_cru 0x04>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		fifo-depth = <0x100>;
		resets = <&cru 0x202>;
		reset-names = "reset";
		rockchip,use-v2-tuning;
		status = "disabled";
		phandle = <0x112>;
	};

	sdio1: mmc@ffc20000 {
		compatible = "rockchip,rk3528-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x00 0xffc20000 0x00 0x4000>;
		interrupts = <0x00 0x8a 0x04>;
		max-frequency = <0xbebc200>;
		clocks = <&cru 0xf5 &cru 0xf4 &grf_cru 0x05 &grf_cru 0x06>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		fifo-depth = <0x100>;
		resets = <&cru 0x204>;
		reset-names = "reset";
		status = "okay";
		no-sd;
		no-mmc;
		supports-sdio;
		bus-width = <0x04>;
		disable-wp;
		cap-sd-highspeed;
		cap-sdio-irq;
		keep-power-in-suspend;
		non-removable;
		mmc-pwrseq = <&sdio_pwrseq>;
		pinctrl-names = "default";
		pinctrl-0 = <&sdio1_bus4 &sdio1_cmd &sdio1_clk>;
		sd-uhs-sdr104;
		phandle = <0x113>;
	};

	sdmmc: mmc@ffc30000 {
		compatible = "rockchip,rk3528-dw-mshc", "rockchip,rk3288-dw-mshc";
		reg = <0x00 0xffc30000 0x00 0x4000>;
		interrupts = <0x00 0x85 0x04>;
		max-frequency = <0x8f0d180>;
		clocks = <&cru 0x198 &cru 0x197 &grf_cru 0x01 &grf_cru 0x02>;
		clock-names = "biu", "ciu", "ciu-drive", "ciu-sample";
		fifo-depth = <0x100>;
		resets = <&cru 0x2a9>;
		reset-names = "reset";
		rockchip,use-v2-tuning;
		status = "okay";
		bus-width = <0x04>;
		cap-mmc-highspeed;
		cap-sd-highspeed;
		disable-wp;
		pinctrl-names = "default";
		pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_det &sdmmc_bus4>;
		rockchip,default-sample-phase = <0x5a>;
		/* sd-uhs-* removed: with UHS the SD intermittently fails to re-initialise after a
		 * warm reset and the box comes up with no root. Costs SDR104, keeps reboots. */
		supports-sd;
		vqmmc-supply = <&vccio_sd>;
		vmmc-supply = <&vcc_sd>;
		phandle = <0x114>;
	};

	crypto: crypto@ffc40000 {
		compatible = "rockchip,crypto-v4";
		reg = <0x00 0xffc40000 0x00 0x2000>;
		interrupts = <0x00 0x13 0x04>;
		clocks = <&scmi_clk 0x18 &scmi_clk 0x1a &scmi_clk 0x17 &scmi_clk 0x19>;
		clock-names = "aclk", "hclk", "sclk", "pka";
		assigned-clocks = <&scmi_clk 0x17 &scmi_clk 0x19>;
		assigned-clock-rates = <0x11e1a300 0x11e1a300>;
		resets = <&cru 0x3a>;
		reset-names = "crypto-rst";
		status = "okay";
		phandle = <0x115>;
	};

	rng: rng@ffc50000 {
		compatible = "rockchip,rkrng";
		reg = <0x00 0xffc50000 0x00 0x200>;
		interrupts = <0x00 0x17 0x04>;
		clocks = <&scmi_clk 0x20>;
		clock-names = "hclk_trng";
		resets = <&cru 0xa3>;
		reset-names = "reset";
		status = "okay";
		phandle = <0x116>;
	};

	otp: otp@ffce0000 {
		compatible = "rockchip,rk3528-otp";
		reg = <0x00 0xffce0000 0x00 0x4000>;
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		clocks = <&cru 0x19d &cru 0x19c &cru 0x19b>;
		clock-names = "usr", "sbpi", "apb";
		resets = <&cru 0x2ad &cru 0x2ac &cru 0x2ab>;
		reset-names = "usr", "sbpi", "apb";
		phandle = <0x117>;

		cpu_code: cpu-code@2 {
			reg = <0x02 0x02>;
			phandle = <0x12>;
		};

		otp_cpu_version: cpu-version@8 {
			reg = <0x08 0x01>;
			bits = <0x03 0x03>;
			phandle = <0x11>;
		};

		cpu_mbist_vmin: cpu-mbist-vmin@9 {
			reg = <0x09 0x01>;
			bits = <0x00 0x03>;
			phandle = <0x0e>;
		};

		gpu_mbist_vmin: gpu-mbist-vmin@9 {
			reg = <0x09 0x01>;
			bits = <0x03 0x02>;
			phandle = <0x2c>;
		};

