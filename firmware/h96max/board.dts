	vop: vop@ff840000 {
		compatible = "rockchip,rk3528-vop";
		reg = <0x00 0xff840000 0x00 0x3000 0x00 0xff845000 0x00 0x1000 0x00 0xff846400 0x00 0x800>;
		reg-names = "regs", "gamma_lut", "acm_regs";
		interrupts = <0x00 0x6d 0x04>;
		clocks = <&cru 0x157 &cru 0x154 &cru 0x155 &cru 0x156>;
		clock-names = "aclk_vop", "hclk_vop", "dclk_vp0", "dclk_vp1";
		assigned-clocks = <&cru 0x155>;
		assigned-clock-parents = <&inno_hdmiphy_clk>;
		iommus = <&vop_mmu>;
		rockchip,grf = <&grf>;
		status = "okay";
		esmart_lb_mode = [03];
		support-multi-area;
		phandle = <0xea>;

		vop_out: ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x14>;

			port@0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x00>;

				vp0_out_hdmi: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&hdmi_in_vp0>;
					phandle = <0x17>;
				};
			};

			port@1 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				reg = <0x01>;

				vp1_out_tve: endpoint@0 {
					reg = <0x00>;
					remote-endpoint = <&tve_in_vp1>;
					phandle = <0x18>;
				};
			};
		};
	};

	vop_mmu: iommu@ff847e00 {
		compatible = "rockchip,iommu-v2";
		reg = <0x00 0xff847e00 0x00 0x100>;
		interrupts = <0x00 0x6d 0x04>;
		interrupt-names = "vop_mmu";
		clocks = <&cru 0x157 &cru 0x154>;
		clock-names = "aclk", "iface";
		#iommu-cells = <0x00>;
		rockchip,disable-device-link-resume;
		rockchip,shootdown-entire;
		status = "okay";
		phandle = <0x34>;
	};

