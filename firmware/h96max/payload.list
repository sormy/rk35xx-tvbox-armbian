# H96 firmware payload — files copied verbatim into the rootfs (mode src dest, src under firmware/).
# Mechanism scripts are family-level (rk35xx-*, firmware/common/); this list is mostly board data.
# DKMS *sources* are fetched by board.conf's board_stage_dkms, built by rk35xx-firstboot.

# family first boot (enabled via a multi-user.target drop-in at image build)
0755 common/rk35xx-firstboot                    /usr/local/sbin/rk35xx-firstboot
0644 common/rk35xx-firstboot.service            /etc/systemd/system/rk35xx-firstboot.service

# Seekwave Wi-Fi/BT: module autoload + firmware (chip code + board calibration; see seekwave-fw/)
0644 h96max/seekwave-modules.conf                  /etc/modules-load.d/seekwave.conf
0644 h96max/seekwave-fw/SWT6621S_DRAM_SDIO.bin     /lib/firmware/SWT6621S_DRAM_SDIO.bin
0644 h96max/seekwave-fw/SWT6621S_IRAM_SDIO.bin     /lib/firmware/SWT6621S_IRAM_SDIO.bin
0644 h96max/seekwave-fw/SWT6621S_NV_SDIO.bin       /lib/firmware/SWT6621S_NV_SDIO.bin
0644 h96max/seekwave-fw/SWT6621S_SEEKWAVE_R00001.bin /lib/firmware/SWT6621S_SEEKWAVE_R00001.bin
0644 h96max/seekwave-fw/sv6160lite.nvbin           /lib/firmware/sv6160lite.nvbin

# DKMS build files (sources fetched at image build; rk35xx-firstboot builds whatever is staged)
0644 common/ir/Makefile                         /usr/src/rockchip-pwm-remotectl-rk35xx-1.0/Makefile
0644 common/ir/dkms.conf                        /usr/src/rockchip-pwm-remotectl-rk35xx-1.0/dkms.conf
0644 common/ethphy/Makefile                     /usr/src/rk630-phy-rk35xx-1.0/Makefile
0644 common/ethphy/dkms.conf                    /usr/src/rk630-phy-rk35xx-1.0/dkms.conf

# family module autoload (IR remote + Ethernet PHY; Seekwave has its own list)
0644 common/rk35xx-modules.conf                 /etc/modules-load.d/rk35xx.conf

# standby-LED hooks + power-button behaviour
0755 common/rk35xx-led-shutdown                 /usr/lib/systemd/system-shutdown/rk35xx-led
0755 common/rk35xx-led-sleep                    /usr/lib/systemd/system-sleep/rk35xx-led
0644 common/rk35xx-suspend.conf                 /etc/systemd/sleep.conf.d/zz-rk35xx-suspend.conf
0644 common/rk35xx-powerkey.conf                /etc/systemd/logind.conf.d/zz-rk35xx-powerkey.conf

# login-banner board name (reads /usr/local/share/rk35xx/board-name)
0755 common/rk35xx-boardname                    /usr/local/sbin/rk35xx-boardname
0644 common/rk35xx-boardname.apt                /etc/apt/apt.conf.d/99-rk35xx-boardname
0644 h96max/board-name                             /usr/local/share/rk35xx/board-name
# board key (= firmware/<board>/), so rk35xx-update knows which payload to install
0644 h96max/board-id                               /usr/local/share/rk35xx/board-id

# DTB master copy + kernel postinst.d hooks
0644 h96max/board.dtb                              /usr/local/share/rk35xx/board.dtb
0755 common/rk35xx-dtb-persist                  /etc/kernel/postinst.d/rk35xx-dtb-persist
0755 common/rk35xx-kernel-prepare               /etc/kernel/postinst.d/00-rk35xx-kernel-prepare

# board loader pair + write_uboot_platform override (armbian-install soft-brick guard)
0644 h96max/factory_idbloader.bin                  /usr/local/share/rk35xx/factory_idbloader.bin
0644 common/u-boot.itb                          /usr/local/share/rk35xx/u-boot.itb
0644 common/rk35xx-platform-install             /usr/lib/u-boot/platform_install.sh

# hardware watchdog: systemd pings it, the SoC resets the box if it stops (node enabled in board.dtb)
0644 common/rk35xx-watchdog.conf                /etc/systemd/system.conf.d/zz-rk35xx-watchdog.conf

# in-place updater, so `rk35xx-update --pull` works on the box without a checkout
0755 ../rk35xx-update                           /usr/local/sbin/rk35xx-update

# kill the base image's getty on ttyFIQ0 (device can't exist here) — else boot stalls 90 s
0644 common/rk35xx-ttyfiq0-getty.service      /etc/systemd/system/serial-getty@ttyFIQ0.service
