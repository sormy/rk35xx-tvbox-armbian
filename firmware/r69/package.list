# tvb-r69's files (mode src dest, src under firmware/; link target dest for a symlink).
# package/board.sh adds the tree, the loader and the u-boot-menu drop-in.

# the AIC8800D80's firmware, where the driver's CONFIG_AIC_FW_PATH reads it, by the names it opens:
# armbian/firmware's SDIO set, de63f5a
0644 r69/aic8800/fw_patch_table.bin  /usr/lib/firmware/aic8800/SDIO/aic8800D80/fw_patch_table.bin
0644 r69/aic8800/fw_patch.bin        /usr/lib/firmware/aic8800/SDIO/aic8800D80/fw_patch.bin
0644 r69/aic8800/fmacfw.bin          /usr/lib/firmware/aic8800/SDIO/aic8800D80/fmacfw.bin
0644 r69/aic8800/fw_adid.bin         /usr/lib/firmware/aic8800/SDIO/aic8800D80/fw_adid.bin
0644 r69/aic8800/lmacfw_rf.bin       /usr/lib/firmware/aic8800/SDIO/aic8800D80/lmacfw_rf.bin
0644 r69/aic8800/aic_userconfig.txt  /usr/lib/firmware/aic8800/SDIO/aic8800D80/aic_userconfig.txt
0644 r69/aic8800-modules.conf        /usr/lib/modules-load.d/tvb-aic8800.conf

# LEDs: red while off or asleep, blue while on (the tree's retain-state properties keep them)
0755 common/led-shutdown           /usr/lib/systemd/system-shutdown/tvb-led
0755 common/led-sleep              /usr/lib/systemd/system-sleep/tvb-led

# a short press suspends, IR wakes it; no PMIC, so poweroff parks the SoC powered
0644 common/suspend.conf           /usr/lib/systemd/sleep.conf.d/zz-tvb-suspend.conf
0644 common/powerkey.conf          /usr/lib/systemd/logind.conf.d/zz-tvb-powerkey.conf

# hardware watchdog: systemd pings it, the SoC resets the box if it stops
0644 common/watchdog.conf          /usr/lib/systemd/system.conf.d/zz-tvb-watchdog.conf
0644 common/console-loglevel.conf  /usr/lib/sysctl.d/50-tvb-console-loglevel.conf

# the video engines for a normal user, stable input names, Bluetooth unblocked at registration
0644 common/vpu.rules              /usr/lib/udev/rules.d/99-tvb-vpu.rules
0644 common/input-names.rules      /usr/lib/udev/rules.d/60-tvb-input-names.rules
0644 common/rfkill-bt.rules        /usr/lib/udev/rules.d/60-tvb-rfkill-bt.rules
0644 common/rk630phy.conf          /usr/lib/modules-load.d/tvb-rk630phy.conf

# the login banner
0755 common/motd                   /etc/update-motd.d/10-tvbian
