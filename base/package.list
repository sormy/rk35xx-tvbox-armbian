# tvb-base's files: what every box gets (mode src dest, src under base/; link target dest for a
# symlink). Under /etc only where the program reads nowhere else.

# hardware watchdog: systemd pings it, the SoC resets the box if it stops
0644 watchdog.conf             /usr/lib/systemd/system.conf.d/zz-tvb-watchdog.conf
0644 console-loglevel.conf     /usr/lib/sysctl.d/50-tvb-console-loglevel.conf
# the journal in RAM, batched to the eMMC: full, daily, at shutdown
0644 journal.conf              /usr/lib/systemd/journald.conf.d/50-tvb-journal.conf
0755 journal-spill             /usr/lib/tvb/journal-spill
0644 tvb-journal-ram.service   /usr/lib/systemd/system/tvb-journal-ram.service
0644 tvb-journal-spill.service /usr/lib/systemd/system/tvb-journal-spill.service
0644 tvb-journal-spill.timer   /usr/lib/systemd/system/tvb-journal-spill.timer
link ../tvb-journal-ram.service /usr/lib/systemd/system/multi-user.target.wants/tvb-journal-ram.service
link ../tvb-journal-spill.timer /usr/lib/systemd/system/timers.target.wants/tvb-journal-spill.timer
# swap in RAM
0644 zram.conf                 /usr/lib/systemd/zram-generator.conf.d/50-tvb.conf

# stable names for the inputs, and the bundled BLE remote's keymap
0644 input-names.rules         /usr/lib/udev/rules.d/60-tvb-input-names.rules
0644 bt-remote.hwdb            /usr/lib/udev/hwdb.d/60-tvb-bt-remote.hwdb

# Wi-Fi without power save, on the chip's own MAC
0644 tvb-wifi.conf             /usr/lib/NetworkManager/conf.d/tvb-wifi.conf

# the console: the boot log stays under the login prompt, and the banners
0644 getty-tty1.conf           /usr/lib/systemd/system/getty@tty1.service.d/50-tvb.conf
0644 tvbian.issue              /etc/issue.d/tvbian.issue
0755 motd                      /etc/update-motd.d/10-tvbian

# apt: no Recommends, no translations
0644 apt-lean.conf             /etc/apt/apt.conf.d/90-tvb-lean
